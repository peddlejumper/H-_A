# 4.1 let 声明
let count = 10;
let message = "Hello";
let price = 19.99;
let active = true;
print(count);
print(message);
print(price);
print(active);
# 4.3 命名规范
let studentName = "Tom";
let MAX_SIZE = 100;
let is_valid = true;
print(studentName);
print(MAX_SIZE);
print(is_valid);
# 4.4 作用域
let outer = 1;
if (outer > 0) {
    let inner = 2;
    print(outer + inner);
}
print(outer);
# 4.5 重新赋值
let score = 80;
print(score);
score = 90;
print(score);
score = score + 5;
print(score);
# 4.6 多重赋值
let [p, q] = [1, 2];
print(p);
print(q);
let [r, s, _t] = [10, 20, 30];
print(r);
print(s);
