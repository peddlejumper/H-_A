# 7.1 if/else if/else
let score = 85;
if (score >= 90) {
    print("优秀");
} else if (score >= 80) {
    print("良好");
} else if (score >= 70) {
    print("中等");
} else if (score >= 60) {
    print("及格");
} else {
    print("不及格");
}
# 7.2 while 循环
let i = 1;
let sum = 0;
while (i <= 10) {
    sum = sum + i;
    i = i + 1;
}
print("1到10的和: " + str(sum));
# 7.3 for-in 循环(列表)
let colors = ["red", "green", "blue"];
for c in colors {
    print(c);
}
# 7.4 for-in 遍历字典
let book = {"title": "H#入门", "price": 59, "pages": 300};
for k, v in book {
    print(k + ": " + str(v));
}
# 7.5 break 和 continue
for x in [1, 2, 3, 4, 5, 6, 7, 8] {
    if (x == 3) {
        continue;
    }
    if (x == 7) {
        break;
    }
    print(x);
}
# 7.6 嵌套循环 - 九九乘法表
for i in [1, 2, 3] {
    for j in [1, 2, 3, 4, 5] {
        print(str(i) + "x" + str(j) + "=" + str(i * j));
    }
}
# 斐波那契数列
let a = 0;
let b = 1;
let count = 0;
while (count < 10) {
    print(a);
    let temp = a + b;
    a = b;
    b = temp;
    count = count + 1;
}
