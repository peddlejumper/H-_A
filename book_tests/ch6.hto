# 6.1 算术运算符
print(10 + 3);
print(10 - 3);
print(10 * 3);
print(10 / 3);
print(10 % 3);
# 6.2 整数除法特性
print(7 / 2);
print(7.0 / 2);
print(9 / 4);
print(9.0 / 4);
print(100 / 10);
print(-7 / 2);
# 6.3 比较运算符
print(5 == 5);
print(5 != 3);
print(8 > 3);
print(3 < 8);
print(5 >= 5);
print(5 <= 4);
print("abc" == "abc");
print("abc" != "abd");
# 6.4 逻辑运算符
print(true and true);
print(true and false);
print(false or true);
print(false or false);
print(not true);
print(not false);
# 短路求值
let n = 0;
if (n != 0 and 10 / n > 1) {
    print("不会执行");
} else {
    print("短路保护成功");
}
# 6.5 赋值运算符
let v = 10;
print(v);
v = 20;
print(v);
v = v + 5;
print(v);
v = v * 2;
print(v);
# 6.6 运算符优先级
print(2 + 3 * 4);
print((2 + 3) * 4);
print(10 - 2 - 3);
print(2 + 3 == 5);
print(true or false and false);
print(not true or false);
