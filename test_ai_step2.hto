# test_ai_step2.hto
let _ai_cfg = {
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "api_key": "",
    "model": "gpt-4o-mini",
    "max_tokens": 1024,
    "temperature": 0.3,
    "system_prompt": ""
};

fn ai_configure(cfg) {
    if (cfg == nullptr) {
        return;
    }
    if ("endpoint" in cfg) {
        let x = cfg["endpoint"];
        _ai_cfg["endpoint"] = x;
    }
}

print("ok");
