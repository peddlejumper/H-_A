{
  "name": "zzw-code",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && node index.js",
    "dev:all": "node -e \"const {spawn}=require('child_process'); spawn('npm',['run','dev:server'],{cwd:__dirname,stdio:'inherit'}); spawn('npm',['run','dev'],{cwd:__dirname,stdio:'inherit'})\"",
    "build": "tsc -b && node -e \"require('vite').build({})\"",
    "preview": "vite preview",
    "postinstall": "cd server && npm install"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.454.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}