<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZZW.CodeTeacher.Client.ViewModels"
             x:Class="ZZW.CodeTeacher.Client.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <Grid Background="Transparent">
    <Border Classes="panel" Padding="28,24"
            MaxWidth="400" MinWidth="300"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="16">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Border Classes="title-dot" />
            <TextBlock Text="{Binding HeaderText}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding SubHeaderText}" FontSize="12"
                     Foreground="{DynamicResource InkTertiaryBrush}" HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <Separator Margin="0,2" />

        <StackPanel Spacing="12">
          <StackPanel Spacing="5">
            <TextBlock Text="用户名" Classes="section" />
            <TextBox Text="{Binding Username}" Watermark="输入用户名(3~32 字符)" />
          </StackPanel>

          <StackPanel Spacing="5" IsVisible="{Binding IsRegisterMode}">
            <TextBlock Text="邮箱" Classes="section" />
            <TextBox Text="{Binding Email}" Watermark="输入邮箱(用于找回)" />
          </StackPanel>
          <StackPanel Spacing="5" IsVisible="{Binding IsRegisterMode}">
            <TextBlock Text="显示名(可选)" Classes="section" />
            <TextBox Text="{Binding DisplayName}" Watermark="留空则默认用用户名" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="密码" Classes="section" />
            <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="输入密码" />
          </StackPanel>

          <Border BorderBrush="{DynamicResource ErrorRed}" BorderThickness="2,0,0,0" Padding="10,8"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorRed}" FontSize="12"
                       TextWrapping="Wrap" />
          </Border>

          <Button Classes="primary" Content="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="0,4,0,0" />

          <Button Classes="text" Content="{Binding ToggleLinkText}"
                  Command="{Binding ToggleModeCommand}"
                  HorizontalAlignment="Center"
                  Padding="4,2" FontSize="12" />

          <Border Classes="code-chip" Padding="12,7"
                  IsVisible="{Binding !IsRegisterMode}">
            <TextBlock Text="测试账号 teacher1 / teacher12345"
                       Foreground="{DynamicResource InkMutedBrush}" FontSize="11"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                 Margin="16" />
  </Grid>
</UserControl>
