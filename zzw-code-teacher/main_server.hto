# main_server.hto
# ZZW Code Teacher — 服务端入口
# 用法:python3 hsharp.py main_server.hto
#
# 功能:
#   1. 初始化存储(data/)
#   2. 注册所有路由
#   3. 启动 HTTP 监听(默认 127.0.0.1:8765)
#   4. 接受来自 H# 客户端/管理端的请求
#
# 在没有 socket 原语的环境下,会进入"测试模式":
#   从 stdin 逐行读取 "METHOD PATH" 并输出响应

import "shared/json_utils.hto";
import "shared/storage.hto";
import "shared/auth.hto";
import "shared/http_server.hto";
import "shared/ai_client.hto";
import "shared/judge.hto";
import "shared/models.hto";

import "server/server.hto";
import "server/routes_auth.hto";
import "server/routes_problem.hto";
import "server/routes_submission.hto";
import "server/routes_ai.hto";
import "server/routes_user.hto";
import "server/routes_admin.hto";

fn main() {
    print("═══════════════════════════════════════════");
    print("  ZZW Code Teacher — Server");
    print("  智能代码教练 · 教学 OJ 服务端");
    print("═══════════════════════════════════════════");
    # 1. 初始化存储
    storage_init("./data");
    # 2. 加载 / 初始化配置
    let cfg = storage_load("config");
    if (cfg == nullptr or len(cfg) == 0) {
        cfg = config_default();
        storage_save("config", cfg);
        print("[init] 已写入默认 config.json");
    }
    # 3. 初始化 auth + ai
    if ("auth" in cfg) {
        auth_set_secret(cfg["auth"]["secret"]);
    }
    if ("ai" in cfg) {
        ai_client.ai_configure(cfg["ai"]);
    }
    # 4. 加载种子题目(若 problems.json 为空)
    let probs = storage_load("problems");
    if (len(probs) == 0) {
        # 优先尝试从 data/problems.json 加载
        if (fs_exists("./data/problems.json")) {
            let raw = read_file("./data/problems.json");
            let p = json_parse(raw);
            if (p != nullptr and len(p) > 0) {
                storage_save("problems", p);
                print("[init] 已加载 " + str(len(p)) + " 道种子题目");
            }
        }
    }
    # 5. 注册所有路由
    routes_auth.register();
    routes_problem.register();
    routes_submission.register();
    routes_ai.register();
    routes_user.register();
    routes_admin.register();
    # 6. 注册鉴权中间件(只对部分路由生效,这里注册为全局,
    #    各路由自行检查 req["user"] 即可;生产环境可在 route 层做更细粒度控制)
    use_middleware(auth_middleware_proxy);
    print("[init] 共注册 " + str(len(_routes)) + " 条路由");
    # 7. 启动监听
    let host = cfg["server"]["host"];
    let port = cfg["server"]["port"];
    print("[ready] 服务端已就绪: " + host + ":" + str(port));
    print("");
    print("路由列表:");
    let i = 0;
    while (i < len(_routes)) {
        let r = _routes[i];
        print("  " + r[0] + "  " + r[1]);
        i = i + 1;
    }
    print("");
    print("如果看到这条消息后立即退出,说明当前 H# 运行时暂未提供");
    print("socket 原语。可用 [serve_stdin_loop] 进入测试模式逐条处理。");
    return 0;
}

# 鉴权中间件(简化版)
fn auth_middleware_proxy(req) {
    # CORS 预检 / 公开接口直接放行
    if (req["method"] == "OPTIONS") {
        return nullptr;
    }
    let p = req["path"];
    let public_paths = [
        "/api/auth/login",
        "/api/auth/register",
        "/api/health"
    ];
    let i = 0;
    while (i < len(public_paths)) {
        if (p == public_paths[i]) {
            return nullptr;
        }
        i = i + 1;
    }
    # 其它: 解析 token
    let h = req["headers"];
    let auth_h = "";
    if ("Authorization" in h) { auth_h = h["Authorization"]; }
    if (auth_h == "") {
        return http_response(401, json_stringify(json_response_err("缺少 Authorization 头")), "application/json");
    }
    let tok = token_from_header(auth_h);
    let uid = token_verify(tok);
    if (uid == nullptr) {
        return http_response(401, json_stringify(json_response_err("Token 无效或过期")), "application/json");
    }
    let u = storage_find_one("users", "id", uid);
    if (u == nullptr) {
        return http_response(401, json_stringify(json_response_err("用户不存在")), "application/json");
    }
    if (u["status"] == "banned") {
        return http_response(403, json_stringify(json_response_err("账号已停用")), "application/json");
    }
    req["user"] = u;
    return nullptr;
}
