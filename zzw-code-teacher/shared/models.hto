# shared/models.hto
# 数据模型: User / Problem / Submission / Course / Progress / Config

import "shared/json_utils.hto";

# ============= User =============
# 学员与管理员共用一张表,通过 role 区分
# role: "student" | "admin" | "teacher"

fn user_new(id, username, password_hash, role) {
    return {
        "id": id,
        "username": username,
        "password_hash": password_hash,
        "role": role,                # student / teacher / admin
        "display_name": username,
        "email": "",
        "class_id": "",              # 所属班级
        "created_at": time_now(),
        "last_login": 0,
        "total_submissions": 0,
        "total_accepted": 0,
        "status": "active"           # active / banned
    };
}

fn user_to_json(u) {
    # 不输出 password_hash
    return {
        "id": u["id"],
        "username": u["username"],
        "role": u["role"],
        "display_name": u["display_name"],
        "email": u["email"],
        "class_id": u["class_id"],
        "created_at": u["created_at"],
        "last_login": u["last_login"],
        "total_submissions": u["total_submissions"],
        "total_accepted": u["total_accepted"],
        "status": u["status"]
    };
}

# ============= Problem =============
# 题目模型:包含描述 / 样例 / 测试用例(可隐藏)

fn problem_new(id, title, difficulty) {
    return {
        "id": id,
        "title": title,
        "difficulty": difficulty,    # easy / medium / hard
        "tags": [],
        "description": "",
        "input_format": "",
        "output_format": "",
        "samples": [],               # [{"input": "...", "output": "...", "explain": "..."}]
        "test_cases": [],            # [{"input": "...", "output": "...", "score": 1}]
        "hint": "",                  # AI 可读
        "time_limit_ms": 2000,
        "memory_limit_kb": 65536,
        "template": "",              # 学员起始代码
        "created_by": "",
        "created_at": time_now(),
        "updated_at": time_now(),
        "submission_count": 0,
        "accepted_count": 0
    };
}

# ============= Submission =============
# 提交记录:含代码、评测结果、AI 提示历史

fn submission_new(user_id, problem_id, code) {
    return {
        "id": "sub_" + str(time_now()) + "_" + str(rand_int(1000, 9999)),
        "user_id": user_id,
        "problem_id": problem_id,
        "code": code,
        "language": "h#",
        "status": "queued",          # queued / running / accepted / wrong_answer / runtime_error / time_limit / memory_limit / compile_error
        "score": 0,                  # 0~100
        "passed": 0,
        "total": 0,
        "stdout": "",
        "stderr": "",
        "time_ms": 0,
        "memory_kb": 0,
        "ai_hints": [],              # AI 提示历史 [{"role": "user", "content": "..."}, ...]
        "created_at": time_now(),
        "finished_at": 0
    };
}

# ============= Course =============
# 课程/班级:用于把学员分组,题目可分配给课程

fn course_new(id, name, teacher_id) {
    return {
        "id": id,
        "name": name,
        "teacher_id": teacher_id,
        "student_ids": [],
        "problem_ids": [],
        "created_at": time_now()
    };
}

# ============= Progress =============
# 学员对每个题目的进度

fn progress_new(user_id, problem_id) {
    return {
        "user_id": user_id,
        "problem_id": problem_id,
        "status": "not_started",     # not_started / attempted / solved
        "attempts": 0,
        "best_score": 0,
        "last_submission": 0,
        "wrong_samples": []          # 错题样例
    };
}

# ============= Config =============
# 服务端配置(同时可让管理员修改)

fn config_default() {
    return {
        "server": {
            "host": "127.0.0.1",
            "port": 8765
        },
        "judge": {
            "time_limit_ms": 2000,
            "memory_limit_kb": 65536,
            "hsvm_path": "./hsvm"
        },
        "ai": {
            "enabled": true,
            "endpoint": "https://api.openai.com/v1/chat/completions",
            "api_key": "",
            "model": "gpt-4o-mini",
            "max_tokens": 1024,
            "temperature": 0.3,
            "system_prompt": "你是一名耐心的 H# 编程教练。只给学员思路提示和方向,不直接给出完整可粘贴的代码。"
        },
        "auth": {
            "token_ttl_sec": 86400,
            "secret": "zzw-code-teacher-default-secret"
        }
    };
}

# ============= rand =============
# 使用 host 内置 rand_int(lo, hi)
