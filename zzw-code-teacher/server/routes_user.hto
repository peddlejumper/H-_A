# server/routes_user.hto
# 学员视角:
#   GET  /api/user/profile           个人信息
#   GET  /api/user/progress          所有进度
#   GET  /api/user/wrong-book        错题本(未通过的题)
#   GET  /api/user/leaderboard       排行榜

import "shared/json_utils.hto";
import "shared/storage.hto";
import "shared/models.hto";

fn register() {
    route("GET", "/api/user/profile", _profile);
    route("GET", "/api/user/progress", _progress);
    route("GET", "/api/user/wrong-book", _wrong);
    route("GET", "/api/user/leaderboard", _leaderboard);
}

fn _profile(req) {
    if (req["user"] == nullptr) {
        return http_response(401, json_stringify(json_response_err("未登录")), "application/json");
    }
    return http_response(200, json_stringify(json_response_ok(user_to_json(req["user"]))), "application/json");
}

fn _progress(req) {
    if (req["user"] == nullptr) {
        return http_response(401, json_stringify(json_response_err("未登录")), "application/json");
    }
    let rows = storage_all("progress");
    let mine = [];
    let i = 0;
    while (i < len(rows)) {
        if (rows[i]["user_id"] == req["user"]["id"]) {
            mine.append(rows[i]);
        }
        i = i + 1;
    }
    # 统计
    let solved = 0;
    let attempted = 0;
    i = 0;
    while (i < len(mine)) {
        if (mine[i]["status"] == "solved") { solved = solved + 1; }
        else if (mine[i]["status"] == "attempted") { attempted = attempted + 1; }
        i = i + 1;
    }
    return http_response(200, json_stringify(json_response_ok({
        "items": mine,
        "summary": {
            "solved": solved,
            "attempted": attempted,
            "total": len(mine)
        }
    })), "application/json");
}

fn _wrong(req) {
    if (req["user"] == nullptr) {
        return http_response(401, json_stringify(json_response_err("未登录")), "application/json");
    }
    let rows = storage_all("progress");
    let wrong = [];
    let i = 0;
    while (i < len(rows)) {
        if (rows[i]["user_id"] == req["user"]["id"] and rows[i]["status"] != "solved") {
            let p = storage_get_by_id("problems", rows[i]["problem_id"]);
            if (p != nullptr) {
                wrong.append({
                    "problem_id": rows[i]["problem_id"],
                    "title": p["title"],
                    "difficulty": p["difficulty"],
                    "attempts": rows[i]["attempts"],
                    "best_score": rows[i]["best_score"]
                });
            }
        }
        i = i + 1;
    }
    return http_response(200, json_stringify(json_response_ok(wrong)), "application/json");
}

fn _leaderboard(req) {
    let users = storage_all("users");
    # 只取学生
    let students = [];
    let i = 0;
    while (i < len(users)) {
        if (users[i]["role"] == "student") {
            students.append(users[i]);
        }
        i = i + 1;
    }
    # 按 accepted 排序(简单选择排序,O(n²) 够用)
    let n = len(students);
    let j = 0;
    while (j < n - 1) {
        let mi = j;
        let k = j + 1;
        while (k < n) {
            if (students[k]["total_accepted"] > students[mi]["total_accepted"]) {
                mi = k;
            }
            k = k + 1;
        }
        if (mi != j) {
            let tmp = students[j];
            students[j] = students[mi];
            students[mi] = tmp;
        }
        j = j + 1;
    }
    # 取前 20,脱敏
    let out = [];
    let rank = 1;
    i = 0;
    while (i < n and i < 20) {
        out.append({
            "rank": rank,
            "username": students[i]["username"],
            "display_name": students[i]["display_name"],
            "total_accepted": students[i]["total_accepted"],
            "total_submissions": students[i]["total_submissions"]
        });
        rank = rank + 1;
        i = i + 1;
    }
    return http_response(200, json_stringify(json_response_ok(out)), "application/json");
}

# 自动注册
register();
