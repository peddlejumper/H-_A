# Probe S10 — Default value in destructure pattern.
# `let [a, b = 10] = [1];`
# The parser's `_destructure_slot` only accepts IDENTIFIER or `_`,
# and does not parse a `= default` tail, so a `=` after the slot
# identifier should raise a compile-time SyntaxError.
#
# Expected: COMPILE ERROR.  This probe exists to confirm that.

let [a, b = 10] = [1];
print(a);
print(b);
