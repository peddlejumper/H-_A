probe("14.11 min([true,false])", "ok (bool coerces)", fn() { return min([true, false]); });

# ============================================================
# 15. pow — 直接 try/catch (pow 不检查参数个数, 抛 JVM IOBE)
# ============================================================
print("--- 15. pow ---");
let r15a = "no-err";
try { let v = pow(); r15a = "ok:" + str(v); } catch (e) { r15a = "err:" + str(e); }
print("[15.1 pow(0参)] expect=err: needs 2 args]");
print("  => " + r15a);
let r15b = "no-err";
try { let v = pow(1); r15b = "ok:" + str(v); } catch (e) { r15b = "err:" + str(e); }
print("[15.2 pow(1)] expect=err: needs 2 args]");
print("  => " + r15b);
let r15c = "no-err";
try { let v = pow(2, 3, 4); r15c = "ok:" + str(v); } catch (e) { r15c = "err:" + str(e); }
print("[15.3 pow(2,3,4)] expect=ok or err? (3 args)]");
print("  => " + r15c);
let r15d = "no-err";
try { let v = pow("a", 2); r15d = "ok:" + str(v); } catch (e) { r15d = "err:" + str(e); }
print("[15.4 pow('a',2)] expect=err: cannot coerce STRING]");
print("  => " + r15d);
let r15e = "no-err";
try { let v = pow(2, "a"); r15e = "ok:" + str(v); } catch (e) { r15e = "err:" + str(e); }
print("[15.5 pow(2,'a')] expect=err: cannot coerce STRING]");
print("  => " + r15e);
let r15f = "no-err";
try { let v = pow(0, 0); r15f = "ok:" + str(v); } catch (e) { r15f = "err:" + str(e); }
print("[15.6 pow(0,0)] expect=ok:1]");
print("  => " + r15f);
let r15g = "no-err";
try { let v = pow(-1, 0.5); r15g = "ok:" + str(v); } catch (e) { r15g = "err:" + str(e); }
print("[15.7 pow(-1,0.5)] expect=ok:NaN]");
print("  => " + r15g);
let r15h = "no-err";
try { let v = pow(2, 3); r15h = "ok:" + str(v); } catch (e) { r15h = "err:" + str(e); }
print("[15.8 pow(2,3)] expect=ok:8]");
print("  => " + r15h);

