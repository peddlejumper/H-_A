# 8. range
# ============================================================
print("--- 8. range ---");
probe("8.1 range(0参)", "err: takes 1/2/3 args", fn() { return range(); });
probe("8.2 range(1,2,3,4)", "err: takes 1/2/3 args", fn() { return range(1, 2, 3, 4); });
probe("8.3 range('a')", "err: cannot coerce STRING", fn() { return range("a"); });
probe("8.4 range(1,'a')", "err: cannot coerce STRING", fn() { return range(1, "a"); });
probe("8.5 range(0,10,0)", "err: step cannot be zero", fn() { return range(0, 10, 0); });
probe("8.6 range(5)", "ok:[0,1,2,3,4]", fn() { return range(5); });
probe("8.7 range(1,5)", "ok:[1,2,3,4]", fn() { return range(1, 5); });
probe("8.8 range(0,10,3)", "ok:[0,3,6,9]", fn() { return range(0, 10, 3); });
probe("8.9 range(10,0,-2)", "ok:[10,8,6,4,2]", fn() { return range(10, 0, -2); });
probe("8.10 range(0,5,0.5)", "err: step must be integer", fn() { return range(0, 5, 0.5); });

