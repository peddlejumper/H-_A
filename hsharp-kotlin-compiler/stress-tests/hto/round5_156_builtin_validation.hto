let r17h = "no-err";
try { let v = substring("hello", 0, -1); r17h = "ok:" + str(v); } catch (e) { r17h = "err:" + str(e); }
print("[17.8 substring('hello',0,-1)] expect=err: non-negative]");
print("  => " + r17h);

