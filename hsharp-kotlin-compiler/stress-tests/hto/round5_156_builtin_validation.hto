# ============================================================
# round5_156_builtin_validation.hto
# 内置函数参数验证全面测试 (Round 5, #156)
# 目标: 对每个内置函数施加边界/错误参数, 检查:
#   1) 是否抛出 H# 异常 (而非 JVM 异常泄露)
#   2) 错误信息是否为 H# 语义 (而非 JVM 堆栈信息)
#   3) 参数个数/类型检查是否完备
# 方法: 每个用例 try/catch 包裹, 打印 [TAG 预期] 实际
# ============================================================

print("===== R5-156 BUILTIN VALIDATION =====");

# 辅助: 判断异常消息是否像 JVM 异常 (启发式)
fn isJvmMsg(s) {
    let m = str(s);
    if (m == "Index 0 out of bounds for length 0") { return "JVM-IOBE"; }
    if (m == "Index 1 out of bounds for length 0") { return "JVM-IOBE"; }
    if (m == "Index 1 out of bounds for length 1") { return "JVM-IOBE"; }
    if (m == "Index 2 out of bounds for length 0") { return "JVM-IOBE"; }
    if (m == "Index 2 out of bounds for length 1") { return "JVM-IOBE"; }
    if (m == "Index 2 out of bounds for length 2") { return "JVM-IOBE"; }
    # NumberFormatException 消息以 "For input string" 开头
    if (len(m) >= 17) {
        if (substring(m, 0, 17) == "For input string:") { return "JVM-NFE"; }
    }
    # ClassCastException 消息
    if (len(m) >= 16) {
        if (substring(m, 0, 16) == "class java.lang") { return "JVM-CCE"; }
    }
    if (m == "null") { return "JVM-NULL"; }
    return "H#-OK";
}

# 通用探测: 调用 expr_fn, 捕获异常, 返回 "ok:<val>" / "err:<msg>"
fn probe(label, expected, expr_fn) {
    let result = "";
    try {
        let v = expr_fn();
        result = "ok:" + str(v);
    } catch (e) {
        let j = isJvmMsg(e);
        result = "err[" + j + "]:" + str(e);
    }
    print("[" + label + "] expect=" + expected + "]");
    print("  => " + result);
}

# ============================================================
# 1. print — 语句, 不是函数 (PRINT opcode)
#    print() 和 print(a,b) 是编译期错误, 无法运行时测试
# ============================================================
print("--- 1. print ---");
print("[1.1 print(null)] expect=null]");
print(null);
print("[1.2 print(list)] expect=[1, 2, 3]]");
print([1, 2, 3]);
print("[1.3 print(dict)] expect={a: 1}]");
print({"a": 1});
print("[1.4 print(42)] expect=42]");
print(42);
print("[1.5 print(true)] expect=true]");
print(true);
print("[1.6 print('')] expect=blank-line]");
print("");
# NOTE: print(a, b) 和 print() 是语法错误, 编译期失败, 不能运行时测试

# ============================================================
# 2. len
# ============================================================
print("--- 2. len ---");
probe("2.1 len(0参)", "err: requires 1 arg", fn() { return len(); });
probe("2.2 len(42)", "err: not supported", fn() { return len(42); });
probe("2.3 len(null)", "err: not supported", fn() { return len(null); });
probe("2.4 len(true)", "err: not supported", fn() { return len(true); });
probe("2.5 len('')", "ok:0", fn() { return len(""); });
probe("2.6 len([])", "ok:0", fn() { return len([]); });
probe("2.7 len({})", "ok:0", fn() { return len({}); });
fn dummy_fn() { return 1; }
probe("2.8 len(fn)", "err: not supported", fn() { return len(dummy_fn); });
probe("2.9 len('hello')", "ok:5", fn() { return len("hello"); });
probe("2.10 len([1,2,3])", "ok:3", fn() { return len([1, 2, 3]); });

# ============================================================
# 3. type
# ============================================================
print("--- 3. type ---");
probe("3.1 type(0参)", "err: requires 1 arg", fn() { return type(); });
probe("3.2 type(42)", "string:number", fn() { return type(42); });
probe("3.3 type('a')", "string:string", fn() { return type("a"); });
probe("3.4 type(true)", "string:bool", fn() { return type(true); });
probe("3.5 type([])", "string:list", fn() { return type([]); });
probe("3.6 type({})", "string:dict", fn() { return type({}); });
probe("3.7 type(null)", "string:null", fn() { return type(null); });
probe("3.8 type(fn)", "string:function", fn() { return type(dummy_fn); });

# ============================================================
# 4. str
# ============================================================
print("--- 4. str ---");
probe("4.1 str(0参)", "err: requires 1 arg", fn() { return str(); });
probe("4.2 str(null)", "ok:null", fn() { return str(null); });
probe("4.3 str(list)", "ok:[1, 2, 3]", fn() { return str([1, 2, 3]); });
probe("4.4 str(dict)", "ok:{a: 1}", fn() { return str({"a": 1}); });
probe("4.5 str(fn)", "ok:<native or function>", fn() { return str(dummy_fn); });
probe("4.6 str(true)", "ok:true", fn() { return str(true); });
probe("4.7 str(3.14)", "ok:3.14", fn() { return str(3.14); });
probe("4.8 str(42)", "ok:42", fn() { return str(42); });

