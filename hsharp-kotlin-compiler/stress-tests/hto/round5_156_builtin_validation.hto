# 21. chan_* 参数验证 — 直接 try/catch
# ============================================================
print("--- 21. chan_* ---");
let r21a = "no-err";
try { let v = chan_new(); r21a = "ok:" + str(v); } catch (e) { r21a = "err:" + str(e); }
print("[21.1 chan_new(0参)] expect=err: needs 1 arg]");
print("  => " + r21a);
let r21b = "no-err";
try { let v = chan_new(-1); r21b = "ok:" + str(type(v)); } catch (e) { r21b = "err:" + str(e); }
print("[21.2 chan_new(-1)] expect=ok: channel (cap<0->0)]");
print("  => " + r21b);
let r21c = "no-err";
try { let v = chan_send(); r21c = "ok:" + str(v); } catch (e) { r21c = "err:" + str(e); }
print("[21.3 chan_send(0参)] expect=err: needs 2 args]");
print("  => " + r21c);
let r21d = "no-err";
try { let v = chan_send(42, 1); r21d = "ok:" + str(v); } catch (e) { r21d = "err:" + str(e); }
print("[21.4 chan_send(42,1)] expect=err: must be channel]");
print("  => " + r21d);
let r21e = "no-err";
try { let v = chan_recv(); r21e = "ok:" + str(v); } catch (e) { r21e = "err:" + str(e); }
print("[21.5 chan_recv(0参)] expect=err: needs 1 arg]");
