# 14. min / max
# ============================================================
print("--- 14. min/max ---");
probe("14.1 min(0参)", "err: empty sequence", fn() { return min(); });
probe("14.2 min([])", "err: empty sequence", fn() { return min([]); });
probe("14.3 max([])", "err: empty sequence", fn() { return max([]); });
probe("14.4 min([1])", "ok:1", fn() { return min([1]); });
probe("14.5 min(['a','b'])", "err: cannot coerce STRING", fn() { return min(["a", "b"]); });
