print("--- 5. int ---");
probe("5.1 int(0参)", "err: requires 1 arg", fn() { return int(); });
probe("5.2 int(null)", "err: cannot convert null", fn() { return int(null); });
probe("5.3 int('abc')", "err: cannot coerce", fn() { return int("abc"); });
probe("5.4 int('3.14')", "ok:3", fn() { return int("3.14"); });
probe("5.5 int(true)", "ok:1", fn() { return int(true); });
probe("5.6 int([])", "err: cannot coerce", fn() { return int([]); });
probe("5.7 int([1])", "err: cannot coerce", fn() { return int([1]); });
probe("5.8 int(42)", "ok:42", fn() { return int(42); });
probe("5.9 int(3.99)", "ok:3", fn() { return int(3.99); });
probe("5.10 int(-3.14)", "ok:-3", fn() { return int(-3.14); });

