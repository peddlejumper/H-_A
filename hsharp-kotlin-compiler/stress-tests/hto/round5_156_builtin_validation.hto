# 16. fmt
# ============================================================
print("--- 16. fmt ---");
probe("16.1 fmt(0参)", "ok:'' (empty)", fn() { return fmt(); });
probe("16.2 fmt('{}')", "ok:{} (literal, no {N})", fn() { return fmt("{}"); });
probe("16.3 fmt('{} {}', 1)", "ok:{} {} (1 arg)", fn() { return fmt("{} {}", 1); });
probe("16.4 fmt('{0} {1}', 1, 2)", "ok:1 2", fn() { return fmt("{0} {1}", 1, 2); });
probe("16.5 fmt('{0} {1}', 1, 2, 3)", "ok:1 2 (extra ignored)", fn() { return fmt("{0} {1}", 1, 2, 3); });
probe("16.6 fmt('{x}', 1)", "ok:{x} (literal)", fn() { return fmt("{x}", 1); });
probe("16.7 fmt('{0}', 'a', 'b')", "ok:a", fn() { return fmt("{0}", "a", "b"); });
probe("16.8 fmt('hello')", "ok:hello", fn() { return fmt("hello"); });

