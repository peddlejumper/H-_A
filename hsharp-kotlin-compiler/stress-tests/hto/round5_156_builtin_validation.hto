# ============================================================
# 24. 专项: JVM 异常在 lambda 中的传播 (runFrame 缺少 RuntimeException catch)
# ============================================================
print("--- 24. JVM异常在lambda中的传播 ---");
# H# 异常 (HSharpRuntimeError) 在 lambda 中可以被 try/catch 捕获
let r24a = "no-err";
try {
    let f = fn() { return len(); };
    let v = f();
    r24a = "ok:" + str(v);
} catch (e) { r24a = "caught:" + str(e); }
print("[24.1 H#异常在lambda中] expect=caught => " + r24a);
# NOTE: 24.2 (pow() in lambda) 已在第一轮测试中确认会导致 Fatal crash
# 根因: runFrame() 缺少 catch (ex: RuntimeException), JVM IndexOutOfBounds
# 异常在嵌套帧中无法被 H# try/catch 捕获, 传播到 HbcLauncher 成为 Fatal
print("[24.2 JVM异常在lambda中] SKIPPED (已知 Fatal crash, bug #156-S1)");
