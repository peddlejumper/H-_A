# round4_121_defaults.hto — 测试智能体 #121 (Round 4)
# 领域: 默认参数 (Default Parameters)
# H# v0.4.1
#
# 测试范围:
#   S1  全部参数有默认值
#   S2  部分覆盖默认值 (位置参数, 从左到右)
#   S3  默认值为表达式       -> 编译期拒绝 (见 _probe121c.hto)
#   S4  默认值捕获外部变量   -> 编译期拒绝 (见 _probe121d.hto)
#   S5  可变默认值(列表/字典)-> 编译期拒绝 (见 _probe121e.hto)
#   S6  默认参数 + 可变参数
#   S7  类方法默认参数
#   S8  null 作为默认值
#   S9  默认参数引用前一个参数 -> 编译期拒绝 (见 _probe121f.hto)
#   S10 用 null 覆盖默认值
#
# 编译器限制: 默认值必须是字面量 (number/string/bool/null).
#   表达式、变量引用、列表/字典字面量、负数字面量(解析为BinaryOp)均被拒绝.
#   证据见 _probe121c/d/e/f/h.hto.
#
# 每个用例 try/catch 包裹; 打印 "Sxx-Tyy:" 前缀, 预期值在注释.

print("=== S1: all params have defaults ===");

# S1-T01: f() 全部使用默认值
try {
    fn f(a=1, b=2, c=3) { return a + b + c; }
    print("S1-T01: " + f());   # 6
} catch (e) { print("S1-T01-ERR: " + e); }

# S1-T02: f(10) 只覆盖第一个
try {
    fn f(a=1, b=2, c=3) { return a + b + c; }
    print("S1-T02: " + f(10));   # 15
} catch (e) { print("S1-T02-ERR: " + e); }

# S1-T03: f(10, 20) 覆盖前两个
try {
    fn f(a=1, b=2, c=3) { return a + b + c; }
    print("S1-T03: " + f(10, 20));   # 33
} catch (e) { print("S1-T03-ERR: " + e); }

# S1-T04: f(10, 20, 30) 覆盖全部
try {
    fn f(a=1, b=2, c=3) { return a + b + c; }
    print("S1-T04: " + f(10, 20, 30));   # 60
} catch (e) { print("S1-T04-ERR: " + e); }

# S1-T05: 全部默认 - 字符串拼接
try {
    fn join(s1="a", s2="b", s3="c") { return s1 + s2 + s3; }
    print("S1-T05: " + join());          # abc
    print("S1-T05: " + join("X"));       # Xbc
    print("S1-T05: " + join("X", "Y"));  # XYc
    print("S1-T05: " + join("X", "Y", "Z"));  # XYZ
} catch (e) { print("S1-T05-ERR: " + e); }

print("=== S2: partial override (positional) ===");

# S2-T01: 覆盖第一个参数, 其余默认
try {
    fn f(a=1, b=2, c=3) { return [a, b, c]; }
    print("S2-T01: " + f(10));   # [10, 2, 3]
} catch (e) { print("S2-T01-ERR: " + e); }

# S2-T02: 覆盖前两个参数
try {
    fn f(a=1, b=2, c=3) { return [a, b, c]; }
    print("S2-T02: " + f(10, 20));   # [10, 20, 3]
} catch (e) { print("S2-T02-ERR: " + e); }

# S2-T03: 无法跳过中间参数 (位置参数语义) — 提供参数必然从左到右覆盖
try {
    fn f(a=1, b=2, c=3) { return [a, b, c]; }
    # 想只覆盖 b (中间) 需要关键字参数, H# 不支持; 只能 f(1, 99) 显式传 a
    print("S2-T03: " + f(1, 99));   # [1, 99, 3]
} catch (e) { print("S2-T03-ERR: " + e); }

# S2-T04: 覆盖最后一个 (需显式传前两个)
try {
    fn f(a=1, b=2, c=3) { return [a, b, c]; }
    print("S2-T04: " + f(1, 2, 99));   # [1, 2, 99]
} catch (e) { print("S2-T04-ERR: " + e); }

# S2-T05: 必需参数 + 默认参数混合, 只传必需
try {
    fn f(a, b=2, c=3) { return [a, b, c]; }
    print("S2-T05: " + f(10));   # [10, 2, 3]
} catch (e) { print("S2-T05-ERR: " + e); }

print("=== S3: expression default (COMPILE-REJECTED) ===");
# S3 编译期拒绝, 见 _probe121c.hto: fn f(a=1+2, b=len([1,2,3]))
# 错误: "Default argument ... must be a literal ... got BinaryOp"
# 此处用字面量替代以保持文件可编译
try {
    fn f(a=3, b=3) { return a + b; }   # 用预计算字面量替代表达式
    print("S3-T01: " + f());   # 6
} catch (e) { print("S3-T01-ERR: " + e); }

print("=== S4: default captures outer var (COMPILE-REJECTED) ===");
# S4 编译期拒绝, 见 _probe121d.hto: let g=10; fn f(x=g){...}
# 错误: "Default argument ... must be a literal ... got Identifier"
try {
    let g = 10;
    fn f(x=10) { return x + g; }   # 默认值用字面量, 函数内引用 g
    print("S4-T01: " + f());   # 20
} catch (e) { print("S4-T01-ERR: " + e); }

print("=== S5: mutable default (COMPILE-REJECTED) ===");
# S5 编译期拒绝, 见 _probe121e.hto: fn f(lst=[]){...}
# 错误: "Default argument ... must be a literal ... got ArrayLiteral"
# 无法测试可变默认值共享问题; 用 null 默认值 + 内部初始化模拟
try {
    fn f(lst=null) {
        if (lst == null) { lst = []; }
        push(lst, 1);
        return lst;
    }
    print("S5-T01: " + f());   # [1]
    print("S5-T01: " + f());   # [1]  (每次新 list, 因 null 触发重建)
} catch (e) { print("S5-T01-ERR: " + e); }

print("=== S6: default + variadic ===");

# S6-T01: 默认参数 + 可变参数, 省略默认参数 — BUG 预期
try {
    fn f(a, b=2, ...rest) { return [a, b, rest]; }
    print("S6-T01: " + f(1));   # 预期 [1, 2, []] ; BUG: 报错 "expects at least 2 args"
} catch (e) { print("S6-T01-ERR: " + e); }

# S6-T02: 提供默认参数的值 — 应正常工作
try {
    fn f(a, b=2, ...rest) { return [a, b, rest]; }
    print("S6-T02: " + f(1, 20));   # [1, 20, []]
} catch (e) { print("S6-T02-ERR: " + e); }

# S6-T03: 提供默认参数 + 可变参数
try {
    fn f(a, b=2, ...rest) { return [a, b, rest]; }
    print("S6-T03: " + f(1, 20, 30, 40));   # [1, 20, [30, 40]]
} catch (e) { print("S6-T03-ERR: " + e); }

# S6-T04: 全部默认 + 可变参数, 省略全部 — BUG 预期
try {
    fn f(a=1, ...rest) { return [a, rest]; }
    print("S6-T04: " + f());   # 预期 [1, []] ; BUG: 报错 "expects at least 1 args"
} catch (e) { print("S6-T04-ERR: " + e); }

# S6-T05: 全部默认 + 可变参数, 提供一个
try {
    fn f(a=1, ...rest) { return [a, rest]; }
    print("S6-T05: " + f(99));   # [99, []]
} catch (e) { print("S6-T05-ERR: " + e); }

# S6-T06: 全部默认 + 可变参数, 提供多个
try {
    fn f(a=1, ...rest) { return [a, rest]; }
    print("S6-T06: " + f(99, 100));   # [99, [100]]
} catch (e) { print("S6-T06-ERR: " + e); }

print("=== S7: class method default params ===");

# S7-T01: 类方法带默认参数, 省略默认
try {
    class C71 {
        fn init(v) { self.v = v; }
        fn m(a, b=10) { return self.v + a + b; }
    }
    let c = new C71(100);
    print("S7-T01: " + c.m(5));   # 115
} catch (e) { print("S7-T01-ERR: " + e); }

# S7-T02: 类方法带默认参数, 提供默认
try {
    class C72 {
        fn init(v) { self.v = v; }
        fn m(a, b=10) { return self.v + a + b; }
    }
    let c = new C72(100);
    print("S7-T02: " + c.m(5, 20));   # 125
} catch (e) { print("S7-T02-ERR: " + e); }

# S7-T03: 类方法全部默认参数
try {
    class C73 {
        fn init(v) { self.v = v; }
        fn m(a=1, b=2) { return self.v + a + b; }
    }
    let c = new C73(100);
    print("S7-T03: " + c.m());      # 103
    print("S7-T03: " + c.m(10));    # 112
    print("S7-T03: " + c.m(10, 20));# 130
} catch (e) { print("S7-T03-ERR: " + e); }

# S7-T04: 类方法默认参数引用 self 字段 (字面量默认, 函数体内用 self)
try {
    class C74 {
        fn init(base) { self.base = base; }
        fn m(a, b=10) { return self.base * a + b; }
    }
    let c = new C74(5);
    print("S7-T04: " + c.m(3));     # 25 (5*3+10)
    print("S7-T04: " + c.m(3, 1));  # 16 (5*3+1)
} catch (e) { print("S7-T04-ERR: " + e); }

# S7-T05: 继承的类方法默认参数
try {
    class Base75 {
        fn init(v) { self.v = v; }
        fn m(a, b=10) { return self.v + a + b; }
    }
    class Sub75 extends Base75 {
        fn init(v) { self.v = v; }
    }
    let s = new Sub75(1000);
    print("S7-T05: " + s.m(1));      # 1011
    print("S7-T05: " + s.m(1, 2));   # 1003
} catch (e) { print("S7-T05-ERR: " + e); }

print("=== S8: null as default ===");

# S8-T01: null 默认值, 不传参
try {
    fn f(x=null) { return x; }
    print("S8-T01: " + f());   # null
} catch (e) { print("S8-T01-ERR: " + e); }

# S8-T02: null 默认值, 内部判断
try {
    fn f(x=null) {
        if (x == null) { return "default"; }
        return x;
    }
    print("S8-T02: " + f());        # default
    print("S8-T02: " + f(42));      # 42
    print("S8-T02: " + f("hello")); # hello
} catch (e) { print("S8-T02-ERR: " + e); }

# S8-T03: null 默认值与 type() 配合
try {
    fn f(x=null) {
        return type(x);
    }
    print("S8-T03: " + f());    # null (类型名)
    print("S8-T03: " + f(0));   # number
    print("S8-T03: " + f(""));  # string
} catch (e) { print("S8-T03-ERR: " + e); }

# S8-T04: 多个 null 默认值
try {
    fn f(a=null, b=null, c=null) {
        return [a, b, c];
    }
    print("S8-T04: " + f());          # [null, null, null]
    print("S8-T04: " + f(1));         # [1, null, null]
    print("S8-T04: " + f(1, 2));      # [1, 2, null]
    print("S8-T04: " + f(1, 2, 3));   # [1, 2, 3]
} catch (e) { print("S8-T04-ERR: " + e); }

# S8-T05: null 默认值配合 len() 等内置函数 (null 应触发错误或特殊处理)
try {
    fn f(x=null) {
        if (x == null) { return -1; }
        return len(x);
    }
    print("S8-T05: " + f());          # -1
    print("S8-T05: " + f([1,2,3]));   # 3
    print("S8-T05: " + f("abc"));     # 3
} catch (e) { print("S8-T05-ERR: " + e); }

print("=== S9: default referencing earlier param (COMPILE-REJECTED) ===");
# S9 编译期拒绝, 见 _probe121f.hto: fn f(a, b=a){...}
# 错误: "Default argument ... must be a literal ... got Identifier"
# 用函数体内赋值模拟
try {
    fn f(a, b=null) {
        if (b == null) { b = a; }
        return [a, b];
    }
    print("S9-T01: " + f(5));       # [5, 5]  (模拟 b=a)
    print("S9-T01: " + f(5, 99));   # [5, 99]
} catch (e) { print("S9-T01-ERR: " + e); }

print("=== S10: override default with null ===");

# S10-T01: 用 null 覆盖数字默认值
try {
    fn f(x=10) { return x; }
    print("S10-T01: " + f());       # 10
    print("S10-T01: " + f(null));   # null (显式覆盖为 null)
    print("S10-T01: " + f(20));     # 20
} catch (e) { print("S10-T01-ERR: " + e); }

# S10-T02: 用 null 覆盖字符串默认值
try {
    fn f(s="default") { return s; }
    print("S10-T02: " + f());       # default
    print("S10-T02: " + f(null));   # null
} catch (e) { print("S10-T02-ERR: " + e); }

# S10-T03: 用 null 覆盖布尔默认值
try {
    fn f(b=true) { return b; }
    print("S10-T03: " + f());       # true
    print("S10-T03: " + f(null));   # null
    print("S10-T03: " + f(false));  # false
} catch (e) { print("S10-T03-ERR: " + e); }

# S10-T04: null 覆盖后内部判断 — 区分 "未传" 与 "传 null"
try {
    fn f(x=10) {
        if (x == null) { return "got-null"; }
        return x;
    }
    print("S10-T04: " + f());       # 10
    print("S10-T04: " + f(null));   # got-null
    print("S10-T04: " + f(0));      # 0
} catch (e) { print("S10-T04-ERR: " + e); }

# S10-T05: null 默认值 + null 覆盖 (无区别)
try {
    fn f(x=null) { return x; }
    print("S10-T05: " + f());       # null
    print("S10-T05: " + f(null));   # null
    print("S10-T05: " + f(5));      # 5
} catch (e) { print("S10-T05-ERR: " + e); }

print("=== Edge cases ===");

# E01: 太少参数 — 必需参数缺失
try {
    fn f(a, b=2) { return a + b; }
    print("E01: " + f());   # ERR: expects 2 args (min 1)
} catch (e) { print("E01-ERR: " + e); }

# E02: 太多参数
try {
    fn f(a, b=2) { return a + b; }
    print("E02: " + f(1, 2, 3));   # ERR: expects 2 args (min 1), got 3
} catch (e) { print("E02-ERR: " + e); }

# E03: float 默认值
try {
    fn f(x=3.14) { return x; }
    print("E03: " + f());      # 3.14
    print("E03: " + f(2.0));   # 2 (HNumber 存 Double, 已知行为)
    print("E03: " + f(2.5));   # 2.5
} catch (e) { print("E03-ERR: " + e); }

# E04: 嵌套函数默认参数
try {
    fn outer() {
        fn inner(x=99) { return x; }
        return inner();
    }
    print("E04: " + outer());   # 99
} catch (e) { print("E04-ERR: " + e); }

# E05: let-lambda 默认参数
try {
    let lam = fn(x=50) { return x; };
    print("E05: " + lam());    # 50
    print("E05: " + lam(77));  # 77
} catch (e) { print("E05-ERR: " + e); }

# E06: 默认参数 + 递归
try {
    fn fact(n, acc=1) {
        if (n <= 1) { return acc; }
        return fact(n - 1, acc * n);
    }
    print("E06: " + fact(5));    # 120
    print("E06: " + fact(10));   # 3628800
} catch (e) { print("E06-ERR: " + e); }

# E07: 默认参数 + 闭包捕获
try {
    fn mk() {
        let base = 100;
        return fn(x=1) { return base + x; };
    }
    let f = mk();
    print("E07: " + f());     # 101
    print("E07: " + f(50));   # 150
} catch (e) { print("E07-ERR: " + e); }

# E08: 默认参数为 false (布尔字面量)
try {
    fn f(flag=false) {
        if (flag) { return "on"; }
        return "off";
    }
    print("E08: " + f());       # off
    print("E08: " + f(true));   # on
    print("E08: " + f(false));  # off
} catch (e) { print("E08-ERR: " + e); }

# E09: 多个默认参数, 中间用 null 覆盖
try {
    fn f(a=1, b=2, c=3) { return [a, b, c]; }
    print("E09: " + f(null, null));   # [null, null, 3]
    print("E09: " + f(null, 20));     # [null, 20, 3]
} catch (e) { print("E09-ERR: " + e); }

# E10: 默认参数 + 字典/列表作为实参 (非默认值, 而是传入)
try {
    fn f(a=1, b=2) { return [a, b]; }
    print("E10: " + f([1,2,3], {"k":"v"}));   # [[1,2,3], {k:v}]
} catch (e) { print("E10-ERR: " + e); }

print("=== ALL DONE ===");
