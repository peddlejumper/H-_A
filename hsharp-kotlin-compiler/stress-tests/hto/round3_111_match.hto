# ============================================================
# T27: 大整数 / 极端值字面量匹配
# ============================================================
fn extreme_lit(x) {
    return match x {
        9223372036854775807 => "max-i64",
        2147483647 => "max-i32",
        -2147483648 => "min-i32",
        3.14159265358979 => "pi-prec",
        _ => "other"
    };
}
safe("r111_extreme_maxi64", fn() { return extreme_lit(9223372036854775807); });
safe("r111_extreme_maxi32", fn() { return extreme_lit(2147483647); });
safe("r111_extreme_mini32", fn() { return extreme_lit(-2147483648); });
safe("r111_extreme_pi", fn() { return extreme_lit(3.14159265358979); });
safe("r111_extreme_other", fn() { return extreme_lit(42); });

# ============================================================
# T28: 重复 arm — 第一个匹配
# ============================================================
fn dup_arm(x) {
    return match x {
        5 => "first",
        5 => "second",
        5 => "third",
        _ => "other"
    };
}
safe("r111_dup_5", fn() { return dup_arm(5); });
safe("r111_dup_7", fn() { return dup_arm(7); });

# ============================================================
# T29: 类型绑定作用域 — 跨 arm 不应残留
# ============================================================
fn bind_scope(x) {
    let n = "outer-n";
    return match x {
        is int as n => "int-n=" + str(n),
        _ => "n=" + str(n)
    };
}
safe("r111_scope_int", fn() { return bind_scope(42); });
# _ arm 中 n 应为外层值 "outer-n"，不应残留 42
safe("r111_scope_other", fn() { return bind_scope("hi"); });

# 类型绑定 + guard 失败 — 绑定是否残留到下一个 arm
fn bind_scope_guard(x) {
    let n = "outer";
    return match x {
        is int as n if n > 100 => "big:" + str(n),
        is int as n => "int:" + str(n),
        _ => "n=" + str(n)
    };
}
safe("r111_scope_g_big", fn() { return bind_scope_guard(200); });
safe("r111_scope_g_int", fn() { return bind_scope_guard(50); });
safe("r111_scope_g_other", fn() { return bind_scope_guard("hi"); });

# ============================================================
# T30: match 返回 match (链式)
# ============================================================
fn chain_match(x) {
    return match x {
        1 => match x { 1 => "one-one", _ => "?" },
        2 => match x { 2 => "two-two", _ => "?" },
        _ => "other"
    };
}
safe("r111_chain_1", fn() { return chain_match(1); });
safe("r111_chain_2", fn() { return chain_match(2); });
safe("r111_chain_3", fn() { return chain_match(3); });

# ============================================================
# T31: chan 模式 — send/recv/close 边界
# ============================================================
fn chan_close_match() {
    let ch = chan_new(0);
    chan_close(ch);
    return match ch {
        chan close => "closed",
        _ => "other"
    };
}
safe("r111_chan_close", fn() { return chan_close_match(); });

fn chan_recv_match() {
    let ch = chan_new(2);
    chan_send(ch, "v1");
    return match ch {
        chan recv(v) => "recv:" + str(v),
        _ => "other"
    };
}
safe("r111_chan_recv", fn() { return chan_recv_match(); });

fn chan_send_match() {
    let ch = chan_new(2);
    return match ch {
        chan send(_) => "can-send",
        _ => "no-send"
    };
}
safe("r111_chan_send", fn() { return chan_send_match(); });

# 空 channel: recv 不匹配
fn chan_empty_recv() {
    let ch = chan_new(2);
    return match ch {
        chan recv(v) => "recv:" + str(v),
        _ => "no-recv"
    };
}
safe("r111_chan_empty", fn() { return chan_empty_recv(); });

# ============================================================
# T32: 类型模式 — list/dict 内容 (无解构)
# ============================================================
fn collection_match(x) {
    return match x {
        is list as l => "list:" + str(len(l)),
        is dict as d => "dict:" + str(len(d)),
        is str as s => "str:" + str(len(s)),
        _ => "other"
    };
}
safe("r111_coll_list", fn() { return collection_match([1, 2, 3]); });
safe("r111_coll_empty_list", fn() { return collection_match([]); });
safe("r111_coll_dict", fn() { return collection_match({"a": 1, "b": 2, "c": 3}); });
safe("r111_coll_empty_dict", fn() { return collection_match({}); });
safe("r111_coll_str", fn() { return collection_match("hello"); });
safe("r111_coll_empty_str", fn() { return collection_match(""); });
safe("r111_coll_int", fn() { return collection_match(42); });

# ============================================================
# T33: 顺序 — 字面量在 _ 之前才匹配；_ 在前总是命中
# ============================================================
fn wild_first(x) {
    return match x {
        _ => "wild",
        1 => "one"
    };
}
safe("r111_wf_1", fn() { return wild_first(1); });
safe("r111_wf_9", fn() { return wild_first(9); });

# 绑定在前
fn bind_first(x) {
    return match x {
        v => "bind:" + str(v),
        1 => "one"
    };
}
safe("r111_bf_1", fn() { return bind_first(1); });
safe("r111_bf_9", fn() { return bind_first(9); });

# ============================================================
# T34: match 在循环中 — break/continue 通过外部控制
# ============================================================
fn match_in_loop(xs) {
    let total = 0;
    for x in xs {
        let r = match x {
            0 => 0,            # 跳过
            n if n > 0 => n,   # 累加
            _ => 0             # 负数跳过
        };
        total = total + r;
    }
    return total;
}
safe("r111_loop_match", fn() { return match_in_loop([1, -2, 3, 0, 5]); });

# ============================================================
# T35: match 表达式语句 — 值被丢弃
# ============================================================
let stmt_ran = false;
match 5 { _ => 99 };
stmt_ran = true;
print("r111_stmt_discard:" + str(stmt_ran));

# 丢弃后不影响后续
let after = match 7 { 7 => 1, _ => 0 } + match 8 { 8 => 1, _ => 0 };
print("r111_two_matches:" + str(after));

print("=== r111 done ===");
