    return match x {
        is int as n => "int:" + str(n),
        is float as f => "float:" + str(f),
        _ => "other"
    };
}
safe("r111_ivf_3.0", fn() { return int_valued_float(3.0); });
safe("r111_ivf_3", fn() { return int_valued_float(3); });
safe("r111_ivf_3.14", fn() { return int_valued_float(3.14); });
