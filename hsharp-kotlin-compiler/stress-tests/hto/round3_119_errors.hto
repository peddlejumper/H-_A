# ============================================================
# T38: 错误消息一致性 — 同一错误在不同上下文
# ============================================================
print("== T38 same err different ctx ==");
let t38a = ""; let t38b = ""; let t38c = "";
try { let _t38 = undefined_same; } catch (e) { t38a = str(e); }
fn f38() { return undefined_same; }
try { f38(); } catch (e) { t38b = str(e); }
try {
    for i in range(3) {
        let _t38b = undefined_same;
    }
} catch (e) { t38c = str(e); }
print("T38.1 all equal? " + str(t38a == t38b and t38b == t38c));
print("T38.1 top=[" + t38a + "] fn=[" + t38b + "] loop=[" + t38c + "]");

# ============================================================
# T39: catch 块内 throw 后被外层捕获
# ============================================================
print("== T39 error chain messages ==");
try {
    try {
        throw "first-39";
    } catch (e) {
        print("T39.1 inner got: [" + str(e) + "]");
        throw "second-39: " + str(e);
    }
} catch (e2) {
    print("T39.2 outer got: [" + str(e2) + "]");
}
try {
    try {
        let v = 1 / 0;
    } catch (e) {
        print("T39.3 inner div0: [" + str(e) + "]");
        throw "wrapped: " + str(e);
    }
} catch (e2) {
    print("T39.4 outer wrapped: [" + str(e2) + "]");
}

# ============================================================
# T40: 异常 e 用作表达式
