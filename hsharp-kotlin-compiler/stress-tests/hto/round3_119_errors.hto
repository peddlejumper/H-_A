# ============================================================
# T44: super 调用错误
# ============================================================
print("== T44 super errors ==");
class Base44 {
    fn greet() { return "hi"; }
}
class Mid44 extends Base44 {
    fn greet() { return super.greet() + " from mid"; }
    fn bad() { return super.nonexistent_super(); }
}
let m44 = new Mid44();
try { r = str(m44.greet()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T44.1 super.greet() => " + r);
try { r = str(m44.bad()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T44.2 super.nonexistent_super() => " + r);

