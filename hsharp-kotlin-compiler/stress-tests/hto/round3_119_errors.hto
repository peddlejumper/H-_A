try { let v = 5 / 0; } catch (e) { t31b = str(e); }
try { let v = 100 / 0; } catch (e) { t31c = str(e); }
print("T31.1 div0 msgs equal? " + str(t31a == t31b and t31b == t31c));
print("T31.1 msg = [" + t31a + "]");

let t31d = ""; let t31e = "";
try { let v = [1,2,3][99]; } catch (e) { t31d = str(e); }
try { let v = [1,2,3][100]; } catch (e) { t31e = str(e); }
