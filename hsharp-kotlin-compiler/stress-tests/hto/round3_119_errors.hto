print("T31.2 msg1=[" + t31d + "]");
print("T31.2 msg2=[" + t31e + "]");

let t31f = ""; let t31g = "";
try { let _t31 = undefined_consistency; } catch (e) { t31f = str(e); }
try { let _t31b = undefined_consistency; } catch (e) { t31g = str(e); }
