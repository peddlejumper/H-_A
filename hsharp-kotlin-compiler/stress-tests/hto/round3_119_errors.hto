try { r = str(c42.missing_method()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T42.2 c42.missing_method() => " + r);
try { r = str(c42.method()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T42.3 c42.method() => " + r);
try { r = str(c42.x); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T42.4 c42.x => " + r);

