# ============================================================
# T30: 并发块中的错误
# ============================================================
print("== T30 concurrent block errors ==");
parallel fn fail30() { throw "from-parallel-30"; }
let t30r1 = "no-throw";
let t30r2 = "no-throw";
try {
    concurrent {
        let f = fail30();
        let rr = await f;
        t30r1 = "got: " + str(rr);
    }
} catch (e) {
    t30r1 = "EXC:[" + str(e) + "]";
}
print("T30.1 parallel throw => " + t30r1);

parallel fn fail30b() { return undefined_in_parallel_30; }
try {
    concurrent {
        let f = fail30b();
        let rr = await f;
        t30r2 = "got: " + str(rr);
    }
} catch (e) {
    t30r2 = "EXC:[" + str(e) + "]";
}
print("T30.2 parallel undefined => " + t30r2);

