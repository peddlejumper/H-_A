# ============================================================
# Round 3 / Agent #119 — 错误消息质量与一致性测试
# H# v0.4.1
#
# 目标：系统性探测 H# 运行时与编译器产生的错误消息：
#   - 消息文本是否准确/有用
#   - 消息是否包含行号、文件名、调用栈
#   - 相同错误是否产生相同消息（一致性）
#   - JVM 异常消息是否泄露到 H# 层
#   - catch 变量 e 的内容与格式
#   - 编译错误 vs 运行时错误的区分
#   - 退出码 / panic vs error
#
# 已知约束：
#   - H# 无 finally；catch (e) 必填
#   - throw 是语句，不是表达式
#   - HSharpException(value) 携带 throw 的值；HSharpRuntimeError(msg) 转 HString(msg)
#   - RuntimeException 在主循环被捕获并转 HString(ex.message)
#
# 重要发现（已在单独探针中确认 — 见 _probe119b/c.hto）：
#   - 把 inline lambda 作为参数传给函数，lambda 内抛出的异常
#     不会被接收函数的 try/catch 捕获，而是逃逸到顶层。
#     命名函数则正常被捕获。
#     => 本测试文件因此不使用 `probe(label, fn(){...})` 模式，
#        改为每个用例直接用 try/catch。
# ============================================================

print("===== R3-119 START =====");

# ============================================================
# T01: 未定义变量
# ============================================================
print("== T01 undefined var ==");
let r = "no-throw";
try { r = str(undefined_var); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T01.1 undefined_var => " + r);
try { r = str(_nope_42); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T01.2 _nope_42 => " + r);
try { r = str(undefined_x + 1); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T01.3 undefined_x+1 => " + r);

# ============================================================
# T02: 未定义函数
# ============================================================
print("== T02 undefined fn ==");
try { r = str(undefined_fn()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T02.1 undefined_fn() => " + r);
try { r = str(call_undefined_42()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T02.2 call_undefined_42() => " + r);

# ============================================================
# T03: 类型错误 — 1 + null / "x" + 1
# H# binAdd 把 null 当 0.0、数字当字符串拼接 — 可能不报错
# ============================================================
print("== T03 type errors (arith/concat) ==");
try { r = str(1 + null); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.1 1+null => " + r);
try { r = str(null + 1); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.2 null+1 => " + r);
try { r = str("x" + 1); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.3 'x'+1 => " + r);
try { r = str(1 + "x"); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.4 1+'x' => " + r);
try { r = str([] + 1); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.5 []+1 => " + r);
try { r = str(1 + []); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.6 1+[] => " + r);
try { r = str({} + 1); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.7 {}+1 => " + r);
try { r = str(null + null); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.8 null+null => " + r);
try { r = str(true + false); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T03.9 true+false => " + r);

# ============================================================
# T04: 索引越界
# ============================================================
print("== T04 index out of range ==");
try { r = str([1,2,3][10]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T04.1 [1,2,3][10] => " + r);
try { r = str([1,2,3][-1]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T04.2 [1,2,3][-1] => " + r);
try { r = str([1,2,3][-10]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T04.3 [1,2,3][-10] => " + r);
try { r = str("abc"[10]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T04.4 'abc'[10] => " + r);
try { r = str([1,2,3][0]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T04.5 [1,2,3][0] => " + r);

# ============================================================
# T05: 空列表 pop
# ============================================================
print("== T05 empty list pop ==");
try { let x = []; r = str(x.pop()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T05.1 [].pop() => " + r);
try { let x = [1]; x.pop(); r = str(x.pop()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T05.2 [1].pop() twice => " + r);

