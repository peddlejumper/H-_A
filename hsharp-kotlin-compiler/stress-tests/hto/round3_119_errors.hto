print("T06.1 {'a':1}['b'] => " + r);
try { r = str({}["x"]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T06.2 {}['x'] => " + r);
try { r = str({"a":1}["a"]); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T06.3 {'a':1}['a'] => " + r);

# ============================================================
# T07: 除以零
# ============================================================
print("== T07 div by zero ==");
