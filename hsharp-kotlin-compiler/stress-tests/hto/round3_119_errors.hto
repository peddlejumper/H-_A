print("== T40 e as expression ==");
try {
    let v = 1 / 0;
} catch (e) {
    print("T40.1 e + '!' = [" + str(e) + "!]");
    print("T40.2 e == 'division by zero'? " + str(e == "division by zero"));
    print("T40.3 e type = " + type(e));
    let t40b = "no-throw";
    try { t40b = str(e + 1); } catch (e2) { t40b = "ERR:[" + str(e2) + "]"; }
    print("T40.4 e + 1 = " + t40b);
}

