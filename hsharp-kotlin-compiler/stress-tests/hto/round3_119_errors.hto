# ============================================================
# T60: catch 中再调用会 throw 的函数
# ============================================================
print("== T60 catch calls throwing fn ==");
fn innerThrow60() { throw "from-inner-60"; }
try {
    try {
        throw "outer-60";
    } catch (e) {
        print("T60.1 outer caught: [" + str(e) + "]");
        innerThrow60();
    }
} catch (e2) {
    print("T60.2 final caught: [" + str(e2) + "]");
}

