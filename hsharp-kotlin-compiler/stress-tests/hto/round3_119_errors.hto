# T09: 调用非函数
# ============================================================
print("== T09 call non-function ==");
try { let x = 5; r = str(x()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T09.1 (5)() => " + r);
try { let x = "s"; r = str(x()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T09.2 ('s')() => " + r);
try { let x = []; r = str(x()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T09.3 ([])() => " + r);
try { let x = {}; r = str(x()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T09.4 ({})() => " + r);
try { let x = null; r = str(x()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T09.5 (null)() => " + r);

