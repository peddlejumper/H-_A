print("T07.1 1/0 => " + r);
try { r = str(0 / 0); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T07.2 0/0 => " + r);
try { r = str(1.5 / 0); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T07.3 1.5/0 => " + r);
try { r = str(1 / 0.0); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T07.4 1/0.0 => " + r);
try { r = str(1 % 0); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T07.5 1%0 => " + r);
try { r = str(1 % 0.0); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T07.6 1%0.0 => " + r);

# ============================================================
# T08: 参数数量不匹配
# ============================================================
print("== T08 arity mismatch ==");
fn two_args(a, b) { return a + b; }
try { r = str(two_args(1)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T08.1 two_args(1) => " + r);
