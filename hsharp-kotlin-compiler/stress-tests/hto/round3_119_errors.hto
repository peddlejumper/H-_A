# ============================================================
# T12: channel 操作错误
# ============================================================
print("== T12 channel errors ==");
try {
    let ch = chan_new(2);
    chan_close(ch);
    r = str(chan_send(ch, 1));
} catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T12.1 send on closed => " + r);
try {
    let ch = chan_new(2);
    chan_send(ch, 1);
    chan_close(ch);
    chan_recv(ch);
    r = str(chan_recv(ch));
} catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T12.2 recv on drained closed => " + r);
try { r = str(chan_send(5, 1)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T12.3 chan_send on non-channel => " + r);
try { r = str(chan_recv(5)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T12.4 chan_recv on non-channel => " + r);
try { r = str(chan_close(5)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T12.5 chan_close on non-channel => " + r);

