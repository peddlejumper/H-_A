# ============================================================
# T33: 堆栈跟踪
# ============================================================
print("== T33 stack trace ==");
fn deep_a() { return deep_b(); }
fn deep_b() { return deep_c(); }
fn deep_c() { return undefined_deep_33; }
try {
    deep_a();
} catch (e) {
    print("T33.1 deep e = [" + str(e) + "]");
}

