# ============================================================
# T18: 嵌套调用栈 A→B→C→error
# ============================================================
print("== T18 nested call stack ==");
fn leaf18() { throw "boom-from-leaf18"; }
fn mid18() { return leaf18(); }
fn top18() { return mid18(); }
try { top18(); r = "ok"; } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T18.1 nested throw => " + r);
fn leaf18b() { return undefined_x18; }
fn mid18b() { return leaf18b(); }
fn top18b() { return mid18b(); }
try { r = str(top18b()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T18.2 nested undefined => " + r);
fn d18a() { return d18b(); }
fn d18b() { return d18c(); }
fn d18c() { return d18d(); }
fn d18d() { return d18e(); }
fn d18e() { return undefined_deep18; }
try { r = str(d18a()); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T18.3 5-deep undefined => " + r);

# ============================================================
# T19: catch 变量内容 / 格式
# ============================================================
print("== T19 catch var format ==");
try { throw "string-err"; } catch (e) { print("T19.1 str: [" + str(e) + "] type=" + type(e)); }
try { throw 42; } catch (e) { print("T19.2 num: [" + str(e) + "] type=" + type(e)); }
try { throw 3.14; } catch (e) { print("T19.3 float: [" + str(e) + "] type=" + type(e)); }
try { throw true; } catch (e) { print("T19.4 bool: [" + str(e) + "] type=" + type(e)); }
try { throw null; } catch (e) { print("T19.5 null: [" + str(e) + "] type=" + type(e)); }
try { throw [1,2,3]; } catch (e) { print("T19.6 list: [" + str(e) + "] type=" + type(e)); }
try { throw {"k":"v"}; } catch (e) { print("T19.7 dict: [" + str(e) + "] type=" + type(e)); }

# ============================================================
# T20: throw 字符串 vs 数字 vs 对象 — catch 中 e 的类型保留
# ============================================================
print("== T20 throw types vs runtime errors ==");
try { throw 42; } catch (e) {
    print("T20.1 throw 42 — e==42? " + str(e == 42) + " e+1=" + str(e + 1));
}
try { throw "msg"; } catch (e) {
    print("T20.2 throw 'msg' — e=='msg'? " + str(e == "msg"));
}
try { let v = 1 / 0; } catch (e) {
    print("T20.3 div0 — type=" + type(e) + " e==42? " + str(e == 42) + " e+1=" + str(e + 1));
}
try { let _t20 = undefined_xyz; } catch (e) {
    print("T20.4 undefined — type=" + type(e) + " msg=[" + str(e) + "]");
}

