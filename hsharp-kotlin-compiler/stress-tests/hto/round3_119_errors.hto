print("T13.3 float('xyz') => " + r);
try { r = str(abs("notnum")); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.4 abs('notnum') => " + r);
try { r = str(len(42)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.5 len(42) => " + r);
try { r = str(len(true)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.6 len(true) => " + r);
try { r = str(len(null)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.7 len(null) => " + r);
try { r = str(sqrt("x")); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.8 sqrt('x') => " + r);
try { let x = [1,2]; r = str(x.remove(99)); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.9 [1,2].remove(99) => " + r);
try { r = str(range("a", "b")); } catch (e) { r = "EXC:[" + str(e) + "]"; }
print("T13.10 range('a','b') => " + r);

