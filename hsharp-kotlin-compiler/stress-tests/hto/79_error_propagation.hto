    print(fmt("T79-11b: {0}", n11?[0]));
} catch (e) {
    print(fmt("T79-11b ERR: {0}", e));
}

# ============================================================
# T79-12: a?.b?.c 链式 (null 短路?)
# EXPECT(任务描述): null（链中任一为 null 即短路）
# EXPECT(源码设计): o12?.inner?.v = ((o12.inner)?.v)?；o12.inner=null，
#              访问 null.v 抛异常，? 捕获 → "Cannot load attribute on NULL"
# ACTUAL: 验证链式 ?. 行为
# ============================================================
class Inner12 { let v = 99; }
class Outer12 { let inner = null; }
let o12 = new Outer12();
try {
    print(fmt("T79-12: {0}", o12?.inner?.v));
} catch (e) {
    print(fmt("T79-12 ERR: {0}", e));
}
