print("=== T77 stdlib assert & test API ===");
t77_01_assert_eq_passes();
t77_02_assert_eq_int_float();
t77_03_assert_eq_type_mismatch();
t77_04_assert_eq_message();
t77_05_assert_ne();
t77_06_assert_true_false();
t77_07_assert_comparisons();
t77_08_assert_in_pass();
t77_09_assert_in_edge();
t77_10_assert_raises();
t77_11_assert_almost_eq();
