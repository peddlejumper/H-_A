# ============================================================
# round4_137_stdlib.hto — 标准库边界条件测试
# 智能体 #137, Round 4
# 目标: 对所有内置函数传入空、null、错误类型参数，探测边界行为
# 方法: 每个用例用 try/catch 包裹，打印 [S## TAG | observed | EXPECT=expected | PASS/FAIL]
# ============================================================

let stats = [0, 0];
fn report(tag, observed, expected) {
    let ok = observed == expected;
    if (ok) {
        stats[0] = stats[0] + 1;
    } else {
        stats[1] = stats[1] + 1;
    }
    let status = "FAIL";
    if (ok) { status = "PASS"; }
    print("S" + tag + " | " + str(observed) + " | EXPECT=" + str(expected) + " | " + status);
}

# 辅助：执行可能抛异常的表达式，返回 "OK:<val>" 或 "ERR:<msg>"
fn probe(expr_fn) {
    let r = "no-run";
    try {
        r = "OK:" + str(expr_fn());
    } catch (e) {
        r = "ERR:[" + str(e) + "]";
    }
    return r;
}

print("===== R4-137 STDLIB BOUNDARY START =====");

# ============================================================
# S1: len() 边界
#   len(""), len([]), len({}), len(null), len(42), len(true), len("中")
# ============================================================
print("== S1: len() boundary ==");

report("1.01-len-empty-str", len(""), 0);
report("1.02-len-empty-list", len([]), 0);
report("1.03-len-empty-dict", len({}), 0);
report("1.04-len-unicode", len("中"), 1);
report("1.05-len-unicode-multi", len("中文a"), 3);

# len(null) — 应抛异常
let s1a = "no-err";
try { s1a = "got:" + str(len(null)); } catch (e) { s1a = "ERR:[" + str(e) + "]"; }
report("1.06-len-null", s1a, "ERR");

# len(42) — 应抛异常
let s1b = "no-err";
try { s1b = "got:" + str(len(42)); } catch (e) { s1b = "ERR:[" + str(e) + "]"; }
report("1.07-len-int", s1b, "ERR");

# len(true) — 应抛异常
let s1c = "no-err";
try { s1c = "got:" + str(len(true)); } catch (e) { s1c = "ERR:[" + str(e) + "]"; }
report("1.08-len-bool", s1c, "ERR");

# len() 无参数 — 应抛异常
let s1d = "no-err";
try { s1d = "got:" + str(len()); } catch (e) { s1d = "ERR:[" + str(e) + "]"; }
report("1.09-len-no-args", s1d, "ERR");

# len 过多参数
let s1e = "no-err";
try { s1e = "got:" + str(len([1], [2])); } catch (e) { s1e = "ERR:[" + str(e) + "]"; }
report("1.10-len-too-many", s1e, "ERR");

# ============================================================
# S2: abs() 边界
#   abs(-5), abs(0), abs(3.14), abs(-3.14), abs("str"), abs(null), abs([])
# ============================================================
print("== S2: abs() boundary ==");

report("2.01-abs-neg-int", abs(-5), 5);
report("2.02-abs-zero", abs(0), 0);
report("2.03-abs-float", abs(3.14), 3.14);
report("2.04-abs-neg-float", abs(-3.14), 3.14);

# abs("str") — 应抛异常
let s2a = "no-err";
try { s2a = "got:" + str(abs("str")); } catch (e) { s2a = "ERR:[" + str(e) + "]"; }
report("2.05-abs-string", s2a, "ERR");

# abs(null) — toDouble(HNull)=0.0, 可能返回 0 而非报错 (潜在 bug)
let s2b = "no-err";
try { s2b = "got:" + str(abs(null)); } catch (e) { s2b = "ERR:[" + str(e) + "]"; }
report("2.06-abs-null", s2b, "ERR");

# abs([]) — 应抛异常
let s2c = "no-err";
try { s2c = "got:" + str(abs([])); } catch (e) { s2c = "ERR:[" + str(e) + "]"; }
report("2.07-abs-list", s2c, "ERR");

# abs(true) — toDouble(HBool)=1.0, 可能返回 1 (类型混淆)
let s2d = "no-err";
try { s2d = "got:" + str(abs(true)); } catch (e) { s2d = "ERR:[" + str(e) + "]"; }
report("2.08-abs-bool", s2d, "ERR");

# abs 无参数
let s2e = "no-err";
try { s2e = "got:" + str(abs()); } catch (e) { s2e = "ERR:[" + str(e) + "]"; }
report("2.09-abs-no-args", s2e, "ERR");

# ============================================================
# S3: ord()/chr() 边界
#   ord(""), ord("ab"), ord(null), chr(-1), chr(0), chr(1114112), chr(0xD800)
# ============================================================
print("== S3: ord()/chr() boundary ==");

report("3.01-ord-A", ord("A"), 65);
report("3.02-ord-chinese", ord("中"), 20013);

# ord("") — 应抛异常
let s3a = "no-err";
try { s3a = "got:" + str(ord("")); } catch (e) { s3a = "ERR:[" + str(e) + "]"; }
report("3.03-ord-empty", s3a, "ERR");

# ord("ab") — 应抛异常 (多字符)
let s3b = "no-err";
try { s3b = "got:" + str(ord("ab")); } catch (e) { s3b = "ERR:[" + str(e) + "]"; }
report("3.04-ord-multi-char", s3b, "ERR");

# ord(null) — null 被转为 "null" 字符串，报误导性错误
let s3c = "no-err";
try { s3c = "got:" + str(ord(null)); } catch (e) { s3c = "ERR:[" + str(e) + "]"; }
report("3.05-ord-null", s3c, "ERR");

# chr(-1) — 应抛异常
let s3d = "no-err";
try { s3d = "got:" + str(chr(-1)); } catch (e) { s3d = "ERR:[" + str(e) + "]"; }
report("3.06-chr-neg", s3d, "ERR");

# chr(0) — 应返回 null 字符
let s3e = "no-err";
try { s3e = "got:" + str(ord(chr(0))); } catch (e) { s3e = "ERR:[" + str(e) + "]"; }
report("3.07-chr-zero-roundtrip", s3e, "got:0");

# chr(1114112) — 超出 Unicode 范围 (0x10FFFF=1114111)
let s3f = "no-err";
try { s3f = "got:" + str(chr(1114112)); } catch (e) { s3f = "ERR:[" + str(e) + "]"; }
report("3.08-chr-too-big", s3f, "ERR");

# chr(55296) — surrogate 范围 (0xD800=55296)
let s3g = "no-err";
try { s3g = "got:" + str(chr(55296)); } catch (e) { s3g = "ERR:[" + str(e) + "]"; }
report("3.09-chr-surrogate", s3g, "ERR");

# chr 无参数
let s3h = "no-err";
try { s3h = "got:" + str(chr()); } catch (e) { s3h = "ERR:[" + str(e) + "]"; }
report("3.10-chr-no-args", s3h, "ERR");

# ============================================================
# S4: int()/float()/str()/bool() 边界
