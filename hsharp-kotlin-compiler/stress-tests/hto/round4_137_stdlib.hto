# ============================================================
# S10: type() 边界
#   type(null), type(chan_new(0)), type(range(0,3)), type(type)
#   注: type(print) 无法测试 — print 是语句关键字，非表达式
# ============================================================
print("== S10: type() boundary ==");

report("10.01-type-null", type(null), "null");
report("10.02-type-int", type(42), "number");
report("10.03-type-string", type("a"), "string");
report("10.04-type-list", type([]), "list");
report("10.05-type-dict", type({}), "dict");
report("10.06-type-bool", type(true), "bool");
report("10.07-type-range", type(range(0, 3)), "list");

# type(chan_new(0)) — channel
report("10.08-type-channel", type(chan_new(0)), "channel");

# type(type) — 内建函数
report("10.09-type-builtin", type(type), "native");

# type(len) — 内建函数
report("10.10-type-len-builtin", type(len), "native");

# type 用户函数
fn my_fn() { return 1; }
report("10.11-type-user-fn", type(my_fn), "function");

# type() 无参数
let s10a = "no-err";
try { s10a = "got:" + str(type()); } catch (e) { s10a = "ERR:[" + str(e) + "]"; }
report("10.12-type-no-args", s10a, "ERR");

# type 过多参数
let s10b = "no-err";
try { s10b = "got:" + str(type(1, 2)); } catch (e) { s10b = "ERR:[" + str(e) + "]"; }
report("10.13-type-too-many", s10b, "ERR");

# ============================================================
# 汇总
