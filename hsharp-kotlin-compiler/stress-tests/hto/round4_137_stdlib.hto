let s8e = "no-err";
try { s8e = "got:" + str(max()); } catch (e) { s8e = "ERR:[" + str(e) + "]"; }
report("8.09-max-no-args", s8e, "ERR");

# min 多参数
let s8f = "no-err";
try { s8f = "got:" + str(min(3, 1, 2)); } catch (e) { s8f = "ERR:[" + str(e) + "]"; }
report("8.10-min-multiarg", s8f, "got:1");

