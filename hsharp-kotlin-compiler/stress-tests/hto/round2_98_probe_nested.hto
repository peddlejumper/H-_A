# Probe for nested destructure pattern — item 11 of the test domain.
# `let [[a, b], [c, d]] = [[1, 2], [3, 4]];` is documented as
# potentially unsupported.  The H# parser's `_destructure_slot` only
# accepts IDENTIFIER or `_`, so an inner `[` should raise a
# compile-time SyntaxError.
#
# Expected: COMPILE ERROR.  This probe exists only to confirm that.

let [[a, b], [c, d]] = [[1, 2], [3, 4]];
print(a);
print(b);
print(c);
print(d);
