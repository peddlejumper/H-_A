# ============================================================
# T17: 返回函数的函数返回函数 — 3 层 (let-lambda 形式)
# fn gen() { return fn() { return fn() { return 42; }; }; }
# 预期: 42, 100, x
# ============================================================
print("=== T17 3-level return chain ===");
try {
    fn gen() {
        let mid = fn() {
            let inner = fn() { return 42; };
            return inner;
        };
        return mid;
    }
    print("T17: " + gen()()());          # 42
    fn step1(x) {
        let step2 = fn(y) {
            let step3 = fn(z) { return x + y + z; };
            return step3;
        };
        return step2;
    }
    print("T17: " + step1(1)(2)(3));     # 6
    print("T17: " + step1(10)(20)(30));  # 60
} catch (e) { print("T17-ERR: " + e); }

# T17b: 3 层 fn 语句形式 (对照 — 已知 bug)
print("=== T17b 3-level fn stmt ===");
try {
    fn genB() {
        fn mid() {
            fn inner() { return 42; }
            return inner;
        }
        return mid;
    }
    print("T17b: " + genB()()());        # 42 if works
} catch (e) { print("T17b-ERR: " + e); }

# ============================================================
# T18: 闭包捕获 + 高阶 — counter 经 HOF 传递
# fn mk() { let n=0; fn inc() { n=n+1; return n; } return inc; }
# 通过 HOF 包装. 预期: 1, 2, 3
# ============================================================
print("=== T18 closure + HOF ===");
try {
    fn mkCounter() {
        let n = 0;
        let inc = fn() { n = n + 1; return n; };
        return inc;
    }
    let c = mkCounter();
    # 通过 HOF 传递闭包
    fn apply0(f) { return f(); }
    print("T18: " + apply0(c));     # 1
    print("T18: " + apply0(c));     # 2
    print("T18: " + apply0(c));     # 3
} catch (e) { print("T18-ERR: " + e); }

# ============================================================
# T19: 高阶 + try/catch — 回调中抛异常, HOF 捕获
# 预期: caught-boom, 42, recovered
# ============================================================
print("=== T19 HOF + try/catch ===");
try {
    fn safeCall(f, x) {
        try { return f(x); }
        catch (e) { return "caught-" + e; }
    }
    print("T19: " + safeCall(fn(x) { throw "boom"; }, 1));    # caught-boom
    print("T19: " + safeCall(fn(x) { return x * 6; }, 7));    # 42
    # 回调内 try/catch 自处理
    fn callWithFallback(f, x) {
        let r = f(x);
        return r;
    }
    fn risky(x) {
        try { if (x < 0) { throw "neg"; } return x; }
        catch (e) { return "recovered"; }
    }
    print("T19: " + callWithFallback(risky, -5));   # recovered
    print("T19: " + callWithFallback(risky, 5));    # 5
} catch (e) { print("T19-ERR: " + e); }

# ============================================================
# T20: 高阶 + 类型检查 — f is Function
# 预期 (修复): true ; 实际 (bug): false
# ============================================================
print("=== T20 HOF + type check ===");
try {
    fn apply(f, x) {
        if (f is Function) { return f(x); }
        return "not-fn";
    }
    fn g(x) { return x + 1; }
    print("T20: " + apply(g, 5));                # 6 (if is works) ; not-fn (bug)
    print("T20: " + apply(fn(x) { return x * 2; }, 5));  # 10 (if is works) ; not-fn (bug)
    print("T20: " + apply(42, 5));               # not-fn
    print("T20 type: " + type(g));               # function
    print("T20 type: " + type(42));              # number
} catch (e) { print("T20-ERR: " + e); }

# ============================================================
# T21: 可变参数高阶 — fn apply_all(f, ...args)
# 注意: f(...args) spread 调用已知解析错误, 用显式索引或固定 arity
# 预期: 6, 10, wrapped-3
# ============================================================
print("=== T21 variadic HOF ===");
try {
    # 变参收集 OK
    fn applyAll(f, ...args) {
        let r = [];
        for a in args { push(r, f(a)); }
        return r;
    }
    print("T21: " + applyAll(sq, 1, 2, 3));    # [1, 4, 9]
    print("T21: " + applyAll(double, 1, 2, 3, 4));  # [2, 4, 6, 8]
    # f(...args) 形式 — 测试是否支持 (预期: 可能 ERR)
    fn spreadCall(f, ...args) {
        return f(args[0], args[1], args[2]);
    }
    fn sum3(a, b, c) { return a + b + c; }
    print("T21: " + spreadCall(sum3, 1, 2, 3));  # 6
} catch (e) { print("T21-ERR: " + e); }

# T21b: spread 调用 f(...args) — 语法不支持 (解析错误, 无法编译)
# 注: sum3(...args) 会导致 SyntaxError: Unexpected token ELLIPSIS
# 此处无法用 try/catch 捕获 (解析阶段错误, 中止整个编译)
# 已在 T21 中用 f(args[0], args[1], args[2]) 显式索引绕过
print("=== T21b spread call (unsupported) ===");
try {
    fn sum3(a, b, c) { return a + b + c; }
    let args = [1, 2, 3];
    # spread 调用 sum3(...args) 不支持, 用显式索引
    print("T21b: " + sum3(args[0], args[1], args[2]));     # 6
    # apply 间接调用也不支持 spread
    fn callWithList(f, args) {
        return f(args[0], args[1], args[2]);
    }
    print("T21b: " + callWithList(sum3, [4, 5, 6]));       # 15
} catch (e) { print("T21b-ERR: " + e); }

# ============================================================
# T22: 函数相等 — f == g 引用相等
# 预期: true, false, true
# ============================================================
print("=== T22 fn equality ===");
try {
    fn f() { return 1; }
    fn g() { return 1; }
    let h = f;
    print("T22 f==f: " + (f == f));     # true
    print("T22 f==g: " + (f == g));     # false (不同函数)
    print("T22 f==h: " + (f == h));     # true (同引用)
    # lambda 相等 (每次创建新实例)
    let l1 = fn() { return 1; };
    let l2 = fn() { return 1; };
    let l3 = l1;
    print("T22 l1==l1: " + (l1 == l1));  # true
    print("T22 l1==l2: " + (l1 == l2));  # false
    print("T22 l1==l3: " + (l1 == l3));  # true
    # 顶层 fn 作 dict 值后再取, 是否同引用
    let d = {"f": f};
    print("T22 f==d[f]: " + (f == d["f"]));  # true
} catch (e) { print("T22-ERR: " + e); }

