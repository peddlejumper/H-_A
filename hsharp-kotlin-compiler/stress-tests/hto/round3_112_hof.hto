# T46: 函数记忆化 (memoize) 缓存命中验证
print("=== T46 memoize hit count ===");
try {
    fn slow(x) { return x * x; }
    fn memoize(f) {
        let cache = {};
        let calls = 0;
        let wrapped = fn(n) {
            let key = "" + n;
            if (has_key(cache, key)) { return cache[key]; }
            calls = calls + 1;
            let v = f(n);
            cache[key] = v;
            return v;
        };
        let getCalls = fn() { return calls; };
        return [wrapped, getCalls];
    }
    let p = memoize(slow);
    let mf = p[0];
    let getCalls = p[1];
    mf(3); mf(3); mf(3); mf(4); mf(4); mf(5);
    # 3 个不同 key (3,4,5) → 3 次实际调用 (若 count 共享)
    print("T46: calls=" + getCalls());   # 3 (by-ref) or 0 (snapshot)
} catch (e) { print("T46-ERR: " + e); }

# T47: 回调注册后注销
print("=== T47 callback unregister ===");
try {
    let cbs = [];
    fn register(cb) { push(cbs, cb); return len(cbs); }
    fn unregister(cb) {
        let idx = -1;
        let i = 0;
        while (i < len(cbs)) {
            if (cbs[i] == cb) { idx = i; }
            i = i + 1;
        }
        if (idx >= 0) {
            # 移除: 把后面的前移
            let j = idx;
            while (j < len(cbs) - 1) { cbs[j] = cbs[j + 1]; j = j + 1; }
            pop(cbs);
        }
        return len(cbs);
    }
    fn fireAll(x) {
        let results = [];
        for cb in cbs { push(results, cb(x)); }
        return results;
    }
    let cb1 = fn(x) { return "cb1-" + x; };
    let cb2 = fn(x) { return "cb2-" + x; };
    register(cb1);
    register(cb2);
    print("T47: " + fireAll("a"));       # [cb1-a, cb2-a]
    print("T47: after-unreg=" + unregister(cb1));   # 1
    print("T47: " + fireAll("b"));       # [cb2-b]
} catch (e) { print("T47-ERR: " + e); }

# T48: 高阶函数 + list 方法 (sort 内置比较器?)
print("=== T48 sort with HOF ===");
try {
    # 自写排序 (内置 sort 未必支持比较器)
    fn sortWith(arr, cmp) {
        let a = arr;
        let n = len(a);
        for i in range(0, n) {
            for j in range(0, n - 1) {
                if (cmp(a[j], a[j + 1]) > 0) {
                    let t = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = t;
                }
            }
        }
        return a;
    }
    let data = [3, 1, 4, 1, 5, 9, 2, 6];
    print("T48: " + sortWith(data, fn(x, y) { return x - y; }));  # [1, 1, 2, 3, 4, 5, 6, 9]
    # 按字符串长度排序
    let strs = ["bbb", "a", "cc", "dddd"];
    print("T48: " + sortWith(strs, fn(x, y) { return len(x) - len(y); }));  # [a, cc, bbb, dddd]
} catch (e) { print("T48-ERR: " + e); }

# T49: HOF + 闭包计数器 (increment 然后 HOF 包装)
print("=== T49 HOF wraps counter ===");
try {
    fn mkCounter() {
        let n = 0;
        let next = fn() { n = n + 1; return n; };
        return next;
    }
    let counter = mkCounter();
    fn repeat(f, times) {
        let r = [];
        let i = 0;
        while (i < times) { push(r, f()); i = i + 1; }
        return r;
    }
    print("T49: " + repeat(counter, 5));   # [1, 2, 3, 4, 5]
} catch (e) { print("T49-ERR: " + e); }

# T50: 深度嵌套 HOF — 5 层组合
print("=== T50 deep HOF nesting ===");
try {
    fn compose(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    # 5 层: inc(double(inc(double(inc(x)))))
    let c1 = compose(inc, double);
    let c2 = compose(c1, inc);
    let c3 = compose(c2, double);
    let c4 = compose(c3, inc);
    # x=0: inc=1, double=2, inc=3, double=6, inc=7
    print("T50: " + c4(0));     # 7
    # x=1: inc=2, double=4, inc=5, double=10, inc=11
    print("T50: " + c4(1));     # 11
} catch (e) { print("T50-ERR: " + e); }

print("=== ALL DONE ===");
