# round3_112_hof.hto — 测试智能体 #112
# 领域: 高阶函数与回调模式 (Higher-Order Functions & Callback Patterns)
# H# v0.4.1
#
# 已知背景 (来自 round3_110 / 73 / 22):
#   - lambda 内调用顶层函数: 已知 P0 bug (本测试验证当前状态)
#   - 3 层嵌套 fn 语句 (outer→mid→inner) 引用最外层变量: "Undefined name" bug
#   - let-lambda 递归 (fact/fib): "Undefined name" bug
#   - 闭包 snapshot bug: 多闭包共享变量 / 捕获后外部修改 → 返回旧值
#   - spread 调用 f(...args): 解析错误
#
# 测试方法:
#   - 每个用例独立 try/catch 包裹, 打印 "Txx:" 前缀, 预期值在注释
#   - 需调用其他函数的回调, 优先用顶层 fn 语句按名传递 (规避 P0 bug)
#   - 同时测试已知 bug 场景以记录当前状态
#   - 28 个模式覆盖任务列表全部条目

# ============================================================
# 顶层辅助函数 (供回调按名传递使用, 规避 lambda-calls-toplevel bug)
# ============================================================
fn double(x) { return x * 2; }
fn inc(x) { return x + 1; }
fn sq(x) { return x * x; }
fn addTop(a, b) { return a + b; }
fn subTop(a, b) { return a - b; }
fn isEven(n) { return n % 2 == 0; }

# ============================================================
# T01: 函数作为参数 — apply(f, x)
# 用顶层 fn 按名传递. 预期: 10, hi!, 49
# ============================================================
print("=== T01 fn as arg ===");
try {
    fn apply(f, x) { return f(x); }
    print("T01: " + apply(double, 5));        # 10
    print("T01: " + apply(fn(s) { return s + "!"; }, "hi"));   # hi!
    print("T01: " + apply(sq, 7));             # 49
} catch (e) { print("T01-ERR: " + e); }

# T01b: lambda 调用顶层 fn (P0 bug 验证)
# 预期 (修复后): 11 ; 实际 (bug): ERR
print("=== T01b lambda calls toplevel ===");
try {
    fn topLevel1(x) { return x + 1; }
    let f = fn(x) { return topLevel1(x); };
    print("T01b: " + f(10));                    # 11
} catch (e) { print("T01b-ERR: " + e); }

# T01c: lambda 作为回调调用顶层 fn (P0 bug 验证 — 回调场景)
print("=== T01c lambda cb calls toplevel ===");
try {
    fn apply(f, x) { return f(x); }
    fn topLevel1c(x) { return x * 3; }
    print("T01c: " + apply(fn(x) { return topLevel1c(x); }, 5));  # 15
} catch (e) { print("T01c-ERR: " + e); }

# ============================================================
# T02: 函数作为返回值 — mkAdder (嵌套 fn 语句, 2 层)
# 任务示例: fn mkAdder(n) { fn add(x) { return x + n; } return add; }
# 预期: 7, 13, 25
# ============================================================
print("=== T02 fn as return (fn stmt) ===");
try {
    fn mkAdder(n) {
        fn add(x) { return x + n; }
        return add;
    }
    let add5 = mkAdder(5);
    print("T02: " + add5(2));     # 7
    print("T02: " + add5(8));     # 13
    let add20 = mkAdder(20);
    print("T02: " + add20(5));    # 25
} catch (e) { print("T02-ERR: " + e); }

# T02b: 函数作为返回值 — let-lambda 形式 (对照)
print("=== T02b fn as return (let-lambda) ===");
try {
    fn mkAdderB(n) {
        let add = fn(x) { return x + n; };
        return add;
    }
    let add5 = mkAdderB(5);
    print("T02b: " + add5(2));    # 7
    print("T02b: " + add5(8));    # 13
} catch (e) { print("T02b-ERR: " + e); }

# ============================================================
# T03: 柯里化 (3 层嵌套) — fn 语句形式
# 任务示例: fn curry3(a) { fn mid(b) { fn inner(c) { return a + b + c; } return inner; } return mid; }
# 已知 bug: 3 层嵌套 fn 语句引用最外层变量 → "Undefined name"
# 预期 (修复): 6, 60 ; 实际 (bug): ERR
# ============================================================
print("=== T03 currying (fn stmt, 3-level) ===");
try {
    fn curry3(a) {
        fn mid(b) {
            fn inner(c) { return a + b + c; }
            return inner;
        }
        return mid;
    }
    print("T03: " + curry3(1)(2)(3));      # 6
    print("T03: " + curry3(10)(20)(30));   # 60
} catch (e) { print("T03-ERR: " + e); }

# T03b: 柯里化 — let-lambda 形式 (已知可工作)
# 预期: 6, 60, 1000
print("=== T03b currying (let-lambda) ===");
try {
    fn curry3b(a) {
        let mid = fn(b) {
            let inner = fn(c) { return a + b + c; };
            return inner;
        };
        return mid;
    }
    print("T03b: " + curry3b(1)(2)(3));        # 6
    print("T03b: " + curry3b(10)(20)(30));     # 60
    print("T03b: " + curry3b(100)(300)(600));  # 1000
} catch (e) { print("T03b-ERR: " + e); }

# ============================================================
# T04: 函数组合 — compose(f, g)
# fn 语句形式: fn compose(f, g) { fn h(x) { return f(g(x)); } return h; }
# 2 层嵌套, 引用外层参数 f, g. 预期: 7, 22, 13
# ============================================================
print("=== T04 compose (fn stmt) ===");
try {
    fn compose(f, g) {
        fn h(x) { return f(g(x)); }
        return h;
    }
    let h1 = compose(inc, double);     # inc(double(x))
    print("T04: " + h1(3));            # 7  (1 + 2*3)
    let h2 = compose(double, inc);     # double(inc(x))
    print("T04: " + h2(10));           # 22 (2 * (10+1))
    let h3 = compose(inc, compose(double, inc));  # inc(double(inc(x)))
    print("T04: " + h3(5));            # 13 (1 + 2*(5+1))
} catch (e) { print("T04-ERR: " + e); }

# T04b: 函数组合 — let-lambda 形式 (对照)
print("=== T04b compose (let-lambda) ===");
try {
    fn composeB(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    print("T04b: " + composeB(inc, double)(3));    # 7
    print("T04b: " + composeB(double, inc)(10));   # 22
} catch (e) { print("T04b-ERR: " + e); }

# ============================================================
# T05: map 模式 — fn map(arr, f) { ... }
# 预期: [2, 4, 6], [1, 4, 9], [2, 4, 6, 8, 10]
# ============================================================
print("=== T05 map ===");
try {
    fn map(arr, f) {
        let r = [];
        for x in arr { push(r, f(x)); }
        return r;
    }
    print("T05: " + map([1, 2, 3], double));          # [2, 4, 6]
    print("T05: " + map([1, 2, 3], sq));              # [1, 4, 9]
    print("T05: " + map([1, 2, 3, 4, 5], fn(x) { return x * 2; }));  # [2, 4, 6, 8, 10]
} catch (e) { print("T05-ERR: " + e); }

# ============================================================
# T06: filter 模式 — fn filter(arr, pred) { ... }
# 预期: [2, 4], [1, 3, 5], []
# ============================================================
print("=== T06 filter ===");
try {
    fn filter(arr, pred) {
        let r = [];
        for x in arr { if (pred(x)) { push(r, x); } }
        return r;
    }
    print("T06: " + filter([1, 2, 3, 4], isEven));            # [2, 4]
    print("T06: " + filter([1, 2, 3, 4, 5], fn(x) { return x % 2 == 1; }));  # [1, 3, 5]
    print("T06: " + filter([1, 2, 3], fn(x) { return x > 10; }));            # []
} catch (e) { print("T06-ERR: " + e); }

# ============================================================
# T07: reduce/fold — fn reduce(arr, f, init) { ... }
# 预期: 15, 120, 0
# ============================================================
print("=== T07 reduce ===");
try {
    fn reduce(arr, f, init) {
        let acc = init;
        for x in arr { acc = f(acc, x); }
        return acc;
    }
    print("T07: " + reduce([1, 2, 3, 4, 5], addTop, 0));      # 15
    print("T07: " + reduce([1, 2, 3, 4, 5], fn(a, b) { return a * b; }, 1));  # 120
    print("T07: " + reduce([], addTop, 0));                    # 0
    # max via reduce
    print("T07: " + reduce([3, 1, 4, 1, 5, 9, 2, 6], fn(a, b) { if (a > b) { return a; } return b; }, 0));  # 9
} catch (e) { print("T07-ERR: " + e); }

# ============================================================
# T08: forEach — fn each(arr, f) { for x in arr { f(x); } }
# 用日志 list 记录副作用. 预期: [1, 4, 9, 16]
# ============================================================
print("=== T08 forEach ===");
try {
    fn each(arr, f) {
        for x in arr { f(x); }
    }
    let log = [];
    each([1, 2, 3, 4], fn(x) { push(log, x * x); });
    print("T08: " + log);              # [1, 4, 9, 16]
    # forEach 不返回值 (null)
    fn eachNoret(arr, f) { for x in arr { f(x); } }
    let r = eachNoret([1, 2], fn(x) { });
    print("T08b: " + r);               # null
} catch (e) { print("T08-ERR: " + e); }

# ============================================================
# T09: 偏应用 — 固定部分参数创建新函数
# fn partial(f, a) { return fn(b) { return f(a, b); }; }
# 预期: 3, PRE-FIX, 100
# ============================================================
print("=== T09 partial application ===");
try {
    fn partial(f, a) {
        let bound = fn(b) { return f(a, b); };
        return bound;
    }
    let minus5 = partial(subTop, 5);
    print("T09: " + minus5(2));                  # 3  (5 - 2)
    fn cat(a, b) { return a + "-" + b; }
    let prepend = partial(cat, "PRE");
    print("T09: " + prepend("FIX"));             # PRE-FIX
    let add100 = partial(addTop, 100);
    print("T09: " + add100(0));                  # 100
} catch (e) { print("T09-ERR: " + e); }

# ============================================================
# T10: 递归高阶函数 — memoize(fib)
# 用 dict 缓存. 注意: fib 用 fn 语句定义 (规避 lambda 递归 bug)
# 预期: 55, 55, 55
# ============================================================
print("=== T10 memoize ===");
try {
    fn fib(n) {
        if (n < 2) { return n; }
        return fib(n - 1) + fib(n - 2);
    }
    fn memoize(f) {
        let cache = {};
        let wrapped = fn(n) {
            let key = "" + n;
            if (has_key(cache, key)) { return cache[key]; }
            let v = f(n);
            cache[key] = v;
            return v;
        };
        return wrapped;
    }
    let mfib = memoize(fib);
    print("T10: " + mfib(10));     # 55
    print("T10: " + mfib(10));     # 55 (缓存命中)
    print("T10: " + mfib(15));     # 610
} catch (e) { print("T10-ERR: " + e); }

# ============================================================
# T11: 回调模式 — fn async_op(cb) { cb(42); }
# 预期: got=42, got=hi, done
# ============================================================
print("=== T11 callback ===");
try {
    fn asyncOp(cb) { return cb(42); }
    print("T11: got=" + asyncOp(fn(x) { return x; }));            # got=42
    print("T11: got=" + asyncOp(fn(x) { return "hi"; }));        # got=hi
    # 回调无返回值 (副作用)
    let log = [];
    fn fire(cb) { cb(99); return "done"; }
    print("T11: " + fire(fn(x) { push(log, x); }));              # done
    print("T11: log=" + log);                                     # log=[99]
} catch (e) { print("T11-ERR: " + e); }

# ============================================================
# T12: 事件处理 — dict 存储回调
# {"on_click": fn(x) { ... }}
# 预期: clicked-btn, changed-5, none
# ============================================================
print("=== T12 event handlers ===");
try {
    let handlers = {
        "on_click": fn(x) { return "clicked-" + x; },
        "on_change": fn(x) { return "changed-" + x; }
    };
    print("T12: " + handlers["on_click"]("btn"));       # clicked-btn
    print("T12: " + handlers["on_change"](5));          # changed-5
    # 动态注册
    handlers["on_submit"] = fn(x) { return "submit-" + x; };
    print("T12: " + handlers["on_submit"]("form"));     # submit-form
    # 未注册事件
    fn dispatch(handlers, evt, x) {
        let h = handlers[evt];
        if (h != null) { return h(x); }
        return "none";
    }
    print("T12: " + dispatch(handlers, "on_click", "x"));   # clicked-x
    print("T12: " + dispatch(handlers, "on_unknown", "y")); # none
} catch (e) { print("T12-ERR: " + e); }

# ============================================================
# T13: 策略模式 — 函数参数选择不同算法
# fn calculate(a, b, strategy) { return strategy(a, b); }
# 预期: 7, 3, 10, 4
# ============================================================
print("=== T13 strategy ===");
try {
    fn calculate(a, b, strategy) { return strategy(a, b); }
    print("T13: " + calculate(3, 4, addTop));            # 7
    print("T13: " + calculate(10, 3, subTop));           # 7  wait, 10-3=7
    print("T13: " + calculate(2, 8, fn(a, b) { return a * b; }));  # 16
    print("T13: " + calculate(20, 5, fn(a, b) { if (b == 0) { return -1; } return a / b; }));  # 4
} catch (e) { print("T13-ERR: " + e); }

# ============================================================
# T14: 比较器 — fn sort(arr, cmp) { ... } 传入自定义比较
# 选择排序. 预期: [1,1,2,3,4,5,6,9] 和 [9,6,5,4,3,2,1,1]
# ============================================================
print("=== T14 comparator sort ===");
try {
    fn sortBy(arr, cmp) {
        let a = arr;
        let n = len(a);
        for i in range(0, n) {
            let m = i;
            for j in range(i + 1, n) {
                if (cmp(a[j], a[m]) < 0) { m = j; }
            }
            if (m != i) {
                let tmp = a[i];
                a[i] = a[m];
                a[m] = tmp;
            }
        }
        return a;
    }
    let data = [3, 1, 4, 1, 5, 9, 2, 6];
    print("T14 asc: " + sortBy(data, fn(x, y) { return x - y; }));    # [1, 1, 2, 3, 4, 5, 6, 9]
    # 重新建数据避免原地排序残留
    let data2 = [3, 1, 4, 1, 5, 9, 2, 6];
    print("T14 desc: " + sortBy(data2, fn(x, y) { return y - x; }));  # [9, 6, 5, 4, 3, 2, 1, 1]
    # 用顶层 fn 作比较器
    fn cmpAsc(x, y) { return x - y; }
    let data3 = [5, 2, 8, 1];
    print("T14 topfn: " + sortBy(data3, cmpAsc));   # [1, 2, 5, 8]
} catch (e) { print("T14-ERR: " + e); }

