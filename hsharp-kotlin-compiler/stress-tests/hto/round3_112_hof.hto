        let step1 = fn(a) {
            let step2 = fn(b) { return f(a, b); };
            return step2;
        };
        return step1;
    }
    let curriedAdd = curry2(addTop);
    print("T36: " + curriedAdd(3)(4));      # 7
    let curriedSub = curry2(subTop);
    print("T36: " + curriedSub(10)(3));     # 7
