        return obj;
    }
    let cfg = {"count": 0, "name": "x"};
    let inc1 = fn(x) { return x + 1; };
    updateDeep(cfg, inc1);
    print("T39: " + cfg["count"]);      # 1
    updateDeep(cfg, inc1);
    print("T39: " + cfg["count"]);      # 2
