    }
    print("T41: " + applyN(fns[0], 10));   # 11 (i=1)
    print("T41: " + applyN(fns[1], 10));   # 12 (i=2)
    print("T41: " + applyN(fns[2], 10));   # 13 (i=3)
} catch (e) { print("T41-ERR: " + e); }

