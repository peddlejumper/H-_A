# T40: HOF 递归 — 用 HOF 包装递归 (带计数)
print("=== T40 HOF wraps recursion ===");
try {
    fn fib(n) {
        if (n < 2) { return n; }
        return fib(n - 1) + fib(n - 2);
    }
    # withCount 包装: 调用 f 并记录调用次数
    fn withCount(f) {
        let count = 0;
        let wrapped = fn(n) {
            count = count + 1;
            return f(n);
        };
        let getCount = fn() { return count; };
        return [wrapped, getCount];
    }
    let p = withCount(fib);
    let wfib = p[0];
    let getCount = p[1];
    let r = wfib(10);
    print("T40: fib(10)=" + r);           # 55
    print("T40: calls=" + getCount());    # 1 (snapshot bug: 0) — 注意 f(n) 在 wrapped 内, count 在 wrapped 内自增
} catch (e) { print("T40-ERR: " + e); }

# T41: 闭包捕获循环变量 + 高阶 — 每次迭代创建不同闭包, 通过 HOF 调用
