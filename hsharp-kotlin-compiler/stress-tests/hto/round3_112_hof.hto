print("=== T23 fn as channel msg ===");
try {
    let ch = chan_new(5);
    chan_send(ch, fn(x) { return x + 1; });
    let f = chan_recv(ch);
    print("T23: " + f(41));             # 42
    # 发送顶层 fn
    chan_send(ch, double);
    let g = chan_recv(ch);
    print("T23: " + g(4));              # 8
    # 多函数排队
    let ch2 = chan_new(10);
    chan_send(ch2, inc);
    chan_send(ch2, sq);
    print("T23: size=" + chan_size(ch2));   # 2
    let f1 = chan_recv(ch2);
    let f2 = chan_recv(ch2);
    print("T23: " + f1(0));             # 1
    print("T23: " + f2(3));             # 9
} catch (e) { print("T23-ERR: " + e); }

# ============================================================
# T24: 高阶 + match — match 选择函数然后调用
# 预期: 7, 7, 0, unknown
# ============================================================
print("=== T24 HOF + match ===");
try {
    fn pick(op) {
        return match op {
            "add" => addTop,
            "sub" => subTop,
            "dbl" => double,
            _ => fn(a, b) { return 0; }
        };
    }
    print("T24: " + pick("add")(3, 4));    # 7
    print("T24: " + pick("sub")(10, 3));   # 7
    print("T24: " + pick("mul")(3, 4));    # 0 (default)
    print("T24: " + pick("dbl")(5));       # 0 (default, 双参 lambda 收到 1 参)
    # match 直接返回 lambda 并立即调用
    fn run(op, x) {
        return match op {
            "inc" => (fn(n) { return n + 1; }),
            "dbl" => (fn(n) { return n * 2; }),
            _ => (fn(n) { return 0; })
        };
    }
    # 这里先取函数再调用
    let h = run("inc", 0);
    print("T24: " + h(5));                 # 6
    let h2 = run("dbl", 0);
    print("T24: " + h2(5));                # 10
} catch (e) { print("T24-ERR: " + e); }

# ============================================================
# T25: 递归回调 — 回调内调用注册器
# 注册器模式: register(name, cb); cb 调用 get(name) 获取其他回调
# 预期: A-then-B, B-then-A, done
# ============================================================
print("=== T25 recursive callback ===");
try {
    let registry = {};
    fn register(name, cb) { registry[name] = cb; }
    fn callByName(name, x) {
        let cb = registry[name];
        if (cb != null) { return cb(x); }
        return "none";
    }
    register("A", fn(x) {
        return "A(" + x + ")-then-" + callByName("B", x);
    });
    register("B", fn(x) {
        return "B(" + x + ")";
    });
    print("T25: " + callByName("A", 1));   # A(1)-then-B(1)
    # A 调 B, B 调 A (递归)
    let hits = [];
    register("recur", fn(x) {
        push(hits, x);
        if (x > 0) { return callByName("recur", x - 1); }
        return "done";
    });
    callByName("recur", 3);
    print("T25: hits=" + hits);            # [3, 2, 1, 0]
    print("T25: " + callByName("recur", 2));  # done
} catch (e) { print("T25-ERR: " + e); }

# ============================================================
# T26: 高阶函数性能 — 10000 次 map
# 预期: 10000, 199990000 (sum of 2*i for i in 0..9999 = 2 * 9999*10000/2)
# ============================================================
print("=== T26 HOF perf 10000 ===");
try {
    fn mapP(arr, f) {
        let r = [];
        for x in arr { push(r, f(x)); }
        return r;
    }
    # 建 10000 元素 list
    let big = [];
    let i = 0;
    while (i < 10000) { push(big, i); i = i + 1; }
    let mapped = mapP(big, double);
    print("T26: len=" + len(mapped));      # 10000
    # 求和验证
    fn sumArr(arr) {
        let s = 0;
        for x in arr { s = s + x; }
        return s;
    }
    print("T26: sum=" + sumArr(mapped));   # 0+2+4+...+19998 = 2*(0+1+...+9999) = 9999*10000 = 99990000
    # filter 性能
    fn filterP(arr, pred) {
        let r = [];
        for x in arr { if (pred(x)) { push(r, x); } }
        return r;
    }
    let evens = filterP(big, isEven);
    print("T26: evens=" + len(evens));     # 5000
} catch (e) { print("T26-ERR: " + e); }

