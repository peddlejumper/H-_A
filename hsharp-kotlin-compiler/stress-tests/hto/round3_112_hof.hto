} catch (e) { print("T27-ERR: " + e); }

# ============================================================
# T28: 嵌套函数传递 — 外层函数把内层函数传给另一个函数
# fn outer() { fn inner() {...} return apply(inner); }
# 预期: inner-ran, 42, nested
# ============================================================
print("=== T28 nested fn passing ===");
try {
    fn apply(f) { return f(); }
    fn outer() {
        let inner = fn() { return "inner-ran"; };
        return apply(inner);
    }
    print("T28: " + outer());               # inner-ran
    # 内层函数带参数, 传给 HOF
    fn applyArg(f, x) { return f(x); }
    fn outerB(n) {
        let inner = fn(x) { return x * n; };
        return applyArg(inner, 7);
    }
    print("T28: " + outerB(6));             # 42
    # 两层嵌套函数互相传递
    fn composer(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    fn outerC() {
        let a = fn(x) { return x + 1; };
        let b = fn(x) { return x * 2; };
        let combined = composer(a, b);
        return combined(10);    # (10*2)+1 = 21
    }
    print("T28: " + outerC());              # 21
    # fn 语句形式的内层函数传递 (2 层, 已知可工作)
    fn outerD() {
        fn inner() { return "nested"; }
        return apply(inner);
    }
    print("T28: " + outerD());              # nested
} catch (e) { print("T28-ERR: " + e); }

