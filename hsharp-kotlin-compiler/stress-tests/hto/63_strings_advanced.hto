# T63 - String operations & native functions stress test
# 目标：全面测试字符串操作与原生函数，发现 bug

# ========== Case 1: 基础拼接 ==========
let s1 = "a" + "b";
print("C1a: " + s1);
print("C1b: " + "a" + str(1));
print("C1c: " + ("a" + 1));

# ========== Case 2: 字符串重复 ==========
print("C2a: " + "ab" * 3);
print("C2b: [" + "ab" * 0 + "]");
print("C2c: " + "x" * 1);

# ========== Case 3: 索引（含负索引与边界）==========
let s = "hello";
print("C3a: " + s[0]);
print("C3b: " + s[-1]);
print("C3c: " + s[len(s) - 1]);
print("C3d: " + s[4]);

# ========== Case 4: 越界索引（应报错）==========
try {
    print("C4: " + s[10]);
} catch (e) {
    print("C4-err: " + e);
}

# ========== Case 5: 切片 ==========
print("C5a: " + s[1:3]);
print("C5b: " + s[:2]);
print("C5c: " + s[2:]);
print("C5d: " + s[-2:-1]);
print("C5e: " + s[::2]);

# ========== Case 6: 负步长切片 s[::-1]（反转）==========
try {
    print("C6: " + s[::-1]);
} catch (e) {
    print("C6-err: " + e);
}

# ========== Case 7: 转义字符 ==========
print("C7a: [" + "tab\tend" + "]");
print("C7b: " + "new\nline");
print("C7c: " + "quote\"end");
print("C7d: " + "backslash\\end");
print("C7e: [" + "\x41" + "]");
print("C7f: [" + "\u4e2d" + "]");

# ========== Case 8: 原生函数 len/str/ord/chr/int/float ==========
print("C8a: " + str(len("hello")));
print("C8b: " + str(42));
print("C8c: " + str(ord("A")));
print("C8d: " + chr(66));
print("C8e: " + str(int("123")));
print("C8f: " + str(float("3.14")));

# ========== Case 9: 字符串方法 ==========
print("C9a: [" + "  hello  ".strip() + "]");
print("C9b: " + str("a,b,c".split(",")));
print("C9c: " + ",".join(["x", "y", "z"]));
print("C9d: " + "Hello".replace("l", "L"));
print("C9e: " + str("hello".contains("ell")));
print("C9f: " + str("hello".starts_with("he")));
print("C9g: " + str("hello".ends_with("lo")));
print("C9h: " + "Hello".upper());
print("C9i: " + "Hello".lower());
print("C9j: " + str("abcabc".find("a")));

# ========== Case 10: find 带起始位置 ==========
print("C10: " + str("abcabc".find("a", 2)));

# ========== Case 11: fmt() 格式化 ==========
print("C11a: " + fmt("{0}-{1}", "a", "b"));
print("C11b: " + fmt("{0} + {1} = {2}", 1, 2, 3));
print("C11c: " + fmt("missing {9} arg"));
print("C11d: " + fmt("{0}-{0}", "x"));

# ========== Case 12: 中文字符串 ==========
let cn = "中文";
print("C12a: " + str(len(cn)));
print("C12b: " + cn[0]);
print("C12c: " + cn[1]);
print("C12d: " + cn[0:1]);

# ========== Case 13: 空字符串 ==========
let empty = "";
print("C13a: " + str(len(empty)));
print("C13b: " + str(empty.is_empty()));
try {
    print("C13c: " + empty[0]);
} catch (e) {
    print("C13c-err: " + e);
}

# ========== Case 14: 字符串比较 ==========
print("C14a: " + str("abc" == "abc"));
print("C14b: " + str("abc" != "abd"));
print("C14c: " + str("abc" < "abd"));
print("C14d: " + str("abd" > "abc"));

# ========== Case 15: in 子串包含 ==========
print("C15a: " + str("ell" in "hello"));
print("C15b: " + str("xyz" in "hello"));
print("C15c: " + str("中" in "中文"));

# ========== Case 16: substring 原生函数 ==========
print("C16a: " + substring("hello", 1, 3));
print("C16b: " + substring("hello", 0, 100));

# ========== 以下为可能崩溃的边界用例，放在最后 ==========

# ========== Case 17: 负数重复 "ab" * -1 ==========
try {
    print("C17: " + "ab" * -1);
} catch (e) {
    print("C17-err: " + e);
}

# ========== Case 18: join 非字符串元素 ==========
try {
    print("C18: " + ",".join([1, 2, 3]));
} catch (e) {
    print("C18-err: " + e);
}

print("DONE");
