print("=== P. as chain/nested ===");
try {
    let d = new DogD();
    let a = d as AnimalD;
    print("r116_as_upcast:" + str(a.kind()));
} catch (e) { print("r116_as_upcast:EXC[" + str(e) + "]"); }

