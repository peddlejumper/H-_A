# ============================================================
# S11 — for + return
# ============================================================
print("===S11a-return-in-for===");
fn find11(needle) {
    for x in [1, 2, 3, 4, 5] {
        if (x == needle) { return x * 100; }
    }
    return -1;
}
print("expect:300");
print("actual:" + find11(3));

print("===S11b-return-not-found===");
print("expect:-1");
print("actual:" + find11(99));

print("===S11c-return-bare-in-for===");
# `return;` inside a for must return null, NOT the iterator dict.
fn bare11() {
    for x in [1, 2, 3] {
        if (x == 2) { return; }
    }
    return 999;
}
let r11c = bare11();
print("expect:null");
print("actual:" + r11c);

print("===S11d-return-in-nested-for===");
fn nested11() {
    for i in [1, 2, 3] {
        for j in [10, 20] {
            if (i == 2 && j == 20) { return i * 100 + j; }
        }
    }
    return -1;
}
print("expect:220");
print("actual:" + nested11());

print("===S11e-return-first-iter===");
fn first11() {
    for x in [7, 8, 9] { return x; }
    return -1;
}
print("expect:7");
print("actual:" + first11());

# ============================================================
# S12 — for + try
# ============================================================
print("===S12a-try-catch-in-for===");
let s12a = "";
for i in [1, 2, 3, 4] {
    try {
        if (i == 2) { throw "boom"; }
        s12a = s12a + i + ",";
    } catch (e) {
        s12a = s12a + "err" + i + ",";
    }
}
print("expect:1,err2,3,4,");
print("actual:" + s12a);

print("===S12b-break-in-try===");
let s12b = "";
for i in [1, 2, 3, 4] {
    try {
        if (i == 3) { break; }
        s12b = s12b + i + ",";
    } catch (e) {
        s12b = s12b + "err;";
    }
}
print("expect:1,2,");
print("actual:" + s12b);

print("===S12c-continue-in-try===");
let s12c = "";
for i in [1, 2, 3, 4] {
    try {
        if (i == 2) { continue; }
        s12c = s12c + i + ",";
    } catch (e) {
        s12c = s12c + "err;";
    }
}
print("expect:1,3,4,");
print("actual:" + s12c);

print("===S12d-throw-uncaught-in-for===");
# An uncaught throw inside a for should propagate out, leaving the
# iterator on the stack (cleaned up with the frame).
let s12d = "no-err";
try {
    for i in [1, 2, 3] {
        if (i == 2) { throw "propagated"; }
    }
    s12d = "no-throw";
} catch (e) {
    s12d = "caught:" + e;
}
print("expect:caught:propagated");
print("actual:" + s12d);

print("===S12e-for-in-catch===");
# A for loop inside a catch block.
let s12e = "";
try {
    throw [1, 2, 3];
} catch (e) {
    for x in e { s12e = s12e + x + ","; }
}
print("expect:1,2,3,");
print("actual:" + s12e);

# ============================================================
# S13 — Custom iterator (class with iter/next)
# ============================================================
print("===S13a-class-as-iterable===");
# H# has no __iter__/__next__ protocol: forIterFirst's `else` branch
# throws "FOR_ITER: unsupported iterable instance".  Python would
# call __iter__/__next__.
class Counter13 {
    fn __init__(self, n) { self.n = n; self.i = 0; }
    fn __iter__(self) { return self; }
    fn __next__(self) {
        if (self.i >= self.n) { throw "StopIteration"; }
        let v = self.i;
        self.i = self.i + 1;
        return v;
    }
}
let c13 = new Counter13(3);
let s13a = "no-err";
try {
    for x in c13 { s13a = s13a + x + ","; }
    print("expect:ERROR (unsupported iterable) / 0,1,2, (if protocol)");
    print("actual:" + s13a);
} catch (e) {
    print("expect:ERROR (unsupported iterable) / 0,1,2, (if protocol)");
    print("actual:caught:" + e);
}

print("===S13b-instance-field-iter===");
# Verify the instance itself is otherwise usable (methods work).
let c13b = new Counter13(2);
let s13b = "";
try {
    s13b = s13b + c13b.__next__() + ",";
    s13b = s13b + c13b.__next__();
    print("expect:0,1");
    print("actual:" + s13b);
} catch (e) {
    print("expect:0,1");
    print("actual:caught:" + e);
}

# ============================================================
# S14 — while equivalence (for vs while over same data)
# ============================================================
print("===S14a-for-vs-while-list===");
let data14 = [5, 10, 15, 20];
let for14 = 0;
for x in data14 { for14 = for14 + x; }
let while14 = 0;
let wi14 = 0;
while (wi14 < len(data14)) {
    while14 = while14 + data14[wi14];
    wi14 = wi14 + 1;
}
print("expect:for=50 while=50");
print("actual:for=" + for14 + " while=" + while14);

print("===S14b-for-vs-while-range===");
let for14b = 0;
for i in range(1, 6) { for14b = for14b + i; }
let while14b = 0;
let wi14b = 1;
while (wi14b < 6) {
    while14b = while14b + wi14b;
    wi14b = wi14b + 1;
}
print("expect:for=15 while=15");
print("actual:for=" + for14b + " while=" + while14b);

print("===S14c-for-vs-while-break===");
let for14c = 0;
for i in range(10) {
    if (i == 5) { break; }
    for14c = for14c + i;
}
let while14c = 0;
let wi14c = 0;
while (wi14c < 10) {
    if (wi14c == 5) { break; }
    while14c = while14c + wi14c;
    wi14c = wi14c + 1;
}
print("expect:for=10 while=10");
print("actual:for=" + for14c + " while=" + while14c);

# ============================================================
# S15 — Multi-level destructuring in for header
# ============================================================
# `for [a, b] in [[1,2],[3,4]] { ... }` is NOT supported by the
# parser (for_statement only accepts IDENT or IDENT, IDENT).  This
# would be a COMPILE-TIME SyntaxError, so it lives in a sibling
# probe file _probe151_S15_for_destruct.hto.  Here we exercise the
# two workarounds instead.
print("===S15a-workaround-destructure-in-body===");
let pairs15 = [[1, 2], [3, 4], [5, 6]];
let s15a = 0;
for pr in pairs15 {
    let [a15, b15] = pr;
