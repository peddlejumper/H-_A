# =============================================================
# S33: Unicode 字符串相等性 — 代理对完整性
# =============================================================
print("[S33a emoji-eq expect=true] " + str("😀" == "😀"));
print("[S33b emoji-neq expect=true] " + str("😀" != "🎉"));
print("[S33c emoji-eq-chr expect=true] " + str("😀" == chr(128512)));
print("[S33d cn-eq expect=true] " + str("你好" == "你好"));
print("[S33e cn-neq expect=true] " + str("你好" != "你坏"));
# 拼接后相等
print("[S33f concat-eq expect=true] " + str(("😀" + "🎉") == "😀🎉"));

# =============================================================
# S34: 长字符串 Unicode 操作一致性
# =============================================================
let long = "你好😀世界🎉abc";
# 你-好-😀-世-界-🎉-a-b-c = 9 码点
print("[S34a long-len expect=9] " + str(len(long)));
# find 从不同位置
print("[S34b long-find-emoji expect=2] " + str(long.find("😀")));
print("[S34c long-find-emoji2 expect=5] " + str(long.find("🎉")));
print("[S34d long-find-after expect=6] " + str(long.find("a")));
# replace 后长度
let longReplaced = long.replace("😀", "🎉");
print("[S34e long-replace-len expect=9] " + str(len(longReplaced)));
# split 后元素长度
let longParts = long.split("😀");
print("[S34f long-split-0 expect=你好] " + longParts[0]);
print("[S34g long-split-1 expect=世界🎉abc] " + longParts[1]);

