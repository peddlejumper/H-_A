# =============================================================
# S32: emoji 在 list 中
# =============================================================
let emojiArr = ["😀", "🎉", "😎"];
print("[S32a list-emoji-len expect=3] " + str(len(emojiArr)));
print("[S32b list-emoji-0 expect=😀] " + emojiArr[0]);
print("[S32c list-emoji-2 expect=😎] " + emojiArr[2]);
# list 中查找 emoji
