let t14a = "no-err";
try { t14a = "got:" + str(len()); } catch (e) { t14a = "caught:" + str(e); }
print("[T14.1 len()] expect=caught err]");
print(t14a);

# len 2 参数
let t14b = "no-err";
try { t14b = "got:" + str(len([1], [2])); } catch (e) { t14b = "caught:" + str(e); }
print("[T14.2 len([1],[2])] expect=caught err]");
print(t14b);

# abs 0 参数
let t14c = "no-err";
try { t14c = "got:" + str(abs()); } catch (e) { t14c = "caught:" + str(e); }
print("[T14.3 abs()] expect=caught err]");
print(t14c);

# abs 2 参数
let t14d = "no-err";
try { t14d = "got:" + str(abs(-5, 3)); } catch (e) { t14d = "caught:" + str(e); }
print("[T14.4 abs(-5,3)] expect=caught err]");
print(t14d);

# chr 0 参数
let t14e = "no-err";
try { t14e = "got:" + str(chr()); } catch (e) { t14e = "caught:" + str(e); }
print("[T14.5 chr()] expect=caught err]");
print(t14e);

# type 0 参数
let t14f = "no-err";
try { t14f = "got:" + str(type()); } catch (e) { t14f = "caught:" + str(e); }
print("[T14.6 type()] expect=caught err]");
print(t14f);

# ---------- T15: fmt 参数类型混合 ----------
print("[T15.1 fmt('{0} {1}',1,'a')] expect=1 a]");
print(fmt("{0} {1}", 1, "a"));

print("[T15.2 fmt('{0} {1}','a',1)] expect=a 1]");
print(fmt("{0} {1}", "a", 1));

print("[T15.3 fmt('{0} {1} {2}',1,true,null)] expect=1 true null]");
print(fmt("{0} {1} {2}", 1, true, null));

# fmt 嵌套列表
print("[T15.4 fmt('{0}',[[1,2],[3,4]])] expect=[[1, 2], [3, 4]]]");
print(fmt("{0}", [[1, 2], [3, 4]]));

# ---------- T16: range 边界补充 ----------
# range 大数
print("[T16.1 len(range(1000))] expect=1000]");
print(len(range(1000)));

# range 用浮点数 (应被截断)
print("[T16.2 range(3.7)] expect=[0,1,2]]");
print(range(3.7));

# range 用浮点边界
print("[T16.3 range(1.9,4.9)] expect=[1,2,3,4]]");
print(range(1.9, 4.9));

# range 用 bool (true=1)
let t16a = "no-err";
try { t16a = "got:" + str(range(true)); } catch (e) { t16a = "caught:" + str(e); }
print("[T16.4 range(true)] expect=[0] OR caught]");
print(t16a);

# range 用 null
let t16b = "no-err";
try { t16b = "got:" + str(range(null)); } catch (e) { t16b = "caught:" + str(e); }
print("[T16.5 range(null)] expect=[] OR caught]");
print(t16b);

# range 用字符串
let t16c = "no-err";
try { t16c = "got:" + str(range("5")); } catch (e) { t16c = "caught:" + str(e); }
print("[T16.6 range('5')] expect=[0..4] OR caught]");
print(t16c);

print("===== R2-97 DONE =====");
