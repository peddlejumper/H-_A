# round2_96_cast.hto — 类型转换与强制 stress test
# 测试智能体 #96。覆盖 task 列出的 20 个领域深边界。
# 每个 probe 用 try/catch 包住，输出 r96_<name>:<result>，便于失败定位。
# 注：bool/list/dict 非内建，用顶层 try/catch 测试（lambda 内未定义名异常不可捕获）。

# ============================================================
# 工具：安全执行包装（用于内建函数）
# ============================================================
fn safe(label, f) {
    try {
        let r = f();
        print(label + ":" + str(r));
    } catch (e) {
        print(label + ":EXC[" + str(e) + "]");
    }
}

# ============================================================
# 1. int("123") 字符串转整数 — 正常路径
# ============================================================
safe("r96_int_str_123", fn() { return int("123"); });
safe("r96_int_str_0", fn() { return int("0"); });
safe("r96_int_str_neg", fn() { return int("-42"); });
safe("r96_int_str_spaces", fn() { return int("  7  "); });
safe("r96_int_str_empty", fn() { return int(""); });

