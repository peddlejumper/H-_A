# ============================================================
# 21. type() vs is 的一致性探测
#    type(1) 返回 "number"，但 match 用 is int — 命名不一致
# ============================================================
fn type_vs_is(x) {
    let t = type(x);
    return match t {
        "number" => "num",
        "string" => "str",
        _ => "other:" + t
    };
}
safe("r96_type_vs_is_int", fn() { return type_vs_is(1); });
safe("r96_type_vs_is_str", fn() { return type_vs_is("hi"); });

fn match_type_name(x) {
    return match x {
        is int => "is-int",
        is str => "is-str",
        is bool => "is-bool",
        _ => "other"
    };
}
safe("r96_is_int", fn() { return match_type_name(1); });
safe("r96_is_str", fn() { return match_type_name("hi"); });
safe("r96_is_bool", fn() { return match_type_name(true); });

