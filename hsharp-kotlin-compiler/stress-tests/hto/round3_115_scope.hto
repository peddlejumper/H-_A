# round3_115_scope.hto — 测试智能体 #115
# 领域: 变量作用域穿透与遮蔽 (Variable Scope Penetration & Shadowing)
# H# v0.4.1
#
# 已知背景:
#   - for 变量泄漏 (env[v1] = ... 直接写入函数 env)
#   - catch 变量泄漏 (STORE_NAME exception_name 后无清理)
#   - block-let 泄漏 (BlockStatement 直接编译语句, 无 scope push/pop)
#   - if / while / concurrent 块均无独立作用域
#   - 闭包捕获存在 snapshot bug (round2/round3_110 已测)
#
# 本测试聚焦: 块作用域泄漏、循环变量泄漏、catch 变量泄漏、
#             变量遮蔽语义、重复声明、声明前使用、解构作用域、
#             for 变量遮蔽外层、match/concurrent 块作用域。
# 每个用例独立 try/catch 包裹避免整体中止; 打印 "Txx:" 前缀, 预期值在注释。
# 严重性标注: [LEAK]=作用域泄漏 [SHADOW]=遮蔽语义 [CRASH]=运行时崩溃

# ============================================================
# T01: 块内 let 泄漏到外层 — if 块
# 块作用域语言: 错误 (x 不可见)
# H# (函数级作用域): x 泄漏, 打印 1
# ============================================================
print("=== T01 if-block let leak ===");
try {
    if (true) { let x = 1; }
    print("T01: " + x);   # 1 (LEAK) ; ERR (block-scoped)
} catch (e) { print("T01-ERR: " + e); }

# ============================================================
# T02: for 循环变量泄漏 — 循环结束后 i 是否可见
# 块作用域语言: 错误
# H#: i 泄漏, 打印最后值 3
# ============================================================
print("=== T02 for-var leak ===");
try {
    for i in [1, 2, 3] { }
    print("T02: " + i);   # 3 (LEAK) ; ERR (block-scoped)
} catch (e) { print("T02-ERR: " + e); }

# ============================================================
# T03: catch 变量泄漏 — catch 块结束后 e 是否可见
# 块作用域语言: 错误
# H#: e 泄漏, 打印 "boom"
# ============================================================
print("=== T03 catch-var leak ===");
try {
    try {
        throw "boom";
    } catch (e) {
        print("T03-in-catch: " + e);   # boom
    }
    print("T03-after: " + e);   # boom (LEAK) ; ERR (block-scoped)
} catch (e2) { print("T03-ERR: " + e2); }

# ============================================================
# T04: while 循环内 let 泄漏
# 块作用域语言: 错误 (w 不可见)
# H#: w 泄漏, 打印最后值 2
# ============================================================
print("=== T04 while-block let leak ===");
try {
    let i = 0;
    while (i < 3) {
        let w = i;
        i = i + 1;
    }
    print("T04: " + w);   # 2 (LEAK) ; ERR (block-scoped)
} catch (e) { print("T04-ERR: " + e); }

# ============================================================
# T05: 嵌套 if 块内 let 泄漏
# 块作用域语言: 错误
# H#: deep 泄漏, 打印 1
# ============================================================
print("=== T05 nested-if let leak ===");
try {
    if (true) {
        if (true) {
            let deep = 1;
        }
    }
    print("T05: " + deep);   # 1 (LEAK) ; ERR (block-scoped)
} catch (e) { print("T05-ERR: " + e); }

# ============================================================
# T06: 变量遮蔽 — 块内 let 同名变量
# 块作用域语言: inner=2, outer=1 (内外独立)
# H#: let 即 STORE_NAME, 内层 x=2 覆盖外层, 泄漏后 outer=2
# ============================================================
print("=== T06 shadowing in if-block ===");
try {
    let x = 1;
    if (true) {
        let x = 2;
        print("T06-inner: " + x);   # 2
    }
    print("T06-outer: " + x);   # 1 (block-scoped) ; 2 (LEAK, reassign)
} catch (e) { print("T06-ERR: " + e); }

# ============================================================
# T07: 函数参数遮蔽全局变量
# 预期: f(2) 返回 2, 全局 x 保持 1
# ============================================================
print("=== T07 param shadows global ===");
try {
    let x = 1;
    fn f07(x) { return x; }
    print("T07-call: " + f07(2));   # 2
    print("T07-global: " + x);      # 1 (参数不影响全局)
} catch (e) { print("T07-ERR: " + e); }

# ============================================================
# T08: 函数内 let 遮蔽参数 — let 是否覆盖参数
# 块作用域语言: 返回 10, 但参数 x 不变 (不同 binding)
# H#: let x=10 即 STORE_NAME x, 覆盖参数, 返回 10
# ============================================================
print("=== T08 let shadows param ===");
try {
    fn f08(x) {
        let x = 10;
        return x;
    }
    print("T08: " + f08(5));   # 10
} catch (e) { print("T08-ERR: " + e); }

# ============================================================
# T09: 闭包变量遮蔽 — 内层 let x 遮蔽外层 x
# 预期: g 返回内层 x=2; 外层 x 保持 1
# ============================================================
print("=== T09 closure shadowing ===");
try {
    let x = 1;
    fn f09() {
        let x = 2;
        fn g() { return x; }
        return g();
    }
    print("T09-call: " + f09());   # 2
    print("T09-outer: " + x);      # 1 (内层 let 不影响外层)
} catch (e) { print("T09-ERR: " + e); }

# ============================================================
# T10: 循环内嵌套循环 — 内层 j 是否泄漏到外层循环外
# 块作用域语言: 错误
# H#: j 泄漏, 打印 4
# ============================================================
print("=== T10 nested-for inner leak ===");
try {
    for i in [1, 2] {
        for j in [3, 4] { }
    }
    print("T10-j: " + j);   # 4 (LEAK) ; ERR
    print("T10-i: " + i);   # 2 (LEAK) ; ERR
} catch (e) { print("T10-ERR: " + e); }

# ============================================================
# T11: 多层 for — 最内层 k 泄漏
# 块作用域语言: 错误
# H#: k 泄漏, 打印 2
# ============================================================
print("=== T11 triple-for innermost leak ===");
try {
    for i in range(3) {
        for j in range(3) {
            for k in range(3) { }
        }
    }
    print("T11-k: " + k);   # 2 (LEAK) ; ERR
    print("T11-j: " + j);   # 2 (LEAK) ; ERR
    print("T11-i: " + i);   # 2 (LEAK) ; ERR
} catch (e) { print("T11-ERR: " + e); }

# ============================================================
# T12: for 变量遮蔽外层同名变量 — 循环后外层值
# 块作用域语言: 外层 i 保持 100
# H#: for i 覆盖外层 i, 循环后 i=3 (LEAK + 覆盖)
# ============================================================
print("=== T12 for-var shadows outer ===");
try {
    let i = 100;
    for i in [1, 2, 3] { }
    print("T12: " + i);   # 100 (block-scoped) ; 3 (LEAK, overwrite)
} catch (e) { print("T12-ERR: " + e); }

# ============================================================
# T13: if-else 分支不同变量 — 两分支变量是否在后续可见
# 块作用域语言: a, b 均不可见
# H#: 走 true 分支时 a 泄漏; b 未定义
# ============================================================
print("=== T13 if-else branch vars ===");
try {
    if (true) {
        let a = 1;
    } else {
        let b = 2;
    }
    print("T13-a: " + a);   # 1 (LEAK) ; ERR
} catch (e) { print("T13-a-ERR: " + e); }

try {
    if (false) {
        let a = 1;
    } else {
        let b = 2;
    }
    print("T13-b: " + b);   # 2 (LEAK) ; ERR
} catch (e) { print("T13-b-ERR: " + e); }

# ============================================================
# T14: match 绑定变量泄漏 — match arm body 仅支持表达式, 测试绑定变量 n 是否泄漏
# 块作用域语言: 错误 (n 不可见)
# H#: n 泄漏 (STORE_NAME)
# ============================================================
print("=== T14 match-binding leak ===");
try {
    let x = 5;
    match x {
        n => "bound-" + n,
        _ => "other"
    };
    print("T14: " + n);   # 5 (LEAK) ; ERR (block-scoped)
} catch (e) { print("T14-ERR: " + e); }

# ============================================================
# T15: concurrent 块内 let 泄漏
# 块作用域语言: 错误
# H#: c 可能泄漏
# ============================================================
print("=== T15 concurrent-block let leak ===");
try {
    concurrent {
        let c = 1;
    }
    print("T15: " + c);   # 1 (LEAK) ; ERR
} catch (e) { print("T15-ERR: " + e); }

# ============================================================
# T16: 函数内嵌套函数变量 — 内层 let 是否泄漏到外层函数
# 块作用域语言: 错误 (y 不可见)
# H#: y 泄漏到 outer 的 env, 返回 2
# ============================================================
print("=== T16 nested-fn let leak ===");
try {
    fn outer16() {
        let x = 1;
        fn inner() {
            let y = 2;
        }
        inner();
        return y;   # 块作用域: ERR ; H#: 2 (LEAK)
    }
    print("T16: " + outer16());   # 2 (LEAK) ; ERR
} catch (e) { print("T16-ERR: " + e); }

# ============================================================
# T17: 全局变量在函数内修改 — 函数外是否可见
# 预期: g=2 (函数可访问并修改全局)
# ============================================================
print("=== T17 fn modifies global ===");
try {
    let g17 = 1;
    fn f17() { g17 = 2; }
    f17();
    print("T17: " + g17);   # 2
} catch (e) { print("T17-ERR: " + e); }

# ============================================================
# T18: 全局变量与内层函数同名 — 内层 fn g 遮蔽全局 g
# fn f() { fn g() { g = 2; } g(); } — g 调用是函数, 内部 g=2 修改谁?
# 极易混淆: 遮蔽 + 递归 + 赋值
# ============================================================
print("=== T18 fn-name shadows global var ===");
try {
    let g18 = 1;
    fn f18() {
        fn g18() { g18 = 2; return g18; }
        let r = g18();   # 调用内层函数 g18
        print("T18-inner-r: " + r);   # 2 (函数返回) 或递归崩溃
    }
    f18();
    print("T18-outer-g: " + g18);   # 1 (内层 fn 遮蔽, 不影响全局) 或 2
} catch (e) { print("T18-ERR: " + e); }

# ============================================================
# T19: 变量声明前使用 — print(x) 在 let x 之前
# 预期: 错误 (x 未定义) 或 null
# ============================================================
print("=== T19 use-before-declare ===");
try {
    print("T19-pre: " + x);   # ERR / null
    let x = 1;
    print("T19-post: " + x);
} catch (e) { print("T19-ERR: " + e); }

# ============================================================
# T20: 同名重复声明 — let x 两次
# 块作用域语言: 错误 (重复声明)
# H#: let 即 STORE_NAME, 第二次覆盖, x=2
# ============================================================
print("=== T20 redeclare same name ===");
try {
    let x = 1;
    let x = 2;
    print("T20: " + x);   # 2 (reassign) ; ERR (block-scoped)
} catch (e) { print("T20-ERR: " + e); }

# ============================================================
# T21: 块内重复声明 — 块内 let x 与外层同名, 块内再 let x
# 块作用域语言: 块内第二次 let x 错误
# H#: 全部 STORE_NAME, 覆盖
# ============================================================
print("=== T21 redeclare in block ===");
try {
    let x = 1;
    if (true) {
        let x = 2;
        let x = 3;
        print("T21-inner: " + x);   # 3
    }
    print("T21-outer: " + x);   # 1 (block) ; 3 (LEAK)
} catch (e) { print("T21-ERR: " + e); }

# ============================================================
# T22: for 变量名与全局函数同名 — 循环后函数是否可调用
# 预期 (block-scoped): foo 仍为函数, foo()=1
# H#: foo 被覆盖为 3, foo() 报错
# ============================================================
print("=== T22 for-var shadows function ===");
try {
    fn foo() { return 1; }
    print("T22-pre: " + foo());   # 1
    for foo in [1, 2, 3] { }
    print("T22-after: " + foo);   # 3 (LEAK, 覆盖函数) ; 函数仍可调用 (block)
    print("T22-call: " + foo());   # ERR (foo 是数字) ; 1 (block)
} catch (e) { print("T22-ERR: " + e); }

# ============================================================
# T23: 闭包捕获循环变量 — 每个闭包返回什么
# per-iteration binding: 1, 2, 3
# late binding (共享变量): 3, 3, 3
# H# round2_81 显示 1,2,3 (snapshot per iter)
# ============================================================
print("=== T23 closure captures loop var ===");
try {
    let fns = [];
    for i in [1, 2, 3] {
        push(fns, fn() { return i; });
    }
    print("T23-0: " + fns[0]());   # 1
    print("T23-1: " + fns[1]());   # 2
    print("T23-2: " + fns[2]());   # 3
} catch (e) { print("T23-ERR: " + e); }

# ============================================================
# T24: 嵌套函数访问全局变量 — inner 修改全局 g
# 预期: g=2 (inner 可访问全局)
# ============================================================
print("=== T24 nested fn accesses global ===");
try {
    let g24 = 1;
    fn outer24() {
        fn inner() { g24 = g24 + 1; }
        inner();
    }
    outer24();
    print("T24: " + g24);   # 2
} catch (e) { print("T24-ERR: " + e); }

# ============================================================
# T25: try-catch-finally 作用域 (H# 无 finally, 跳过 — 语法不支持, 会 parse error)
# 记录: finally 不被支持, 已知限制
# ============================================================
print("=== T25 finally unsupported ===");
try {
    print("T25: H# has no finally keyword (skipped)");
} catch (e) { print("T25-ERR: " + e); }

# ============================================================
# T26: match guard 中的变量作用域 — guard 绑定变量 n 是否泄漏
# 块作用域语言: n 不可见
# H#: n 泄漏 (guard binding via STORE_NAME)
# ============================================================
print("=== T26 match guard binding leak ===");
try {
    let x = 5;
    match x {
        n if n > 0 => "pos",
        _ => "neg"
    };
    print("T26-n: " + n);   # 5 (LEAK, guard binding) ; ERR (block-scoped)
} catch (e) { print("T26-ERR: " + e); }

# ============================================================
# T27: 解构中的变量 — 块内解构同名变量
# 块作用域语言: 外层 a=1
# H#: 块内解构覆盖, a=3 (LEAK)
# ============================================================
print("=== T27 destructure shadowing ===");
try {
    let [a, b] = [1, 2];
    print("T27-pre-a: " + a);   # 1
    print("T27-pre-b: " + b);   # 2
    if (true) {
        let [a, b] = [3, 4];
        print("T27-inner-a: " + a);   # 3
        print("T27-inner-b: " + b);   # 4
    }
    print("T27-post-a: " + a);   # 1 (block) ; 3 (LEAK)
    print("T27-post-b: " + b);   # 2 (block) ; 4 (LEAK)
} catch (e) { print("T27-ERR: " + e); }

# ============================================================
# T28: 类方法中 this 与全局同名 — fn get() 返回 x 是全局还是字段
# 预期: 返回全局 1 (需 self.x 才访问字段)
# ============================================================
print("=== T28 class field vs global ===");
try {
    let x = 1;
    class C28 {
        let x = 2;
        fn get() { return x; }       # 全局 x
        fn getSelf() { return self.x; }   # 字段 x
    }
    let c = new C28();
    print("T28-get: " + c.get());       # 1 (全局)
    print("T28-getSelf: " + c.getSelf());   # 2 (字段)
} catch (e) { print("T28-ERR: " + e); }

# ============================================================
# T29: catch 变量遮蔽外层同名变量 — catch 后外层是否恢复
# 块作用域语言: in-catch=inner, after=outer (恢复)
# H#: catch 变量 STORE_NAME 覆盖外层, after=inner (LEAK + 覆盖)
# ============================================================
print("=== T29 catch-var shadows outer ===");
try {
    let v = "outer";
    try {
        throw "inner";
    } catch (v) {
        print("T29-in-catch: " + v);   # inner
    }
    print("T29-after: " + v);   # outer (block) ; inner (LEAK)
} catch (e) { print("T29-ERR: " + e); }

# ============================================================
# T30: for 变量遮蔽已存在全局 — 循环内修改 for 变量是否影响外层
# 块作用域语言: 外层 i=100
# H#: i 被覆盖, 循环内 i=99 不影响迭代 (迭代器覆盖), 循环后 i=3
# ============================================================
print("=== T30 for-var shadow + modify in body ===");
try {
    let i = 100;
    for i in [1, 2, 3] {
        print("T30-iter: " + i);   # 1, 2, 3
        i = 99;   # 修改循环变量 — 是否影响下次迭代?
    }
    print("T30-after: " + i);   # 100 (block) ; 3 或 99 (LEAK)
} catch (e) { print("T30-ERR: " + e); }

# ============================================================
# T31: while 循环变量 i 与块内 let i 同名
# 块作用域语言: 块内 i 独立, 外层 i 控制循环
# H#: 块内 let i 覆盖循环变量 i, 可能死循环或 i 被破坏
# ============================================================
print("=== T31 while + inner let same name ===");
try {
    let i = 0;
    while (i < 3) {
        let i = 99;   # 遮蔽外层 i — 块作用域应独立
        print("T31-inner: " + i);   # 99
        # 外层 i 需递增 — 但外层 i 在块内不可直接访问 (被遮蔽)
        # 用单独的计数器
        break;   # 避免死循环
    }
    print("T31-after: " + i);   # 0 (break) ; 99 (LEAK)
} catch (e) { print("T31-ERR: " + e); }

# ============================================================
# T32: 函数参数与 catch 变量同名 — catch 是否污染参数
# 块作用域语言: 参数 p 保持 orig-param
# H#: catch p 覆盖参数, return p = exc-val (LEAK)
# ============================================================
print("=== T32 catch-var shadows param ===");
try {
    fn tester32(p) {
        try {
            throw "exc-val";
        } catch (p) {
            print("T32-in-catch: " + p);   # exc-val
        }
        return p;   # orig-param (block) ; exc-val (LEAK)
    }
    print("T32: " + tester32("orig-param"));
} catch (e) { print("T32-ERR: " + e); }

# ============================================================
# T33: 闭包捕获 for 变量后修改 — 闭包内修改 i 是否影响迭代
# ============================================================
print("=== T33 closure modifies loop var ===");
try {
    let log = [];
    for i in [0, 1, 2] {
        push(log, i);
        let bump = fn() { i = i + 10; return i; };
        bump();   # 闭包修改 i — 是否影响下次迭代?
    }
    print("T33: " + log);   # [0,1,2] (迭代独立) 或 [0,11,22] (共享)
} catch (e) { print("T33-ERR: " + e); }

# ============================================================
# T34: 块内 let 后, 外层再赋值 — 块内值是否影响外层赋值
# ============================================================
print("=== T34 block let then outer assign ===");
try {
    let x = 1;
    if (true) {
        let x = 2;
        print("T34-inner: " + x);   # 2
    }
    x = 3;   # 外层赋值
    print("T34-outer: " + x);   # 3 (外层独立赋值) ; 若 LEAK 则 x 已是 2, 再赋 3
} catch (e) { print("T34-ERR: " + e); }

# ============================================================
# T35: for 循环变量在 catch 中使用 — catch 后 for 变量是否恢复
# ============================================================
print("=== T35 for-var in nested try-catch ===");
try {
    for i in [1, 2, 3] {
        try {
            if (i == 2) { throw "stop"; }
        } catch (e) {
            print("T35-catch: i=" + i + ", e=" + e);   # i=2, e=stop
        }
    }
    print("T35-after: " + i);   # 3 (LEAK) ; ERR (block)
} catch (e) { print("T35-ERR: " + e); }

# ============================================================
# T36: 嵌套函数同名 — 内层 fn 与外层 fn 同名
# 预期: 内层遮蔽外层, 外层不变
# ============================================================
print("=== T36 nested fn same name ===");
try {
    fn helper() { return "outer"; }
    fn outer36() {
        fn helper() { return "inner"; }
        return helper();
    }
    print("T36-inner: " + outer36());   # inner
    print("T36-outer: " + helper());    # outer (内层不影响外层)
} catch (e) { print("T36-ERR: " + e); }

# ============================================================
# T37: 闭包捕获参数后, 外层再声明同名 let — 闭包看到哪个?
# ============================================================
print("=== T37 closure capture param then let ===");
try {
    fn f37(x) {
        let g = fn() { return x; };
        let x = 999;   # let 覆盖参数 x — 闭包看到哪个?
        return g();
    }
    print("T37: " + f37(5));   # 5 (capture 前值) ; 999 (LEAK/覆盖, by-ref)
} catch (e) { print("T37-ERR: " + e); }

# ============================================================
# T38: match 绑定变量 n 在多个 match 语句 — 绑定是否泄漏并覆盖
# ============================================================
print("=== T38 match binding across statements ===");
try {
    let x = 1;
    match x {
        n => "one-" + n
    };
    print("T38-after1: " + n);   # 1 (LEAK)
    let y = 2;
    match y {
        n => "two-" + n
    };
    print("T38-after2: " + n);   # 2 (LEAK, 覆盖) ; ERR (block)
} catch (e) { print("T38-ERR: " + e); }

# ============================================================
# T39: 全局 let 在函数内 let 同名 — 函数内是否影响全局
# 预期: 全局保持 1 (函数内 let 独立作用域)
# ============================================================
print("=== T39 fn let shadows global ===");
try {
    let g39 = 1;
    fn f39() {
        let g39 = 2;
        print("T39-inner: " + g39);   # 2
    }
    f39();
    print("T39-outer: " + g39);   # 1 (函数内 let 不影响全局)
} catch (e) { print("T39-ERR: " + e); }

# ============================================================
# T40: 多个 catch 嵌套 — 内层 catch 变量与外层 catch 变量同名
# 块作用域语言: 各自独立
# H#: 内层 catch 覆盖外层 catch 变量
# ============================================================
print("=== T40 nested catch same var ===");
try {
    try {
        try {
            throw "inner-msg";
        } catch (e) {
            print("T40-inner-catch: " + e);   # inner-msg
        }
        print("T40-after-inner: " + e);   # inner-msg (LEAK) ; ERR
    } catch (e) {
        print("T40-outer-catch: " + e);
    }
} catch (e) { print("T40-ERR: " + e); }

# ============================================================
# T41: for 变量与外层 let 同名, 循环内闭包捕获
# 块作用域语言: 闭包捕获 for 变量 (per-iter)
# H#: for 覆盖外层, 闭包捕获
# ============================================================
print("=== T41 for-var shadow + closure ===");
try {
    let i = 100;
    let fns = [];
    for i in [1, 2, 3] {
        push(fns, fn() { return i; });
    }
    print("T41-fn0: " + fns[0]());   # 1
    print("T41-fn1: " + fns[1]());   # 2
    print("T41-fn2: " + fns[2]());   # 3
    print("T41-outer: " + i);   # 100 (block) ; 3 (LEAK)
} catch (e) { print("T41-ERR: " + e); }

# ============================================================
# T42: 块内 let 覆盖函数参数 — 块外参数是否恢复
# 块作用域语言: 块外参数恢复
# H#: 块内 let 覆盖参数, 块外参数 = 块内值 (LEAK)
# ============================================================
print("=== T42 block let shadows param ===");
try {
    fn f42(p) {
        if (true) {
            let p = 999;
            print("T42-inner: " + p);   # 999
        }
        return p;   # orig (block) ; 999 (LEAK)
    }
    print("T42: " + f42(5));   # 5 (block) ; 999 (LEAK)
} catch (e) { print("T42-ERR: " + e); }

# ============================================================
# T43: 重复 for 循环同一变量名 — 第二次循环 i 是否被重置
# ============================================================
print("=== T43 repeated for same var ===");
try {
    for i in [1, 2, 3] {
        print("T43-first: " + i);   # 1, 2, 3
    }
    print("T43-between: " + i);   # 3 (LEAK)
    for i in [10, 20, 30] {
        print("T43-second: " + i);   # 10, 20, 30
    }
    print("T43-after: " + i);   # 30 (LEAK)
} catch (e) { print("T43-ERR: " + e); }

# ============================================================
# T44: while 条件中的变量与 body 内 let 同名 — 条件求值与 body 作用域
# ============================================================
print("=== T44 while cond vs body let ===");
try {
    let i = 0;
    while (i < 2) {
        print("T44-cond-i: " + i);   # 0, 1
        let i = 99;   # 遮蔽 — 块作用域应不影响条件 i
        print("T44-body-i: " + i);   # 99
        # 手动递增外层 i — 但被遮蔽, 用临时
        break;   # 避免死循环
    }
    print("T44-after: " + i);   # 0 (break) ; 99 (LEAK)
} catch (e) { print("T44-ERR: " + e); }

# ============================================================
# T45: 函数内 catch 变量泄漏到函数 return — return 是否返回 catch 值
# ============================================================
print("=== T45 catch leak affects return ===");
try {
    fn f45() {
        let r = "init";
        try {
            throw "boom";
        } catch (r) {
            print("T45-catch: " + r);   # boom
        }
        return r;   # init (block) ; boom (LEAK)
    }
    print("T45: " + f45());   # init ; boom (LEAK)
} catch (e) { print("T45-ERR: " + e); }

# ============================================================
# T46: if 块内 let 与外层函数参数同名 — 块外参数
# ============================================================
print("=== T46 if-block let shadows param ===");
try {
    fn f46(a) {
        if (true) {
            let a = "shadowed";
            print("T46-inner: " + a);   # shadowed
        }
        return a;   # orig (block) ; shadowed (LEAK)
    }
    print("T46: " + f46("orig"));   # orig ; shadowed (LEAK)
} catch (e) { print("T46-ERR: " + e); }

# ============================================================
# T47: 嵌套 for — 外层循环变量在内层循环体内可见 (正常词法嵌套)
# 预期: 可见 (这是正常的, 非泄漏)
# ============================================================
print("=== T47 nested for outer visible in inner ===");
try {
    let pairs = [];
    for i in [1, 2] {
        for j in [10, 20] {
            push(pairs, i * 100 + j);
        }
    }
    print("T47: " + pairs);   # [110, 120, 210, 220]
} catch (e) { print("T47-ERR: " + e); }

# ============================================================
# T48: for 变量在循环体内被 let 重新声明 — 是否覆盖循环变量
# ============================================================
print("=== T48 for-var redeclared in body ===");
try {
    let log = [];
    for i in [1, 2, 3] {
        push(log, i);   # 1, 2, 3 (循环变量值)
        let i = 99;     # 重新声明 — 块作用域应独立
        push(log, i);   # 99
    }
    print("T48: " + log);   # [1, 99, 2, 99, 3, 99]
} catch (e) { print("T48-ERR: " + e); }

# ============================================================
# T49: 全局函数与 catch 变量同名 — catch 后函数是否可调用
# ============================================================
print("=== T49 catch-var shadows function ===");
try {
    fn bar() { return "fn-bar"; }
    print("T49-pre: " + bar());   # fn-bar
    try {
        throw "caught";
    } catch (bar) {
        print("T49-in-catch: " + bar);   # caught
    }
    print("T49-after: " + bar);   # fn-bar (block) ; caught (LEAK)
    print("T49-call: " + bar());   # fn-bar ; ERR (bar 是字符串)
} catch (e) { print("T49-ERR: " + e); }

# ============================================================
# T50: 块内 let 后, 同块内再次 let 同名 — 两次 let 在同一块
# ============================================================
print("=== T50 double let same block ===");
try {
    if (true) {
        let z = 1;
        let z = 2;
        print("T50: " + z);   # 2 (覆盖) ; ERR (block)
    }
} catch (e) { print("T50-ERR: " + e); }

print("=== ALL DONE ===");
