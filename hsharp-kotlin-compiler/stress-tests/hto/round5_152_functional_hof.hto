# round5_152_functional_hof.hto — 测试智能体 #152
# 领域: 高阶函数与函数式编程 (Higher-Order Functions & Functional Programming)
# H# v0.4.1
#
# 覆盖 15 个子领域:
#   S1  函数作为参数        S2  函数作为返回值
#   S3  map 实现           S4  filter 实现
#   S5  reduce/fold        S6  currying
#   S7  partial application S8  函数组合
#   S9  匿名函数           S10 闭包捕获
#   S11 闭包修改(snapshot vs reference)  S12 递归 lambda
#   S13 Y 组合子           S14 高阶函数链
#   S15 函数相等
#
# 测试方法:
#   - 每个用例独立 try/catch, 打印 "Sxx-Cn:" 前缀, 预期 Python 语义在注释
#   - 针对 snapshot/cell-sharing/lambda-eq 等已知 bug 设计探针
#   - 所有用例预期值以 Python 3 语义为准

# ============================================================
# 顶层辅助函数 (供按名传递使用)
# ============================================================
fn double(x) { return x * 2; }
fn inc(x) { return x + 1; }
fn sq(x) { return x * x; }
fn addTop(a, b) { return a + b; }
fn subTop(a, b) { return a - b; }
fn isEven(n) { return n % 2 == 0; }

print("=== S1: function as argument ===");

# S1-C1: 单函数参数 apply(f, x) — 预期 10, hi!, 49
try {
    fn apply(f, x) { return f(x); }
    print("S1-C1: " + apply(double, 5));
    print("S1-C1: " + apply(fn(s) { return s + "!"; }, "hi"));
    print("S1-C1: " + apply(sq, 7));
} catch (e) { print("S1-C1-ERR: " + e); }

# S1-C2: 多个函数参数 — combine(f, g, x) = f(g(x)) — 预期 11, 26
try {
    fn combine(f, g, x) { return f(g(x)); }
    print("S1-C2: " + combine(inc, double, 5));      # 1 + 2*5 = 11
    print("S1-C2: " + combine(double, inc, 12));     # 2*(12+1) = 26
} catch (e) { print("S1-C2-ERR: " + e); }

# S1-C3: 函数参数 + 普通参数混合 — 预期 90, 7
try {
    fn withFactor(f, n, k) { return f(n) * k; }
    print("S1-C3: " + withFactor(sq, 3, 10));        # sq(3)=9, *k=10 => 90
    print("S1-C3: " + withFactor(inc, 6, 1));        # inc(6)=7, *1 = 7
} catch (e) { print("S1-C3-ERR: " + e); }

# S1-C4: 三个函数参数 — 预期 9
try {
    fn three(f, g, h, x) { return f(g(h(x))); }
    print("S1-C4: " + three(sq, inc, double, 1));    # sq(inc(double(1))) = sq(inc(2)) = sq(3) = 9
} catch (e) { print("S1-C4-ERR: " + e); }

print("=== S2: function as return value ===");

# S2-C1: factory 返回闭包 (let-lambda) — 预期 12, 100, 40
try {
    fn makeMul(k) {
        let f = fn(x) { return x * k; };
        return f;
    }
    let triple = makeMul(3);
    print("S2-C1: " + triple(4));          # 12
    print("S2-C1: " + makeMul(10)(10));    # 100
    print("S2-C1: " + makeMul(2)(20));     # 40
} catch (e) { print("S2-C1-ERR: " + e); }

# S2-C2: factory 返回闭包 (fn 语句嵌套) — 预期 7, 25
try {
    fn mkAdder(n) {
        fn add(x) { return x + n; }
        return add;
    }
    let add5 = mkAdder(5);
    print("S2-C2: " + add5(2));            # 7
    print("S2-C2: " + mkAdder(20)(5));     # 25
} catch (e) { print("S2-C2-ERR: " + e); }

# S2-C3: 立即调用返回的函数 f()() — 预期 42, 6
try {
    fn gen() {
        let inner = fn() { return 42; };
        return inner;
    }
    print("S2-C3: " + gen()());            # 42
    fn step1(x) {
        let inner = fn(y) { return x + y; };
        return inner;
    }
    print("S2-C3: " + step1(1)(5));        # 6
} catch (e) { print("S2-C3-ERR: " + e); }

# S2-C4: 返回函数链 f()()() (3层) — 预期 42, 60
try {
    fn deep() {
        let m = fn() {
            let i = fn() { return 42; };
            return i;
        };
        return m;
    }
    print("S2-C4: " + deep()()());         # 42
    fn curry3(a) {
        let m = fn(b) {
            let i = fn(c) { return a + b + c; };
            return i;
        };
        return m;
    }
    print("S2-C4: " + curry3(10)(20)(30)); # 60
} catch (e) { print("S2-C4-ERR: " + e); }

print("=== S3: map implementation ===");

# S3-C1: map 对 list — 预期 [2,4,6], [1,4,9]
try {
    fn map(f, lst) {
        let out = [];
        for x in lst { push(out, f(x)); }
        return out;
    }
    print("S3-C1: " + map(double, [1, 2, 3]));
    print("S3-C1: " + map(sq, [1, 2, 3]));
} catch (e) { print("S3-C1-ERR: " + e); }

# S3-C2: map 对 list 用匿名 lambda — 预期 [2,4,6,8,10], [11,12,13]
try {
    fn map2(f, lst) {
        let out = [];
        for x in lst { push(out, f(x)); }
        return out;
    }
    print("S3-C2: " + map2(fn(x) { return x * 2; }, [1, 2, 3, 4, 5]));
    print("S3-C2: " + map2(fn(x) { return x + 10; }, [1, 2, 3]));
} catch (e) { print("S3-C2-ERR: " + e); }

# S3-C3: map 对 dict.values (遍历) — 预期 [4,8,12]
try {
    fn mapVals(f, d) {
        let out = [];
        for k in d { push(out, f(d[k])); }
        return out;
    }
    let d = {"a": 2, "b": 4, "c": 6};
    print("S3-C3: " + mapVals(double, d));
} catch (e) { print("S3-C3-ERR: " + e); }

# S3-C4: map 对空 list — 预期 []
try {
    fn mapE(f, lst) {
        let out = [];
        for x in lst { push(out, f(x)); }
        return out;
    }
    print("S3-C4: " + mapE(double, []));
} catch (e) { print("S3-C4-ERR: " + e); }

print("=== S4: filter implementation ===");

# S4-C1: filter 偶数 — 预期 [2,4], [1,3,5]
try {
    fn filter(f, lst) {
        let out = [];
        for x in lst { if (f(x)) { push(out, x); } }
        return out;
    }
    print("S4-C1: " + filter(isEven, [1, 2, 3, 4]));
    print("S4-C1: " + filter(fn(x) { return x % 2 == 1; }, [1, 2, 3, 4, 5]));
} catch (e) { print("S4-C1-ERR: " + e); }

# S4-C2: filter 字符串长度 — 预期 [bbb, dddd], [a, cc]
try {
    fn filterS(f, lst) {
        let out = [];
        for x in lst { if (f(x)) { push(out, x); } }
        return out;
    }
    let words = ["a", "bbb", "cc", "dddd"];
    print("S4-C2: " + filterS(fn(s) { return len(s) > 2; }, words));
    print("S4-C2: " + filterS(fn(s) { return len(s) < 3; }, words));
} catch (e) { print("S4-C2-ERR: " + e); }

# S4-C3: filter 全部保留/全部过滤 — 预期 [1,2,3], []
try {
    fn filterA(f, lst) {
        let out = [];
        for x in lst { if (f(x)) { push(out, x); } }
        return out;
    }
    print("S4-C3: " + filterA(fn(x) { return x > 0; }, [1, 2, 3]));
    print("S4-C3: " + filterA(fn(x) { return x > 100; }, [1, 2, 3]));
} catch (e) { print("S4-C3-ERR: " + e); }

print("=== S5: reduce/fold ===");

# S5-C1: reduce 累加 — 预期 15, 0
try {
    fn reduce(f, lst, init) {
        let acc = init;
        for x in lst { acc = f(acc, x); }
        return acc;
    }
    print("S5-C1: " + reduce(addTop, [1, 2, 3, 4, 5], 0));
    print("S5-C1: " + reduce(addTop, [], 0));
} catch (e) { print("S5-C1-ERR: " + e); }

# S5-C2: reduce 累乘 — 预期 120, 1
try {
    fn reduce2(f, lst, init) {
        let acc = init;
        for x in lst { acc = f(acc, x); }
        return acc;
    }
    print("S5-C2: " + reduce2(fn(a, b) { return a * b; }, [1, 2, 3, 4, 5], 1));
    print("S5-C2: " + reduce2(fn(a, b) { return a * b; }, [], 1));
} catch (e) { print("S5-C2-ERR: " + e); }

# S5-C3: reduce 求最大值 — 预期 9
try {
    fn reduce3(f, lst, init) {
        let acc = init;
        for x in lst { acc = f(acc, x); }
        return acc;
    }
    print("S5-C3: " + reduce3(fn(a, b) { if (a > b) { return a; } return b; }, [3, 1, 4, 1, 5, 9, 2, 6], 0));
} catch (e) { print("S5-C3-ERR: " + e); }

# S5-C4: reduce 字符串拼接 — 预期 abcde
try {
    fn reduce4(f, lst, init) {
        let acc = init;
        for x in lst { acc = f(acc, x); }
        return acc;
    }
    print("S5-C4: " + reduce4(fn(a, b) { return a + b; }, ["a", "b", "c", "d", "e"], ""));
} catch (e) { print("S5-C4-ERR: " + e); }

# S5-C5: reduce 初始值非零 — 预期 1000 (100 + 900)
try {
    fn reduce5(f, lst, init) {
        let acc = init;
        for x in lst { acc = f(acc, x); }
        return acc;
    }
    print("S5-C5: " + reduce5(addTop, [100, 200, 300, 300], 100));  # 100+100+200+300+300=1000
} catch (e) { print("S5-C5-ERR: " + e); }

print("=== S6: currying ===");

# S6-C1: 手动柯里化 add(a)(b) — 预期 7, 15
try {
    fn add(a) {
        let inner = fn(b) { return a + b; };
        return inner;
    }
    print("S6-C1: " + add(3)(4));          # 7
    print("S6-C1: " + add(10)(5));         # 15
} catch (e) { print("S6-C1-ERR: " + e); }

# S6-C2: 3 层柯里化 (let-lambda) — 预期 6, 60
try {
    fn curry3(a) {
        let m = fn(b) {
            let i = fn(c) { return a + b + c; };
            return i;
        };
        return m;
    }
    print("S6-C2: " + curry3(1)(2)(3));    # 6
    print("S6-C2: " + curry3(10)(20)(30)); # 60
} catch (e) { print("S6-C2-ERR: " + e); }

# S6-C3: 柯里化乘法 — 预期 24
try {
    fn mul(a) {
        let m = fn(b) {
            let i = fn(c) { return a * b * c; };
            return i;
        };
        return m;
    }
    print("S6-C3: " + mul(2)(3)(4));       # 24
} catch (e) { print("S6-C3-ERR: " + e); }

# S6-C4: curry2 工厂 (任意二元函数转柯里化) — 预期 7, 7, 30
try {
    fn curry2(f) {
        let s1 = fn(a) {
            let s2 = fn(b) { return f(a, b); };
            return s2;
        };
        return s1;
    }
    print("S6-C4: " + curry2(addTop)(3)(4));    # 7
    print("S6-C4: " + curry2(subTop)(10)(3));   # 7
    fn mul(a, b) { return a * b; }
    print("S6-C4: " + curry2(mul)(5)(6));       # 30
} catch (e) { print("S6-C4-ERR: " + e); }

print("=== S7: partial application ===");

# S7-C1: partial(f, a) 固定首参 — 预期 3, PRE-FIX, 100
try {
    fn partial(f, a) {
        let bound = fn(b) { return f(a, b); };
        return bound;
    }
    let minus5 = partial(subTop, 5);
    print("S7-C1: " + minus5(2));          # 5-2=3
    fn cat(a, b) { return a + "-" + b; }
    let prepend = partial(cat, "PRE");
    print("S7-C1: " + prepend("FIX"));     # PRE-FIX
    let add100 = partial(addTop, 100);
    print("S7-C1: " + add100(0));          # 100
} catch (e) { print("S7-C1-ERR: " + e); }

# S7-C2: partial 三元函数固定首参 — 预期 16
try {
    fn partial3(f, a) {
        let bound = fn(b, c) { return f(a, b, c); };
        return bound;
    }
    fn add3(a, b, c) { return a + b + c; }
    let p = partial3(add3, 10);
    print("S7-C2: " + p(3, 3));            # 10+3+3=16
} catch (e) { print("S7-C2-ERR: " + e); }

# S7-C3: 双重 partial — 预期 6
try {
    fn partial(f, a) {
        let bound = fn(b) { return f(a, b); };
        return bound;
    }
    fn add3(a, b, c) { return a + b + c; }
    fn partial3to2(f, a) {
        let bound = fn(b, c) { return f(a, b, c); };
        return bound;
    }
    let p1 = partial3to2(add3, 1);         # fn(b,c) => 1+b+c
    # 再 partial 固定 b
    let p2 = partial(p1, 2);               # fn(c) => 1+2+c
    print("S7-C3: " + p2(3));              # 6
} catch (e) { print("S7-C3-ERR: " + e); }

print("=== S8: function composition ===");

# S8-C1: compose(f, g)(x) = f(g(x)) — 预期 7, 22
try {
    fn compose(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    print("S8-C1: " + compose(inc, double)(3));    # 1+2*3=7
    print("S8-C1: " + compose(double, inc)(10));   # 2*(10+1)=22
} catch (e) { print("S8-C1-ERR: " + e); }

# S8-C2: 嵌套 compose — 预期 13
try {
    fn compose(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    let c3 = compose(inc, compose(double, inc));  # inc(double(inc(x)))
    print("S8-C2: " + c3(5));               # 1+2*(5+1)=13
} catch (e) { print("S8-C2-ERR: " + e); }

# S8-C3: 5 层 compose — 预期 7, 11
try {
    fn compose(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    let c1 = compose(inc, double);
    let c2 = compose(c1, inc);
    let c3 = compose(c2, double);
    let c4 = compose(c3, inc);
    print("S8-C3: " + c4(0));              # inc(0)=1,double=2,inc=3,double=6,inc=7
    print("S8-C3: " + c4(1));              # inc=2,double=4,inc=5,double=10,inc=11
} catch (e) { print("S8-C3-ERR: " + e); }

# S8-C4: compose 字符串函数 — 预期 UPPER!, !UPPER
try {
    fn compose(f, g) {
        let h = fn(x) { return f(g(x)); };
        return h;
    }
    fn up(s) { return s + "UPPER"; }
    fn bang(s) { return s + "!"; }
    print("S8-C4: " + compose(bang, up)(""));     # UPPER!
    print("S8-C4: " + compose(up, bang)(""));     # !UPPER
} catch (e) { print("S8-C4-ERR: " + e); }

print("=== S9: anonymous function ===");

# S9-C1: 匿名 lambda 直接调用 (IIFE) — 预期 1, 7, 36
try {
    print("S9-C1: " + (fn() { return 1; })());
    print("S9-C1: " + (fn(a, b) { return a + b; })(3, 4));
    let v = (fn(n) { return n * n; })(6);
    print("S9-C1: " + v);
} catch (e) { print("S9-C1-ERR: " + e); }

# S9-C2: 匿名 lambda 作为 HOF 参数 — 预期 [2,4,6]
try {
    fn map(f, lst) {
        let out = [];
        for x in lst { push(out, f(x)); }
        return out;
    }
    print("S9-C2: " + map(fn(x) { return x * 2; }, [1, 2, 3]));
} catch (e) { print("S9-C2-ERR: " + e); }

# S9-C3: 匿名 lambda 存入 list/dict — 预期 1,2,3, 6
try {
    let fns = [fn() { return 1; }, fn() { return 2; }, fn() { return 3; }];
    print("S9-C3: " + fns[0]());
    print("S9-C3: " + fns[1]());
    print("S9-C3: " + fns[2]());
    let total = 0;
    for f in fns { total = total + f(); }
    print("S9-C3: " + total);
} catch (e) { print("S9-C3-ERR: " + e); }

# S9-C4: 匿名 lambda dict 值 — 预期 11, 9, 25
try {
    let ops = {
        "inc": fn(x) { return x + 1; },
        "dec": fn(x) { return x - 1; },
        "sq":  fn(x) { return x * x; }
    };
    print("S9-C4: " + ops["inc"](10));
    print("S9-C4: " + ops["dec"](10));
    print("S9-C4: " + ops["sq"](5));
} catch (e) { print("S9-C4-ERR: " + e); }

print("=== S10: closure capture ===");

# S10-C1: 捕获外层参数 (读) — 预期 8, 13
try {
    fn makeAdder(x) {
        let f = fn(y) { return x + y; };
        return f;
    }
    print("S10-C1: " + makeAdder(5)(3));    # 8
    print("S10-C1: " + makeAdder(10)(3));   # 13
} catch (e) { print("S10-C1-ERR: " + e); }

# S10-C2: 捕获外层 let (读) — 预期 100
try {
    fn mk() {
        let v = 100;
        let f = fn() { return v; };
        return f;
    }
    print("S10-C2: " + mk()());             # 100
} catch (e) { print("S10-C2-ERR: " + e); }

# S10-C3: 多层捕获 (3层 let-lambda) — 预期 6, 60
try {
    fn outer(a) {
        let mid = fn(b) {
            let inner = fn(c) { return a + b + c; };
            return inner;
        };
        return mid;
    }
    print("S10-C3: " + outer(1)(2)(3));     # 6
    print("S10-C3: " + outer(10)(20)(30));  # 60
} catch (e) { print("S10-C3-ERR: " + e); }

# S10-C4: 捕获循环变量 (经典 bug 探针) — Python: 1,2,3 ; 错误: 3,3,3
try {
    let fns = [];
    for i in [1, 2, 3] {
        push(fns, fn() { return i; });
    }
    print("S10-C4: " + fns[0]());
    print("S10-C4: " + fns[1]());
    print("S10-C4: " + fns[2]());
} catch (e) { print("S10-C4-ERR: " + e); }

# S10-C5: 捕获循环变量 (range 形式) — Python: 0,1,2 ; 错误: 2,2,2
try {
    let fns = [];
    for i in range(0, 3) {
        push(fns, fn() { return i; });
    }
    print("S10-C5: " + fns[0]());
    print("S10-C5: " + fns[1]());
    print("S10-C5: " + fns[2]());
} catch (e) { print("S10-C5-ERR: " + e); }

# S10-C6: 模块级 let 捕获 + 外层重赋值 (by-ref 探针)
# Python: 10, 20, 20 ; snapshot bug: 10, 20, 10
try {
    let gx = 10;
    let gf = fn() { return gx; };
    print("S10-C6: " + gf());               # 10
    gx = 20;
    print("S10-C6: " + gx);                 # 20
    print("S10-C6: " + gf());               # 20 (by-ref) or 10 (snapshot)
} catch (e) { print("S10-C6-ERR: " + e); }

# S10-C7: 捕获函数参数, 然后修改参数 (by-ref 探针)
# Python: 100 ; snapshot bug: 1
try {
    fn capThenMod(a) {
        let g = fn() { return a; };
        a = 100;
        return g();
    }
    print("S10-C7: " + capThenMod(1));      # 100 (by-ref) or 1 (snapshot)
} catch (e) { print("S10-C7-ERR: " + e); }

print("=== S11: closure mutation (snapshot vs reference) ===");

# S11-C1: 闭包内修改捕获变量 (计数器) — Python: 1,2,3
try {
    fn mkCounter() {
        let n = 0;
        let inc = fn() { n = n + 1; return n; };
        return inc;
    }
    let c = mkCounter();
    print("S11-C1: " + c());               # 1
    print("S11-C1: " + c());               # 2
    print("S11-C1: " + c());               # 3
} catch (e) { print("S11-C1-ERR: " + e); }

# S11-C2: 多闭包共享同一变量 (cell-sharing 探针)
# Python: inc=1, inc=2, inc=3, get=3 (共享 cell)
# 独立 cell bug: get=0
try {
    fn makePair() {
        let n = 0;
        let inc = fn() { n = n + 1; return n; };
        let get = fn() { return n; };
        return [inc, get];
    }
    let p = makePair();
    let incF = p[0];
    let getF = p[1];
    print("S11-C2: " + incF());            # 1
    print("S11-C2: " + incF());            # 2
    print("S11-C2: " + incF());            # 3
    print("S11-C2: " + getF());            # 3 (shared) or 0 (independent cell)
} catch (e) { print("S11-C2-ERR: " + e); }

# S11-C3: 模块级 let + 闭包修改 (by-ref 探针)
# Python: 0, 99, 99, 99 ; snapshot bug: 0, 99, 0, 0
try {
    let captured = 0;
    let getCaptured = fn() { return captured; };
    print("S11-C3: " + getCaptured());     # 0
    captured = 99;
    print("S11-C3: " + captured);          # 99
    print("S11-C3: " + getCaptured());     # 99 (by-ref) or 0 (snapshot)
    captured = 200;
    print("S11-C3: " + getCaptured());     # 200 (by-ref) or 0 (snapshot)
} catch (e) { print("S11-C3-ERR: " + e); }

# S11-C4: 闭包内修改捕获变量, 外层读取 (cell-sharing 探针)
# Python: n=5 (inc 修改后外层可见)
# 独立 cell bug: n=0
try {
    fn mkBag() {
        let n = 0;
        let inc = fn() { n = n + 5; return n; };
        inc();
        return n;                          # 外层读取被闭包修改的变量
    }
    print("S11-C4: " + mkBag());          # 5 (shared) or 0 (independent cell)
} catch (e) { print("S11-C4-ERR: " + e); }

# S11-C5: 两个独立 factory 实例的闭包隔离 — Python: 1, 1, 2, 2
try {
    fn mkCounter() {
        let n = 0;
        let inc = fn() { n = n + 1; return n; };
        return inc;
    }
    let c1 = mkCounter();
    let c2 = mkCounter();
    print("S11-C5: " + c1());             # 1
    print("S11-C5: " + c2());             # 1
    print("S11-C5: " + c1());             # 2
    print("S11-C5: " + c2());             # 2
} catch (e) { print("S11-C5-ERR: " + e); }

# S11-C6: dict of fns 共享变量 (对象方法模拟)
# Python: get=10, add=15, get=15, set=100, get=100 (共享 x)
# 独立 cell bug: get=10, add=15, get=10, set=100, get=10
try {
    fn makeObj(x) {
        return {
            "get": fn() { return x; },
            "set": fn(v) { x = v; return x; },
            "add": fn(d) { x = x + d; return x; }
        };
    }
    let o = makeObj(10);
    print("S11-C6: " + o["get"]());       # 10
    print("S11-C6: " + o["add"](5));      # 15 (shared) or 15 (独立cell也返回15,因为add改自己cell)
    print("S11-C6: " + o["get"]());       # 15 (shared) or 10 (独立cell)
    print("S11-C6: " + o["set"](100));    # 100
    print("S11-C6: " + o["get"]());       # 100 (shared) or 10 (独立cell)
} catch (e) { print("S11-C6-ERR: " + e); }

# S11-C7: 闭包计数器经 HOF 传递 — Python: 1,2,3
try {
    fn mkCounter() {
        let n = 0;
        let inc = fn() { n = n + 1; return n; };
        return inc;
    }
    let c = mkCounter();
    fn apply0(f) { return f(); }
    print("S11-C7: " + apply0(c));        # 1
    print("S11-C7: " + apply0(c));        # 2
    print("S11-C7: " + apply0(c));        # 3
} catch (e) { print("S11-C7-ERR: " + e); }

# S11-C8: withCount 计数探针 (闭包内修改 + 另一闭包读取)
# Python: calls=3 ; 独立 cell bug: calls=0
try {
    fn slow(x) { return x * x; }
    fn memoize(f) {
        let cache = {};
        let calls = 0;
        let wrapped = fn(n) {
            let key = "" + n;
            if (has_key(cache, key)) { return cache[key]; }
            calls = calls + 1;
            let v = f(n);
            cache[key] = v;
            return v;
        };
        let getCalls = fn() { return calls; };
        return [wrapped, getCalls];
    }
    let mp = memoize(slow);
    let mf = mp[0];
    let gc = mp[1];
    mf(3); mf(3); mf(4); mf(5);
    print("S11-C8: " + gc());             # 3 (shared) or 0 (独立cell)
} catch (e) { print("S11-C8-ERR: " + e); }

print("=== S12: recursive lambda ===");

# S12-C1: let-lambda 递归 fact — Python: 1, 120, 3628800
try {
    let fact = fn(n) {
        if (n <= 1) { return 1; }
        return n * fact(n - 1);
    };
    print("S12-C1: " + fact(1));           # 1
    print("S12-C1: " + fact(5));           # 120
    print("S12-C1: " + fact(10));          # 3628800
} catch (e) { print("S12-C1-ERR: " + e); }

# S12-C2: let-lambda 递归 fib — Python: 55, 6765
try {
