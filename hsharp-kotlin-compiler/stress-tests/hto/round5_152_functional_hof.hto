        if (n < 2) { return n; }
        return fib(n - 1) + fib(n - 2);
    };
    print("S12-C2: " + fib(10));           # 55
    print("S12-C2: " + fib(20));           # 6765
} catch (e) { print("S12-C2-ERR: " + e); }

# S12-C3: let-lambda 递归 + 闭包捕获外层变量
