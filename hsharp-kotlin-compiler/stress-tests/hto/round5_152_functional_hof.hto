    let l2 = fn() { return 1; };
    let l3 = l1;
    print("S15-C2 l1==l1: " + (l1 == l1)); # true
    print("S15-C2 l1==l2: " + (l1 == l2)); # false (引用相等) or true (结构相等 bug)
    print("S15-C2 l1==l3: " + (l1 == l3)); # true
} catch (e) { print("S15-C2-ERR: " + e); }

