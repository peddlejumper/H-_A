# 独立 cell bug: total=0
try {
    fn makeSumFact() {
        let total = 0;
        let fact = fn(n) {
            if (n <= 1) { return 1; }
            return n * fact(n - 1);
        };
        total = fact(5);
        return total;
    }
    print("S12-C3: " + makeSumFact());     # 120
} catch (e) { print("S12-C3-ERR: " + e); }

# S12-C4: lambda 递归经 HOF 传递 — Python: 120
