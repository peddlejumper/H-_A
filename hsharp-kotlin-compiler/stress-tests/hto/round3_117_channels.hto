          "s1=" + str(s1) + " s2=" + str(s2) + " s3=" + str(s3));
} catch (e) {
    check("T31_no_throw", false, "threw: " + str(e));
}

# ============================================================
# T32: parallel fn 内多次 chan_send + 主线程并发 recv (交错)
#   预期: 主线程 recv 到的总数 = worker send 的总数
# ============================================================
parallel fn t32_burst(ch, n) {
    let i = 0;
    while (i < n) { chan_send(ch, i); i = i + 1; }
    return n;
}
print("=== T32 burst send concurrent recv ===");
try {
    let ch = chan_new(0);
    let f = t32_burst(ch, 100);
    let sum = 0;
    let count = 0;
    while (count < 100) {
        sum = sum + chan_recv(ch);
        count = count + 1;
    }
    let r = await f;
    check("T32a_burst_count", count == 100, "count=" + str(count));
    check("T32b_burst_sum", sum == 4950, "sum=" + str(sum));
    check("T32c_burst_worker_return", r == 100, "r=" + str(r));
} catch (e) {
    check("T32_no_throw", false, "threw: " + str(e));
}

# ============================================================
# T33: channel 传递 class 实例后调用方法 (引用语义)
#   预期: 接收到的实例可调用方法, 修改对发送方可见 (共享引用)
# ============================================================
class Counter {
    fn __init__(self, start) {
        self.n = start;
    }
    fn bump(self) {
        self.n = self.n + 1;
        return self.n;
    }
    fn get(self) {
        return self.n;
    }
}
print("=== T33 class instance through channel (shared ref) ===");
try {
    let ch = chan_new(1);
    let c = new Counter(100);
    chan_send(ch, c);
    let got = chan_recv(ch);
    let r1 = got.bump();
    check("T33a_method_after_chan", r1 == 101, "r1=" + str(r1));
    # 共享引用: 原对象也应被修改
    check("T33b_shared_reference", c.get() == 101, "orig=" + str(c.get()));
    got.bump();
    check("T33c_shared_after_second", c.get() == 102, "orig=" + str(c.get()));
} catch (e) {
    check("T33_no_throw", false, "threw: " + str(e));
}

# ============================================================
# T34: try_send 在无界 channel 上总是 true (除非 closed)
# ============================================================
print("=== T34 try_send on unbounded ===");
try {
    let ch = chan_new(0);
    let i = 0;
    let all_ok = true;
    while (i < 100) {
        if (chan_try_send(ch, i) != true) { all_ok = false; }
        i = i + 1;
    }
    check("T34a_try_send_unbounded_all_true", all_ok, "some false");
    check("T34b_size_100", chan_size(ch) == 100, "size=" + str(chan_size(ch)));
    chan_close(ch);
    let threw = "no-throw";
    try { chan_try_send(ch, 999); } catch (e) { threw = "caught"; }
    check("T34c_try_send_closed_throws", threw == "caught", "threw=" + threw);
} catch (e) {
    check("T34_no_throw", false, "threw: " + str(e));
}

# ============================================================
# T35: 双重确认 — close 后 send 抛, 但 try_recv 在 drained 前仍可拿值
#   预期: close 后 try_recv 拿到缓冲值, send 抛, drained 后 try_recv 返回 null
# ============================================================
print("=== T35 close then try_recv vs send ===");
try {
    let ch = chan_new(2);
    chan_send(ch, "x");
    chan_send(ch, "y");
    chan_close(ch);
    # close 后 send 应抛
    let send_threw = "no-throw";
    try { chan_send(ch, "z"); } catch (e) { send_threw = "caught"; }
    check("T35a_send_after_close_throws", send_threw == "caught", "threw=" + send_threw);
    # try_recv 仍可拿缓冲值
    let r1 = chan_try_recv(ch);
    let r2 = chan_try_recv(ch);
    check("T35b_try_recv_after_close_1", r1 == "x", "r1=" + str(r1));
    check("T35c_try_recv_after_close_2", r2 == "y", "r2=" + str(r2));
    # drained 后 try_recv 返回 null (不抛)
    let r3 = chan_try_recv(ch);
    check("T35d_try_recv_drained_null", r3 == null, "r3=" + str(r3));
} catch (e) {
    check("T35_no_throw", false, "threw: " + str(e));
}

