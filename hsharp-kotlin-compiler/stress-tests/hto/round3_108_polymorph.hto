class A25 { }
class B25 extends A25 { }
try { print("r108_25a_type_subclass:" + str(type(new B25()))); } catch (e) { print("r108_25a_type_subclass:EXC[" + str(e) + "]"); }
try { print("r108_25b_type_parent:" + str(type(new A25()))); } catch (e) { print("r108_25b_type_parent:EXC[" + str(e) + "]"); }

