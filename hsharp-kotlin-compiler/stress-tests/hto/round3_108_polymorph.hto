    let x = 1;
    let y = 2;
}
class B28b extends A28b {
    let z = 3;
}
try { let b = new B28b(); print("r108_28b_default_field_init:" + str(b.x) + "," + str(b.y) + "," + str(b.z)); } catch (e) { print("r108_28b_default_field_init:EXC[" + str(e) + "]"); }

# ============================================================
# 29. 多态分派: 通过函数参数传递子类实例
