# ============================================================
# 47. 接口默认方法调用另一接口方法 (self 分派)
# ============================================================
interface ICounter47 {
    fn base();
    fn inc();
    fn describe() {
        return self.base() + "+" + self.inc();
    }
}
class C47 implements ICounter47 {
    fn base() { return 10; }
    fn inc() { return 5; }
}
try { let c = new C47(); print("r108_47_iface_default_calls_self:" + str(c.describe())); } catch (e) { print("r108_47_iface_default_calls_self:EXC[" + str(e) + "]"); }

# ============================================================
# 48. 子类不覆盖接口默认方法, 但覆盖它调用的方法
# ============================================================
interface IBase48 {
    fn tag();
    fn log() {
        return "tag=" + self.tag();
    }
}
class C48 implements IBase48 {
    fn tag() { return "T1"; }
}
class D48 extends C48 {
    fn tag() { return "T2"; }
}
try { let d = new D48(); print("r108_48_default_method_dispatch:" + str(d.log())); } catch (e) { print("r108_48_default_method_dispatch:EXC[" + str(e) + "]"); }

