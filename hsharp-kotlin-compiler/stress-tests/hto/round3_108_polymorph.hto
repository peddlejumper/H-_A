class C26 extends B26 {
    fn m() { return "C.m+[" + super.m() + "]"; }
}
try { print("r108_26_super_access_parent:" + str((new C26()).m())); } catch (e) { print("r108_26_super_access_parent:EXC[" + str(e) + "]"); }

# ============================================================
# 27. 方法覆盖 vs 字段遮蔽: 同名方法 vs 同名字段
# ============================================================
class A27 {
    let v = "field-A";
    fn v() { return "method-A"; }
}
try { let a = new A27(); print("r108_27a_method_field_same_name:" + str(a.v)); } catch (e) { print("r108_27a_method_field_same_name:EXC[" + str(e) + "]"); }

class A27b {
    let v = "field-A";
    fn getV() { return v; }
}
class B27b extends A27b {
    fn v() { return "method-B"; }
}
try { let b = new B27b(); print("r108_27b_field_in_parent_method_in_child:" + str(b.v) + "|" + str(b.getV())); } catch (e) { print("r108_27b_field_in_parent_method_in_child:EXC[" + str(e) + "]"); }

# ============================================================
# 28. new 时字段初始化顺序: 父类字段先还是子类字段先
# ============================================================
class A28 {
    let order = [];
    let a = 1;
    fn init() {
        push(self.order, "A");
        self.a = 100;
    }
}
class B28 extends A28 {
    let b = 2;
    fn init() {
        push(self.order, "B(before-super)");
        super.init();
        push(self.order, "B(after-super)");
        self.b = 200;
    }
}
try { let b = new B28(); print("r108_28_field_init_order:" + str(b.a) + "," + str(b.b) + "," + str(b.order)); } catch (e) { print("r108_28_field_init_order:EXC[" + str(e) + "]"); }

