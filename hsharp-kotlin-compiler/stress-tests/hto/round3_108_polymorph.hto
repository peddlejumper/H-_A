# ============================================================
# 30. 多层接口继承 (3 层)
# ============================================================
interface IBase30 { fn baseM(); }
interface IMid30 extends IBase30 { fn midM(); }
interface ITop30 extends IMid30 { fn topM(); }
class Impl30 implements ITop30 {
    fn baseM() { return "base"; }
    fn midM() { return "mid"; }
    fn topM() { return "top"; }
}
try { let i = new Impl30(); print("r108_30_iface_3level:" + str(i.baseM() + "/" + i.midM() + "/" + i.topM())); } catch (e) { print("r108_30_iface_3level:EXC[" + str(e) + "]"); }
try { print("r108_30b_iface_3level_is_base:" + str(new Impl30() is IBase30)); } catch (e) { print("r108_30b_iface_3level_is_base:EXC[" + str(e) + "]"); }

