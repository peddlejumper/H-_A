# ============================================================
# 38. 同名方法重载 (不同签名)
# ============================================================
class A38 {
    fn m() { return 0; }
    fn m(x) { return x; }
}
try { let a = new A38(); print("r108_38_overload:" + str(a.m()) + "," + str(a.m(5))); } catch (e) { print("r108_38_overload:EXC[" + str(e) + "]"); }

# ============================================================
# 39. 多态 + match 分派
# ============================================================
class A39 { fn t() { return "A"; } }
class B39 extends A39 { fn t() { return "B"; } }
class C39 extends A39 { fn t() { return "C"; } }
try {
    let arr = [new A39(), new B39(), new C39()];
    let acc39 = "";
    for itm39 in arr {
        acc39 = acc39 + match itm39 {
            is A39 => "A",
            is B39 => "B",
            is C39 => "C",
            _ => "?",
        };
    }
    print("r108_39_poly_match:" + acc39);
} catch (e) { print("r108_39_poly_match:EXC[" + str(e) + "]"); }

# ============================================================
# 40. 子类方法访问父类 private 字段
# ============================================================
class A40 {
    private let secret = 99;
    fn get() { return secret; }
}
class B40 extends A40 {
    fn probe() { return secret; }
}
try { let b = new B40(); print("r108_40_child_access_parent_private:" + str(b.probe())); } catch (e) { print("r108_40_child_access_parent_private:EXC[" + str(e) + "]"); }

# ============================================================
# 41. super 调用祖父类方法 (跳层)
# ============================================================
class A41 {
    fn m() { return "A.m"; }
    fn n() { return "A.n"; }
}
class B41 extends A41 {
    fn m() { return "B.m"; }
}
class C41 extends B41 {
    fn m() { return "C.m[" + super.m() + "]"; }
    fn n() { return "C.n[" + super.n() + "]"; }
}
try { let c = new C41(); print("r108_41_super_skip:" + str(c.m() + "|" + c.n())); } catch (e) { print("r108_41_super_skip:EXC[" + str(e) + "]"); }

# ============================================================
# 42. super.m() 中 self.field 取哪个? (字段遮蔽下的 super)
# ============================================================
class A42 {
    let x = 1;
    fn m() { return x; }
}
class B42 extends A42 {
    let x = 2;
    fn m() { return super.m(); }
}
try { let b = new B42(); print("r108_42_super_field_resolution:" + str(b.m())); } catch (e) { print("r108_42_super_field_resolution:EXC[" + str(e) + "]"); }

