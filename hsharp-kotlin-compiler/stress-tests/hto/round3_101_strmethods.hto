# =============================================================
# Section 20: immutability check
# =============================================================
let s20 = "hello";
let u20 = s20.upper();
print("S20.01 orig-after-upper: [" + s20 + "]");
print("S20.02 result-upper: [" + u20 + "]");
let s20b = "hello";
let r20 = s20b.replace("l", "L");
print("S20.03 orig-after-replace: [" + s20b + "]");
print("S20.04 result-replace: [" + r20 + "]");
let s20c = "  hello  ";
let st20 = s20c.strip();
print("S20.05 orig-after-strip: [" + s20c + "]");
print("S20.06 result-strip: [" + st20 + "]");
let s20d = "a,b,c";
let sp20 = s20d.split(",");
print("S20.07 orig-after-split: [" + s20d + "]");
print("S20.08 result-split: " + str(sp20));
let s20e = "hello";
let sl20 = s20e[1:3];
print("S20.09 orig-after-slice: [" + s20e + "]");
print("S20.10 result-slice: [" + sl20 + "]");
let s20f = "hello";
let rp20 = s20f * 2;
print("S20.11 orig-after-repeat: [" + s20f + "]");
print("S20.12 result-repeat: [" + rp20 + "]");
let s20g = "hello";
let f20 = s20g.find("ll");
print("S20.13 orig-after-find: [" + s20g + "]");
print("S20.14 result-find: " + str(f20));
let s20h = "hello";
let rv20 = s20h[::-1];
print("S20.15 orig-after-reverse: [" + s20h + "]");
print("S20.16 result-reverse: [" + rv20 + "]");

