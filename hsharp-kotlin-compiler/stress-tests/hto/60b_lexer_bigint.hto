# 60b_lexer_bigint.hto — 大整数字面量边界复现 (BUG #1/#3 最小复现)
# 主文件 60_lexer_edge.hto 无法包含会令 HVM 加载时崩溃的字面量，故单独复现。

# 2^53 = 9007199254740992 (Double 可精确表示的最大整数)
# 2^53 + 1 = 9007199254740993 (超过 Double 精度，但仍 fits Long)
let p = 9007199254740993;
print("2^53+1=" + str(p));
# 预期(若用 Long/BigInteger): 9007199254740993
# 实际(若存为 Double): 9007199254740992  (精度丢失)

# Long.MAX_VALUE = 9223372036854775807 (fits Long, 超过 2^53)
let m = 9223372036854775807;
print("long-max=" + str(m));
# 预期: 9223372036854775807 ; 实际(存为 Double): 9223372036854775808

# 注: Long.MAX_VALUE + 1 = 9223372036854775808 会令 HVM 加载时抛
#     NumberFormatException: For input string: "9223372036854775808"
#     并整体崩溃 (无法在本文件中演示，否则前面所有输出都看不到)。
#     20 位整数 99999999999999999999 同样崩溃。
