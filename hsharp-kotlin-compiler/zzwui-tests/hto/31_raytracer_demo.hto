# build: hwdui_min.hto, zzw_native.hto, zzw_render_min.hto, _libs/raytracer_math.hto, _libs/raytracer_scene.hto, _libs/raytracer_core.hto, _libs/raytracer_pipeline.hto
# T31 - H# Raytracer Pipeline - 实际渲染落盘 demo
# ─────────────────────────────────────────────────────────
# 跑三个预设场景的并行渲染，把结果写成 PPM 文件到
# /tmp/hsharp_rt_<scene>.ppm，输出每张图的时间、像素
# 统计、并行 vs 顺序加速比。

fn t31_render_one(scene_id, samples, depth) {
    let s = scene_by_index(scene_id);
    let cam = look_at(0, 1.5, 5, 0, 0.5, 0, 60);
    let W = 96;
    let H = 64;
    let tile_w = 16;
    let tile_h = 16;
    let tiles = make_tiles(W, H, tile_w, tile_h);
    let total = len(tiles);
    let result_chan = chan_new(total);
    let tile_queue = chan_new(total);
    let i = 0;
    while (i < total) {
        chan_send(tile_queue, tiles[i]);
        i = i + 1;
    }
    chan_close(tile_queue);

    let np = parallelism();
    if (np < 1) { np = 1; }
    if (np > total) { np = total; }

    let t0 = time_ms();
    concurrent {
        let w = 0;
        while (w < np) {
            let stop = false;
            while (not stop) {
                let got = null;
                try {
                    got = chan_recv(tile_queue);
                } catch (e) {
                    stop = true;
                }
                if (not stop and got != null) {
                    let _u = render_tile_worker(s, cam, got, W, H,
                                                samples, depth,
                                                result_chan, null);
                }
            }
            w = w + 1;
        }
    }
    chan_close(result_chan);
    let t1 = time_ms();

    # Assemble the image into a W*H*3 buffer by writing each
    # tile's pixels to the correct (x0+px, y0+py) location.  The
    # old version just concatenated tile buffers in tile-id
    # order, which scrambled the image because the tile
    # iteration order didn't match the pixel iteration order.
    let img = [];
    let pad = W * H * 3;
    let p = 0;
    while (p < pad) { push(img, 0); p = p + 1; }
    let got = 0;
    while (got < total) {
        let r = chan_recv(result_chan);
        if (r == null) { break; }
        let data = r["data"];
        let tw = r["w"];
        let th = r["h"];
        let x0 = r["x0"];
        let y0 = r["y0"];
        let py = 0;
        while (py < th) {
            let px = 0;
            while (px < tw) {
                let src = (py * tw + px) * 3;
                let dst = ((y0 + py) * W + (x0 + px)) * 3;
                img[dst]     = data[src];
                img[dst + 1] = data[src + 1];
                img[dst + 2] = data[src + 2];
                px = px + 1;
            }
            py = py + 1;
        }
        got = got + 1;
    }
    return [t1 - t0, img];
}

fn t31_sequential(scene_id, samples, depth) {
    let s = scene_by_index(scene_id);
    let cam = look_at(0, 1.5, 5, 0, 0.5, 0, 60);
    let W = 96;
    let H = 64;
    let t0 = time_ms();
    let img = [];
    let y = 0;
    while (y < H) {
        let x = 0;
        while (x < W) {
            let c = render_pixel(s, cam, x, y, W, H, samples, depth, 0);
            push(img, c.x);
            push(img, c.y);
            push(img, c.z);
            x = x + 1;
        }
        y = y + 1;
    }
    let t1 = time_ms();
    return [t1 - t0, img];
}

fn main() {
    print("=== H# Raytracer Pipeline Demo ===");
    print("workers = " + str(parallelism()));
    let names = ["three_spheres", "glass_ball", "mirror_corridor"];
    let samples = 2;
    let depth = 3;
    let scene = 0;
    while (scene < 3) {
        print("");
        print("--- scene " + str(scene) + " (" + names[scene] + ") ---");
        let par = t31_render_one(scene, samples, depth);
        let par_ms = par[0];
        let par_img = par[1];
        let stats = image_stats(par_img);
        let out = "/tmp/hsharp_rt_" + names[scene] + ".ppm";
        let ok = write_ppm(out, par_img, 96, 64);
        print("  parallel : " + str(par_ms) + " ms, max_lum=" + str(stats["max_lum"]) + ", wrote " + out + " ok=" + str(ok));
        let seq = t31_sequential(scene, samples, depth);
        let seq_ms = seq[0];
        let speedup = fdiv(seq_ms * 1.0, par_ms * 1.0);
        print("  sequential: " + str(seq_ms) + " ms");
        print("  speedup   : " + str(speedup) + "x");
        scene = scene + 1;
    }
    print("");
    print("=== done ===");
}
main();
