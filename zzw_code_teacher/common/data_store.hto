                "desc": "写一个函数 fib(n)，返回斐波那契数列的第 n 项（从 0 开始）。\n\n示例：\nfib(0) = 0\nfib(1) = 1\nfib(10) = 55",
                "template": "fn fib(n) {\n    # 在此编写你的代码\n    \n}\n",
                "hint": "递归简单但效率低；试试迭代或记忆化。",
                "passed": 0,
                "submitted": 0
            },
            {
                "id": "P005",
                "title": "二分查找",
                "difficulty": "简单",
                "desc": "给定一个升序排序的数组 nums 和目标值 target，返回 target 在数组中的下标，不存在则返回 -1。",
                "template": "fn binary_search(nums, target) {\n    # 在此编写你的代码\n    \n}\n",
                "hint": "维护 left / right 两个指针，每次比较中间元素。",
                "passed": 0,
                "submitted": 0
            }
        ];
    }
    return data;
}

fn problems_save(problems) {
    return ds_write("problems", problems);
}

fn problem_by_id(pid) {
    let all = problems_all();
    let i = 0;
    while (i < len(all)) {
        if (all[i]["id"] == pid) {
            return all[i];
        }
        i = i + 1;
    }
    return nullptr;
}

# ═══════════════════════════════════════════════════════════════════════════
# 用户管理
# ═══════════════════════════════════════════════════════════════════════════

fn users_all() {
    let data = ds_read("users");
    if (data == nullptr) {
        return [
            {"id": "U001", "name": "alice", "role": "student", "solved": 3, "submitted": 5},
            {"id": "U002", "name": "bob", "role": "student", "solved": 1, "submitted": 4},
            {"id": "U003", "name": "admin", "role": "teacher", "solved": 0, "submitted": 0}
        ];
    }
    return data;
}

fn users_save(users) {
    return ds_write("users", users);
}

# ═══════════════════════════════════════════════════════════════════════════
# 提交记录
# ═══════════════════════════════════════════════════════════════════════════

fn submissions_all() {
    let data = ds_read("submissions");
    if (data == nullptr) {
        return [];
    }
    return data;
}

fn submissions_save(subs) {
    return ds_write("submissions", subs);
}

fn submissions_add(sub) {
    let all = submissions_all();
    push(all, sub);
    return submissions_save(all);
}

fn submissions_by_user(uid) {
    let all = submissions_all();
    let result = [];
    let i = 0;
    while (i < len(all)) {
        if (all[i]["user"] == uid) {
            push(result, all[i]);
        }
        i = i + 1;
    }
    return result;
}

# ═══════════════════════════════════════════════════════════════════════════
# 评测统计
# ═══════════════════════════════════════════════════════════════════════════

fn stats_overview() {
    let subs = submissions_all();
    let users = users_all();
    let problems = problems_all();
    let total = len(subs);
    let passed = 0;
    let i = 0;
    while (i < len(subs)) {
        if (subs[i]["result"] == "通过") {
            passed = passed + 1;
        }
        i = i + 1;
    }
    return {
        "total_submissions": total,
        "total_passed": passed,
        "pass_rate": (total > 0) ? (passed * 100 / total) : 0,
        "total_users": len(users),
        "total_problems": len(problems)
    };
}
