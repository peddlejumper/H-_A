# ═══════════════════════════════════════════════════════════════════════════
# common/data_store.hto — 数据持久化（题目/用户/提交记录）
# 用文件 JSON 存储。使用 json_parse / json_stringify host 函数。
# ═══════════════════════════════════════════════════════════════════════════

let _DATA_DIR = "zzw_code_teacher/data";

# ── 简易文件读写封装 ──
fn ds_read(name) {
    let path = _DATA_DIR + "/" + name + ".json";
    if (fs_exists(path) == false) {
        return nullptr;
    }
    let raw = read_file(path);
    if (raw == nullptr or raw == "") {
        return nullptr;
    }
    return json_parse(raw);
}

fn ds_write(name, data) {
    let path = _DATA_DIR + "/" + name + ".json";
    if (fs_exists(_DATA_DIR) == false) {
        fs_mkdir(_DATA_DIR);
    }
    let raw = json_stringify(data);
    write_file(path, raw);
    return 0;
}

# ═══════════════════════════════════════════════════════════════════════════
# 题目管理
# ═══════════════════════════════════════════════════════════════════════════

