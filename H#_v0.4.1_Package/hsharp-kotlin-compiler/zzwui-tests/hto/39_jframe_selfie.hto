# build: hwdui_min.hto, zzw_native.hto, zzw_render_min.hto, _libs/raytracer_math.hto, _libs/raytracer_scene.hto, _libs/raytracer_core.hto, _libs/raytracer_pipeline.hto
# T39 - 用 fullscreen_debug native 跑 JFrame 然后自己抓屏

fn t39_render_parallel(scene_id, samples, depth, W, H) {
    let s = scene_by_index(scene_id);
    let cam = look_at(0, 1.5, 5, 0, 0.5, 0, 60);
    let tiles = make_tiles(W, H, 16, 16);
    let total = len(tiles);
    let result_chan = chan_new(total);
    let tile_queue = chan_new(total);
    let i = 0;
    while (i < total) {
        chan_send(tile_queue, tiles[i]);
        i = i + 1;
    }
    chan_close(tile_queue);
    let np = parallelism();
    if (np < 1) { np = 1; }
    if (np > total) { np = total; }
    concurrent {
        let w = 0;
        while (w < np) {
            let stop = false;
            while (not stop) {
                let got = null;
                try {
                    got = chan_recv(tile_queue);
                } catch (e) {
                    stop = true;
                }
                if (not stop and got != null) {
                    let _u = render_tile_worker(s, cam, got, W, H,
                                                samples, depth,
                                                result_chan, null);
                }
            }
            w = w + 1;
        }
    }
    chan_close(result_chan);
    let img = [];
    let pad = W * H * 3;
    let p = 0;
    while (p < pad) { push(img, 0); p = p + 1; }
    let got = 0;
    while (got < total) {
        let r = chan_recv(result_chan);
        if (r == null) { break; }
        let data = r["data"];
        let tw = r["w"];
        let th = r["h"];
        let x0 = r["x0"];
        let y0 = r["y0"];
        let py = 0;
        while (py < th) {
            let px = 0;
            while (px < tw) {
                let src = (py * tw + px) * 3;
                let dst = ((y0 + py) * W + (x0 + px)) * 3;
                img[dst]     = data[src];
                img[dst + 1] = data[src + 1];
                img[dst + 2] = data[src + 2];
                px = px + 1;
            }
            py = py + 1;
        }
        got = got + 1;
    }
    return img;
}

fn main() {
    let W = 160;
    let H = 120;
    let samples = 3;
    let depth = 4;
    let outdir = "/Users/peddlejumper/H#/v0.4/hsharp-renders";
    print("=== T39 fullscreen JFrame self-screenshot ===");
    let t0 = time_ms();
    let img = t39_render_parallel(0, samples, depth, W, H);
    let t1 = time_ms();
    print("  rendered in " + str(t1 - t0) + " ms");
    let bytes = [];
    let i = 0;
    while (i < len(img)) {
        let v = img[i];
        if (v < 0) { v = 0; }
        if (v > 255) { v = 255; }
        push(bytes, v);
        i = i + 1;
    }
    let out_png = outdir + "/jframe_actual_screen.png";
    print("  opening fullscreen JFrame + auto-screenshot to " + out_png);
    native_show_image_fullscreen_debug("T39 JFrame check", W, H, bytes, out_png);
    print("  done. saved " + out_png);
    print("=== done ===");
}
main();
