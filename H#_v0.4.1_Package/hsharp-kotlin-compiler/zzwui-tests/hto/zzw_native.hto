# ─── Color Utilities ───

fn native_parse_color(hex_color) {
    return gui_parse_color(hex_color);
}

fn native_color_to_hex(r, g, b) {
    return gui_color_to_hex(r, g, b);
}

fn native_lerp_color(c1, c2, t) {
    return gui_lerp_color(c1, c2, t);
}

# `native_show_image(title, w, h, rgb_bytes)` — open a real
# OS-level window showing the rendered image.  The call
# blocks until the user closes the window.
fn native_show_image(title, w, h, rgb_bytes) {
    return gui_show_image(title, w, h, rgb_bytes);
}

# `native_show_image_fullscreen(title, w, h, rgb_bytes)` —
# go into true exclusive fullscreen mode on the default
# GraphicsDevice.  Press Escape (or close) to return.
fn native_show_image_fullscreen(title, w, h, rgb_bytes) {
    return gui_show_image_fullscreen(title, w, h, rgb_bytes);
}

# `native_render_to_png(path, w, h, rgb_bytes)` —
# decode the rgb_bytes the same way the JFrame display
# does and dump the result as a PNG to `path`.  This
# lets us compare "what the demo says the image is"
# against "what the JFrame actually shows".
fn native_render_to_png(path, w, h, rgb_bytes) {
    return gui_render_to_png(path, w, h, rgb_bytes);
}

# `native_show_image_fullscreen_debug(title, w, h, bytes, out_png)` —
# like native_show_image_fullscreen, but instead of blocking
# on user input, it screenshots its own rendered frame and
# exits after 800ms.  Used to verify what the JFrame
# actually displays on the real screen.
fn native_show_image_fullscreen_debug(title, w, h, bytes, out_png) {
    return gui_show_image_fullscreen_debug(title, w, h, bytes, out_png);
}

# `native_start_recording(out_dir, fps)` — start a daemon
# thread that uses java.awt.Robot to capture the entire
# screen at `fps` frames per second, writing
# `frame_NNNNNN.png` files to `out_dir`.  Returns the
# directory the frames are being written to.  Pairs with
# `native_stop_recording`.
fn native_start_recording(out_dir, fps) {
    return gui_start_recording(out_dir, fps);
}

# `native_stop_recording()` — stop the recording thread
# started by `native_start_recording` and return the
# number of frames captured.  The captured frames are
# still on disk and can be post-processed (e.g. encoded
# to gif / mp4 by an external tool).
fn native_stop_recording() {
    return gui_stop_recording();
}

# `native_capture_fullscreen(out_png)` — synchronous
# full-screen capture (no display needed).  Useful for
# grabbing a still frame for the README.
fn native_capture_fullscreen(out_png) {
    return gui_capture_fullscreen(out_png);
}

# `native_show_image_timed(title, w, h, bytes, timeout_ms)` —
# like native_show_image, but auto-closes after
# `timeout_ms` milliseconds (or sooner if the user
# closes manually).  Used by the recording demo so
# we can run unattended.
fn native_show_image_timed(title, w, h, bytes, timeout_ms) {
    return gui_show_image_timed(title, w, h, bytes, timeout_ms);
}