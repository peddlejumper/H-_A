# t08_load_store_fast.hto - LOAD_FAST/STORE_FAST 密集操作
# 循环内反复读写局部变量
fn loop_acc(n) {
    let acc = 0;
    let step = 1;
    let i = 0;
    while (i < n) {
        acc = acc + step;
        step = step + 1;
        i = i + 1;
    }
    return acc;
}
print(loop_acc(0));
print(loop_acc(1));
print(loop_acc(10));
print(loop_acc(100));
print(loop_acc(1000));
