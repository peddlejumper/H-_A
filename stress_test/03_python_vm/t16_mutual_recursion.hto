# t16_mutual_recursion.hto - 互递归 even/odd 深递归
# even/odd 互递归到较大值
fn even(n) {
    if (n == 0) {
        return true;
    }
    return odd(n - 1);
}
fn odd(n) {
    if (n == 0) {
        return false;
    }
    return even(n - 1);
}
print("even(0)=");
print(even(0));
print("even(1)=");
print(even(1));
print("even(10)=");
print(even(10));
print("even(99)=");
print(even(99));
print("odd(0)=");
print(odd(0));
print("odd(99)=");
print(odd(99));
print("even(500)=");
print(even(500));
