# t07_fast_locals.hto - fast locals 索引测试
# 函数内大量局部变量，测试 fast locals 槽位分配/索引
fn compute(a, b, c, d, e) {
    let x1 = a + b;
    let x2 = c + d;
    let x3 = e + a;
    let x4 = x1 + x2;
    let x5 = x3 + x4;
    let x6 = x4 + x5;
    let x7 = x5 + x6;
    let x8 = x6 + x7;
    let x9 = x7 + x8;
    let x10 = x8 + x9;
    return x10 + x9 + x1;
}
print(compute(1, 2, 3, 4, 5));
print(compute(10, 20, 30, 40, 50));
