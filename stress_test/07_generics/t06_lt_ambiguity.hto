# t06_lt_ambiguity.hto — `<` 歧义：比较 vs 类型参数（关键！）
fn check(name, cond) {
    if (cond) { print("OK " + name); }
    else { print("FAIL " + name); }
}

class Box<T> {
    let value = nullptr;
    fn init(v) { self.value = v; }
    fn get() { return self.value; }
}
fn identity<T>(x) { return x; }

# 1. 纯比较
let a = 5;
let b = 10;
check("6/lt", (a < b) == true);
check("6/gt", (a > b) == false);

# 2. if 中的比较
let e = 0;
if (a < b) { e = 1; } else { e = 2; }
check("6/if_lt", e == 1);

# 3. 类型参数 new
let bx = new Box<int>(42);
check("6/new_targs", bx.get() == 42);

# 4. 类型参数调用，参数本身是比较
check("6/identity_of_cmp", identity<bool>(a < b) == true);

# 5. 两个泛型结果比较
let b1 = new Box<int>(3);
let b2 = new Box<int>(9);
check("6/cmp_gets", (b1.get() < b2.get()) == true);

# 6. 嵌套类型参数调用
check("6/nested_identity", identity<int>(identity<int>(7)) == 7);

# 7. 比较链 a < b < c
let c = 20;
try {
    let r = a < b < c;
    print("6/chain_result=" + str(r));
} catch (err) {
    print("6/chain_err=" + str(err));
}
