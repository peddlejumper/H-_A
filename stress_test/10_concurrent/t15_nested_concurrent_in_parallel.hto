# t15_nested_concurrent_in_parallel.hto
# 多个 parallel 任务各自体内再开 concurrent {} —— 探测 currentScope 共享变量竞态。
# HVM.currentScope 是 HVM 实例上的普通 var（非 ThreadLocal），多 worker 线程并发
# 进入/退出嵌套 concurrent 时会互相覆写 currentScope，导致：
#   - 某 worker 的 CONCURRENT_EXIT 看到 currentScope=null -> 抛 "without CONCURRENT_ENTER"
#   - 或子任务注册到错误的 scope -> join 漏掉/串扰
# 观察点：多次运行是否出现异常/串扰结果/死锁。
parallel fn worker(n) {
    concurrent {
        let s = n;
    }
    return n * 10;
}
concurrent {
    let f1 = worker(1);
    let f2 = worker(2);
    let f3 = worker(3);
    let f4 = worker(4);
    let r1 = await f1;
    let r2 = await f2;
    let r3 = await f3;
    let r4 = await f4;
    print(r1);
    print(r2);
    print(r3);
    print(r4);
}
print("done");
