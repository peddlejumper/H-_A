# t02_multi_parallel.hto
# concurrent 内多个 parallel 任务，显式 await 每一个，汇总结果。
# 预期：两个 parallel fn 在 worker 上并发执行，结果 30 / 70 正确。
parallel fn add(a, b) {
    return a + b;
}
parallel fn mul(a, b) {
    return a * b;
}
concurrent {
    let f1 = add(10, 20);
    let f2 = mul(7, 10);
    let r1 = await f1;
    let r2 = await f2;
    print(r1);
    print(r2);
}
print("after");
