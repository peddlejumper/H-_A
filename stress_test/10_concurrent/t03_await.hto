# t03_await.hto
# concurrent 内 await 单个 parallel 任务的结果。
# 预期：await 解包 HFuture，得到 42。
parallel fn compute() {
    let s = 0;
    let i = 0;
    while (i < 1000) {
        s = s + i;
        i = i + 1;
    }
    return s;
}
concurrent {
    let f = compute();
    let r = await f;
    print(r);
}
print("ok");
