# t11_write_outer_race.hto
# concurrent 内多个 parallel 任务修改外部变量 —— 数据竞争探测。
# 文档约定 parallel 任务应“纯”，但运行时并不阻止写共享变量。
# 观察点：最终 counter 值。若串行正确应为 2000；若有竞争/写丢失/写本地化，会偏差。
let counter = 0;
parallel fn bump() {
    let i = 0;
    while (i < 1000) {
        counter = counter + 1;
        i = i + 1;
    }
    return counter;
}
concurrent {
    let f1 = bump();
    let f2 = bump();
    let r1 = await f1;
    let r2 = await f2;
    print("r1:");
    print(r1);
    print("r2:");
    print(r2);
}
print("counter:");
print(counter);
