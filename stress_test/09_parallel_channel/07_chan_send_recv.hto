# 07 — chan_send / chan_recv basic flow (single-threaded, no race)
let __stats = [0, 0];
fn check(name, cond, detail) {
    if (cond) {
        print("OK " + name);
        __stats[0] = __stats[0] + 1;
    } else {
        print("FAIL " + name + " " + detail);
        __stats[1] = __stats[1] + 1;
    }
}

# Unbounded: send then recv
let ch = chan_new(0);
chan_send(ch, 100);
chan_send(ch, 200);
check("size_2", chan_size(ch) == 2, "size=" + str(chan_size(ch)));
let v100 = chan_recv(ch);
check("recv_100", v100 == 100, "v100=" + str(v100));
let v200 = chan_recv(ch);
check("recv_200", v200 == 200, "v200=" + str(v200));
check("size_0", chan_size(ch) == 0, "size=" + str(chan_size(ch)));

# Send after recv (alternating)
let ch2 = chan_new(0);
chan_send(ch2, "a");
let ra = chan_recv(ch2);
chan_send(ch2, "b");
let rb = chan_recv(ch2);
chan_send(ch2, "c");
let rc = chan_recv(ch2);
check("alternating", ra == "a" and rb == "b" and rc == "c",
      "ra=" + str(ra) + " rb=" + str(rb) + " rc=" + str(rc));

# Bounded channel: alternating send/recv
let ch3 = chan_new(2);
chan_send(ch3, 1);
chan_send(ch3, 2);
let x1 = chan_recv(ch3);
chan_send(ch3, 3);
let x2 = chan_recv(ch3);
let x3 = chan_recv(ch3);
check("bounded_alternating", x1 == 1 and x2 == 2 and x3 == 3,
      "x1=" + str(x1) + " x2=" + str(x2) + " x3=" + str(x3));

# Round-trip with various types
let ch4 = chan_new(0);
chan_send(ch4, 42);
chan_send(ch4, "text");
chan_send(ch4, [1, 2, 3]);
chan_send(ch4, {"key": "val"});
let t1 = chan_recv(ch4);
let t2 = chan_recv(ch4);
let t3 = chan_recv(ch4);
let t4 = chan_recv(ch4);
check("rt_int",    t1 == 42, "t1=" + str(t1));
check("rt_string", t2 == "text", "t2=" + str(t2));
check("rt_list",   t3[1] == 2, "t3=" + str(t3));
check("rt_dict",   t4["key"] == "val", "t4=" + str(t4));

print("PC_TEST : PASS=" + str(__stats[0]) + " FAIL=" + str(__stats[1]));
