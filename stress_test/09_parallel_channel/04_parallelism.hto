# 04 — parallelism() returns CPU core count
let __stats = [0, 0];
fn check(name, cond, detail) {
    if (cond) {
        print("OK " + name);
        __stats[0] = __stats[0] + 1;
    } else {
        print("FAIL " + name + " " + detail);
        __stats[1] = __stats[1] + 1;
    }
}

let p = parallelism();
check("positive",         p >= 1, "p=" + str(p));
check("is_number",        type(p) == "number", "type=" + type(p));
check("matches_runtime",  p == dzzw_worker_count(), "p=" + str(p) + " dzzw=" + str(dzzw_worker_count()));

# parallelism() should be stable across calls
let p2 = parallelism();
let p3 = parallelism();
check("stable", p == p2 and p2 == p3, "p=" + str(p) + " p2=" + str(p2) + " p3=" + str(p3));

print("PC_TEST : PASS=" + str(__stats[0]) + " FAIL=" + str(__stats[1]));
