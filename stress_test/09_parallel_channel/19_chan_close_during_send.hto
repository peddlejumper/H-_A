# 19 — chan_close during blocking send (producer parked on full bounded channel)
# A producer is blocked on chan_send because the bounded channel is full.
# Another thread closes the channel. Per the implementation, the parked
# send should either raise or eventually return; we mainly check that the
# producer doesn't deadlock.
let __stats = [0, 0];
fn check(name, cond, detail) {
    if (cond) {
        print("OK " + name);
        __stats[0] = __stats[0] + 1;
    } else {
        print("FAIL " + name + " " + detail);
        __stats[1] = __stats[1] + 1;
    }
}

@parallel fn blocking_producer(ch, n) {
    let sent = 0;
    let raised = 0;
    let i = 0;
    while (i < n) {
        let caught = false;
        try {
            chan_send(ch, i);
        } catch (e) {
            caught = true;
        }
        if (caught) {
            raised = raised + 1;
        } else {
            sent = sent + 1;
        }
        i = i + 1;
    }
    return [sent, raised];
}

# Bounded cap 2: producer will block after 2 sends because no consumer.
let ch = chan_new(2);
let fut = blocking_producer(ch, 100);

# Give the producer time to fill the channel and park on the 3rd send.
let busy = 0;
while (busy < 100000) {
    busy = busy + 1;
}

# Now close the channel.  The producer is parked in queue.put().
chan_close(ch);

# Await the producer — if close doesn't interrupt the parked put, this hangs.
let result = await fut;
let sent = result[0];
let raised = result[1];
check("producer_finished_no_deadlock", true, "");
check("producer_sent_some",  sent > 0, "sent=" + str(sent));
check("producer_raised_some", raised > 0, "raised=" + str(raised));
print("INFO sent=" + str(sent) + " raised=" + str(raised));

print("PC_TEST : PASS=" + str(__stats[0]) + " FAIL=" + str(__stats[1]));
