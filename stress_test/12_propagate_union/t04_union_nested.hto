# T04 - Union nesting: a union variant field whose value is itself a union
union Inner {
    IVal: n;
    INone;
}
union Outer {
    OVal: inner;
    OEmpty;
}

let i = Inner{IVal: 42};
let o = Outer{OVal: i};

print(o.__variant__);
print(o.inner.__union__);
print(o.inner.__variant__);
print(o.inner.n);

let o2 = Outer{OEmpty};
print(o2.__variant__);
