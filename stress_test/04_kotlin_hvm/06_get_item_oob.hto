# 06_get_item_oob.hto — GET_ITEM 越界 (Kotlin 预期崩溃)
let arr = [10, 20];
try {
    print(arr[10]);
} catch (e) {
    print("caught: " + str(e));
}
let s = "ab";
try {
    print(s[5]);
} catch (e) {
    print("caught2: " + str(e));
}
let d = {"a": 1};
try {
    print(d["missing"]);
} catch (e) {
    print("caught3: " + str(e));
}
print("after");
