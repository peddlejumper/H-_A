# Test class with self for field access
class Point {
    let x = 0;
    let y = 0;
    
    fn init(px, py) {
        self.x = px;
        self.y = py;
    }
    
    fn to_string() {
        return "(" + str(self.x) + ", " + str(self.y) + ")";
    }
    
    fn distance(other) {
        let dx = self.x - other.x;
        let dy = self.y - other.y;
        return dx * dx + dy * dy;
    }
}

let p1 = new Point(3, 4);
let p2 = new Point(0, 0);
print(p1.to_string());
print(p2.to_string());
print(p1.distance(p2));
